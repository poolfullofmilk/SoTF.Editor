@inherits LayoutComponentBase

@* Providers *@
<MudThemeProvider Theme="AppTheme.Custom"
                  IsDarkMode />
<MudPopoverProvider />
<MudDialogProvider BackdropClick="false"
                   CloseButton="true"
                   MaxWidth="MaxWidth.False" />
<MudSnackbarProvider />

@* Busy Overlay *@
<MudOverlay Visible="_isBusy"
            DarkBackground
            ZIndex="2000">
    <MudProgressCircular Color="Color.Info"
                         Indeterminate />
</MudOverlay>

<MudLayout>
    <MudAppBar Elevation="4"
               Style="background-color:color-mix(in srgb, var(--mud-palette-appbar-background) var(--glass-opacity), transparent); backdrop-filter:var(--glass-blur)">
        <MudStack Row
                  AlignItems="AlignItems.Center"
                  Class="mud-width-full px-2"
                  Spacing="2">
            <MudText Typo="Typo.h6"
                     Class="text-truncate mr-4">
                @AppInfo.DisplayName
            </MudText>

            @* Language Menu *@
            <LanguagePicker />

            @* Help Menu *@
            <Tooltip Text="@Localizer["Help"]"
                     RootClass="d-flex">
                <MudBadge Dot
                          Overlap
                          Color="Color.Error"
                          Visible="@(_availableUpdate is not null)"
                          Class="d-flex">
                    <MudMenu Icon="@Icons.Material.Rounded.Help"
                             AriaLabel="@Localizer["Help"]"
                             Size="Size.Small">
                        @* Project Page *@
                        <MudMenuItem Icon="@Icons.Custom.Brands.GitHub"
                                     Label="@Localizer["GitHubProject"]"
                                     Href="@AppInfo.RepositoryUrl" />
                        @* Check Updates *@
                        <MudMenuItem Icon="@Icons.Material.Rounded.SystemUpdateAlt"
                                     Label="@Localizer["CheckForUpdates"]"
                                     Class="@UpdateDotClass"
                                     OnClick="() => CheckForUpdatesAsync(true)" />
                        <MudDivider />
                        @* About *@
                        <MudMenuItem Icon="@Icons.Material.Rounded.Info"
                                     Label="@Localizer["About"]"
                                     OnClick="() => ShowDialogAsync<AboutDialog>()" />
                    </MudMenu>
                </MudBadge>
            </Tooltip>

            <MudSpacer />

            @* Savegame Actions *@
            <MudStack Row
                      AlignItems="AlignItems.Center"
                      Spacing="2">

                @* Backup Menu *@
                <Tooltip Text="@Localizer["Backups"]"
                         Disabled="@(!HasSavegame)"
                         RootClass="d-flex">
                    <MudMenu Icon="@Icons.Material.Rounded.Restore"
                             AriaLabel="@Localizer["Backups"]"
                             Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight"
                             TransformOrigin="Origin.TopRight"
                             Disabled="@(!HasSavegame)">
                        @* Open Folder *@
                        <MudMenuItem Icon="@Icons.Material.Rounded.Folder"
                                     Label="@Localizer["OpenSavegameFolder"]"
                                     OnClick="OpenSavegameFolder" />
                        @* Open Backup Folder *@
                        <MudMenuItem Icon="@Icons.Material.Rounded.SnippetFolder"
                                     Label="@Localizer["OpenBackupFolder"]"
                                     OnClick="OpenBackupFolder" />
                        <MudDivider />
                        @* Restore Backup *@
                        <MudMenuItem Icon="@Icons.Material.Rounded.History"
                                     Label="@Localizer["RestoreBackupTitle"]"
                                     OnClick="RestoreBackupAsync" />
                    </MudMenu>
                </Tooltip>

                @* Revert Page *@
                <Tooltip Text="@Localizer["RevertPage"]"
                         Disabled="@(!CanRevertPage)"
                         RootClass="d-flex">
                    <MudIconButton Icon="@Icons.Material.Rounded.Undo"
                                   aria-label="@Localizer["RevertPage"]"
                                   Size="Size.Small"
                                   Disabled="@(!CanRevertPage)"
                                   OnClick="RevertPageAsync" />
                </Tooltip>

                @* Reload *@
                <Tooltip Text="@Localizer["ReloadSavegame"]"
                         Disabled="@(!HasSavegame)"
                         RootClass="d-flex">
                    <MudIconButton Icon="@Icons.Material.Rounded.Refresh"
                                   aria-label="@Localizer["ReloadSavegame"]"
                                   Size="Size.Small"
                                   Disabled="@(!HasSavegame)"
                                   OnClick="ReloadAsync" />
                </Tooltip>

                @* Save *@
                <MudButton Variant="Variant.Filled"
                           Color="Color.Info"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Rounded.Save"
                           Disabled="@(!HasSavegame)"
                           OnClick="SaveAsync">
                    @Localizer["Save"]
                </MudButton>

            </MudStack>
        </MudStack>
    </MudAppBar>

    @* Main Content *@
    <MudMainContent Class="page-gutter">
        <MudStack Row
                  AlignItems="AlignItems.Start"
                  Spacing="6">
            @* Navigation Panel *@
            <MudPaper Elevation="4"
                      Class="rounded-panel pa-2 nav-panel">
                <MudStack Spacing="1">
                    @foreach (var group in s_pageGroups)
                    {
                        @if (group != s_pageGroups[0])
                        {
                            <MudDivider Class="my-1" />
                        }
                        @foreach (var link in group)
                        {
                            @* Page Button *@
                            <MudButton StartIcon="@link.Icon"
                                       Color="@(IsActive(link) ? Color.Secondary : Color.Default)"
                                       Variant="@(IsActive(link) ? Variant.Filled : Variant.Text)"
                                       Class="justify-start"
                                       Style="@(IsActive(link) ? null : "padding:6px 16px")"
                                       FullWidth
                                       Disabled="@IsDisabled(link)"
                                       Href="@link.Href">
                                @Localizer[link.LabelKey]
                                <ChangedDot When="@MainViewModel.HasChanges(link.Href)" />
                            </MudButton>
                        }
                    }
                    @if (IsClientSave)
                    {
                        <MudText Typo="Typo.caption"
                                 Class="mud-text-secondary text-relaxed px-3 pt-2">
                            @Localizer["ClientSaveHasNoWorld"]
                        </MudText>
                    }
                </MudStack>
            </MudPaper>

            @* Page *@
            <MudElement HtmlTag="section"
                        Class="flex-grow-1"
                        Style="min-width:0">
                <ErrorBoundary @ref="_errorBoundary">
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent Context="exception">
                        <EmptyState Icon="@Icons.Material.Rounded.Error"
                                    Color="Color.Error"
                                    Text="@exception.Message">
                            @* Recover *@
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Info"
                                       Size="Size.Small"
                                       OnClick="RecoverFromError">
                                @Localizer["Ok"]
                            </MudButton>
                        </EmptyState>
                    </ErrorContent>
                </ErrorBoundary>
            </MudElement>
        </MudStack>
    </MudMainContent>
</MudLayout>
