@page "/"
@inherits EditorPageBase

<MudStack Spacing="6">
    <Header Title="@AppText.Get("Savegames")">
        <MudPaper Elevation="4"
                  Class="rounded-panel pa-4">
            <MudStack Row
                      AlignItems="AlignItems.Center"
                      Wrap="Wrap.Wrap"
                      Spacing="4">
                <MudTextField T="string"
                              Value="@SavegamePath"
                              Label="@AppText.Get("Location")"
                              ReadOnly
                              Disabled
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="flex-grow-1"
                              Style="min-width:320px" />

                @* Change Folder *@
                <MudButton Variant="Variant.Filled"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Rounded.Folder"
                           OnClick="ChangeFolderAsync">
                    @AppText.Get("ChangeFolder")
                </MudButton>

                @* Default Folder *@
                <MudButton Variant="Variant.Filled"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Rounded.SettingsBackupRestore"
                           Disabled="@IsDefaultFolder"
                           OnClick="SetDefaultFolderAsync">
                    @AppText.Get("UseDefaultFolder")
                </MudButton>
            </MudStack>
            <MudText Typo="Typo.body2"
                     Class="mud-text-secondary mt-2">
                @AppText.Get("DropHint")
            </MudText>
        </MudPaper>
    </Header>

    @if (_savegames is null)
    {
        @* Savegame Skeletons *@
        <MudGrid>

            @for (var index = 0; index < 4; index++)
            {
                <MudItem xs="12"
                         sm="6"
                         md="4"
                         lg="3">
                    <MudPaper Elevation="4"
                              Class="rounded-panel overflow-hidden">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                                     Animation="Animation.Wave"
                                     Height="auto"
                                     Class="savegame-thumb" />
                        <MudStack Spacing="0"
                                  Class="pa-3">
                            <MudText Typo="Typo.subtitle1">
                                <MudSkeleton Animation="Animation.Wave"
                                             Width="60%" />
                            </MudText>
                            <MudText Typo="Typo.body2">
                                <MudSkeleton Animation="Animation.Wave"
                                             Width="40%" />
                            </MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }

        </MudGrid>
    }
    else if (_savegames.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Rounded.FolderOff"
                    Text="@AppText.Get("NoSavegames")" />
    }
    else
    {
        @foreach (var group in SavegameGroups)
        {
            <Header Title="@group.Title"
                    Info="@group.Info">
                <MudGrid>

                    @foreach (var savegame in group.Savegames)
                    {
                        <MudItem xs="12"
                                 sm="6"
                                 md="4"
                                 lg="3">
                            @* Savegame Card *@
                            <MudPaper Elevation="4"
                                      Class="@CardClass(savegame)"
                                      title="@savegame.FullPath"
                                      role="button"
                                      tabindex="0"
                                      aria-label="@savegame.Name"
                                      data-keyclick
                                      @onclick="() => Open(savegame)">
                                @if (savegame.ThumbnailPath is { } thumbnailPath)
                                {
                                    <MudImage Src="@LocalFiles.Url(thumbnailPath)"
                                              Alt="@savegame.Name"
                                              Class="savegame-thumb" />
                                }
                                else
                                {
                                    <MudElement HtmlTag="span"
                                                Class="savegame-thumb d-flex align-center justify-center">
                                        <MudIcon Icon="@(savegame.IsMultiPlayerClient() ? Icons.Material.Rounded.Groups : Icons.Material.Rounded.Image)"
                                                 Color="Color.Default"
                                                 Size="Size.Large" />
                                    </MudElement>
                                }
                                <MudStack Spacing="0"
                                          Class="pa-3">
                                    <MudStack Row
                                              AlignItems="AlignItems.Center"
                                              Spacing="2">
                                        <MudText Typo="Typo.subtitle1"
                                                 Class="text-truncate text-tight"
                                                 Style="font-weight:700">
                                            @savegame.Name
                                        </MudText>
                                        <MudSpacer />
                                        @if (IsOpen(savegame))
                                        {
                                            @* Open Chip *@
                                            <MudChip T="string"
                                                     Variant="Variant.Text"
                                                     Color="Color.Info"
                                                     Size="Size.Small">
                                                @AppText.Get("Open")
                                            </MudChip>
                                        }
                                    </MudStack>
                                    @if (savegame.Summary is { } summary)
                                    {
                                        <MudText Typo="Typo.body2"
                                                 Class="text-truncate">
                                            @WorldText(summary)
                                        </MudText>
                                        @if (savegame.IsMultiPlayerClient())
                                        {
                                            <MudText Typo="Typo.body2"
                                                     Class="text-truncate">
                                                @PlayerText(summary)
                                            </MudText>
                                        }
                                    }
                                    <MudStack Row
                                              AlignItems="AlignItems.Center"
                                              Spacing="2">
                                        <MudText Typo="Typo.body2"
                                                 Class="mud-text-secondary">
                                            @Formatter.FormatDateTime(savegame.LastSaveTime)
                                        </MudText>
                                        @if (savegame.IsMultiPlayer() || savegame.IsMultiPlayerClient())
                                        {
                                            <MudSpacer />
                                            @* Copy To Singleplayer *@
                                            <span @onclick:stopPropagation="true">
                                                <MudIconButton Icon="@Icons.Material.Rounded.ContentCopy"
                                                               aria-label="@AppText.Get("CopyToSingleplayer")"
                                                               title="@(savegame.IsMultiPlayerClient() ? null : AppText.Get("CopyToSingleplayer"))"
                                                               Size="Size.Small"
                                                               Class="my-n1"
                                                               Disabled="@savegame.IsMultiPlayerClient()"
                                                               OnClick="() => CopyToSingleplayerAsync(savegame)" />
                                            </span>
                                        }
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    }

                </MudGrid>
            </Header>
        }
    }
</MudStack>
