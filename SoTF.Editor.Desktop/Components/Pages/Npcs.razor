@page "/Npcs"
@inherits EditorPageBase

<RequiresSavegame NeedsWorld>
    @{
        // The Shown Rows, Worked Out Once Per Render
        var groupings = Groupings();
    }
    <MudStack Row
              Spacing="6"
              Class="page-fill">
        <MudElement HtmlTag="div"
                    Class="side-panel fill-column">
            <Header Title="@AppText.Get("Npcs")"
                    Class="fill">
                <TitleContent>
                    <MudSpacer />
                    @* Grouping Buttons *@
                    <MudButtonGroup Variant="Variant.Filled"
                                    Size="Size.Small"
                                    OverrideStyles="false">
                        @* By Type *@
                        <MudButton Variant="Variant.Filled"
                                   Color="@(_byFamily ? Color.Default : Color.Info)"
                                   Size="Size.Small"
                                   OnClick="() => SetByFamily(false)">
                            @AppText.Get("ByType")
                        </MudButton>
                        @* By Family *@
                        <MudButton Variant="Variant.Filled"
                                   Color="@(_byFamily ? Color.Info : Color.Default)"
                                   Size="Size.Small"
                                   OnClick="() => SetByFamily(true)">
                            @AppText.Get("ByFamily")
                        </MudButton>
                    </MudButtonGroup>
                </TitleContent>
                <ChildContent>
                    @* Npc Search *@
                    <SearchField @bind-Value="_filter"
                                 FullWidth />
                    <MudPaper Elevation="4"
                              Class="rounded-panel panel-flush overflow-y-auto fit">
                        @if (groupings.Count == 0)
                        {
                            <MudText Typo="Typo.body2"
                                     Class="mud-text-secondary pa-4">
                                @AppText.Get("NothingFound")
                            </MudText>
                        }
                        @foreach (var grouping in groupings)
                        {
                            @if (grouping.Title is { } title)
                            {
                                <GroupTitle Title="@title"
                                            Count="grouping.Collections.Count"
                                            Highlight="@_filter" />
                            }
                            @foreach (var collection in grouping.Collections)
                            {
                                @* Collection Row *@
                                <MudElement HtmlTag="div"
                                            Class="@CollectionRowClass(collection)"
                                            role="button"
                                            tabindex="0"
                                            aria-pressed="@(_selectedName == collection.Name ? "true" : "false")"
                                            data-keyclick
                                            @onclick="() => _selectedName = collection.Name">
                                    <MudStack Row
                                              AlignItems="AlignItems.Center"
                                              Spacing="2">
                                        <MudElement HtmlTag="div"
                                                    Class="flex-grow-1"
                                                    Style="min-width:0">
                                            <ItemLabel Name="@collection.Name"
                                                       Detail="@DetailOf(collection.SharedType)"
                                                       ImageUrl="@collection.Actors.FirstOrDefault()?.ActorType?.IconPath"
                                                       Changed="@NpcsPage.IsChanged(collection)"
                                                       Highlight="@_filter"
                                                       Round />
                                        </MudElement>
                                        <MudText Typo="Typo.body2"
                                                 Class="mud-text-secondary">
                                            @collection.Actors.Count
                                        </MudText>
                                    </MudStack>
                                </MudElement>
                            }
                        }
                    </MudPaper>
                </ChildContent>
            </Header>
        </MudElement>
        <MudElement HtmlTag="div"
                    Class="main-panel fill-column">
            @if (SelectedIn(groupings) is not { } selected)
            {
                <EmptyState Icon="@Icons.Material.Rounded.Pets"
                            Text="@AppText.Get("SelectGroup")" />
            }
            else
            {
                var namesRows = selected.SharedType is null;
                <Header Title="@HeaderTitleOf(selected)"
                        Class="fit">
                    <TitleContent>
                        <MudText Typo="Typo.h5"
                                 Class="mud-text-secondary">
                            @selected.Actors.Count
                        </MudText>
                    </TitleContent>
                    <ChildContent>
                        <MudPaper Elevation="4"
                                  Class="rounded-panel panel-flush fit fill-column">
                            <MudTable @key="selected.Name"
                                      T="Actor"
                                      Items="selected.Actors"
                                      Dense
                                      Hover
                                      FixedHeader
                                      Virtualize
                                      OverscanCount="30"
                                      Elevation="0"
                                      Class="fit fixed-columns"
                                      Style="@(namesRows ? "--table-min-width:660px" : "--table-min-width:520px")">

                                <ColGroup>
                                    @if (namesRows)
                                    {
                                        <col />
                                    }
                                    <col style="width:112px" />
                                    <col style="width:80px" />
                                    <col style="@(namesRows ? "width:100px" : null)" />
                                    <col style="@(namesRows ? "width:120px" : null)" />
                                    <col style="width:96px" />
                                </ColGroup>
                                <HeaderContent>
                                    @if (namesRows)
                                    {
                                        <MudTh>@AppText.Get("Name")</MudTh>
                                    }
                                    <MudTh>@AppText.Get("UniqueId")</MudTh>
                                    <MudTh>@AppText.Get("Family")</MudTh>
                                    <MudTh>@AppText.Get("State")</MudTh>
                                    <MudTh>@AppText.Get("Area")</MudTh>
                                    <MudTh />
                                </HeaderContent>
                                <RowTemplate>
                                    @if (namesRows)
                                    {
                                        <MudTd Class="overflow-hidden">
                                            <ItemLabel Name="@(context.ActorType?.Name ?? "???")"
                                                       Detail="@DetailOf(context.ActorType)"
                                                       ImageUrl="@context.ActorType?.IconPath"
                                                       Changed="@NpcsPage.IsChanged(context)"
                                                       Round />
                                        </MudTd>
                                    }
                                    <MudTd Class="selectable-text">
                                        @context.UniqueId
                                        <ChangedDot When="@(!namesRows && NpcsPage.IsChanged(context))" />
                                    </MudTd>
                                    <MudTd>@(context.FamilyId?.ToString() ?? "-")</MudTd>
                                    <MudTd Class="mud-typography-nowrap"
                                           title="@context.StatePrintable">
                                        @context.StatePrintable
                                    </MudTd>
                                    <MudTd Class="mud-typography-nowrap"
                                           title="@context.Position?.Area.Name">
                                        @context.Position?.Area.Name
                                    </MudTd>
                                    <MudTd Class="hover-action"
                                           Style="text-align:right">
                                        <ShowOnMapButton Position="context.Position" />
                                        @* Edit Actor *@
                                        <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                                                       aria-label="@AppText.Get("Edit")"
                                                       title="@AppText.Get("Edit")"
                                                       Size="Size.Small"
                                                       OnClick="() => EditAsync(context)" />
                                    </MudTd>
                                </RowTemplate>
                                <NoRecordsContent>
                                    <MudText Typo="Typo.body2"
                                             Class="mud-text-secondary">
                                        @AppText.Get("NothingFound")
                                    </MudText>
                                </NoRecordsContent>

                            </MudTable>
                        </MudPaper>
                    </ChildContent>
                </Header>
            }
        </MudElement>
    </MudStack>
</RequiresSavegame>
