@page "/Npcs"
@inherits EditorPageBase

<RequiresSavegame NeedsWorld>
    <MudStack Row
              Spacing="6"
              Class="page-fill">
        <MudElement HtmlTag="div"
                    Class="side-panel fill-column">
            <MudStack Spacing="2"
                      Class="fill">
                @* Grouping Buttons *@
                <MudButtonGroup Variant="Variant.Filled"
                                Size="Size.Small"
                                OverrideStyles="false"
                                Class="align-self-start">
                    @* By Type *@
                    <MudButton Variant="Variant.Filled"
                               Color="@(_byFamily ? Color.Default : Color.Info)"
                               Size="Size.Small"
                               OnClick="() => SetByFamily(false)">
                        @AppText.Get("ByType")
                    </MudButton>
                    @* By Family *@
                    <MudButton Variant="Variant.Filled"
                               Color="@(_byFamily ? Color.Info : Color.Default)"
                               Size="Size.Small"
                               OnClick="() => SetByFamily(true)">
                        @AppText.Get("ByFamily")
                    </MudButton>
                </MudButtonGroup>
                @if (_byFamily)
                {
                    <MudText Typo="Typo.caption"
                             Class="mud-text-secondary px-2">
                        @AppText.Get("ByFamilyHint")
                    </MudText>
                }
                @* Npc Search *@
                <SearchField @bind-Value="_filter"
                             FullWidth />
                <MudPaper Elevation="4"
                          Class="rounded-panel panel-flush overflow-y-auto fit">
                    @if (!Groupings.Any())
                    {
                        <MudText Typo="Typo.body2"
                                 Class="mud-text-secondary pa-4">
                            @AppText.Get("NothingFound")
                        </MudText>
                    }
                    @foreach (var grouping in Groupings)
                    {
                        @if (grouping.Title is { } title)
                        {
                            <MudText Typo="Typo.subtitle2"
                                     Class="group-title px-4 pt-4 pb-1">
                                <MudHighlighter Text="@($"{title} ({grouping.Collections.Count})")"
                                                HighlightedText="@_filter" />
                            </MudText>
                        }
                        @foreach (var collection in grouping.Collections)
                        {
                            @* Collection Row *@
                            <MudElement HtmlTag="div"
                                        Class="@CollectionRowClass(collection)"
                                        role="button"
                                        tabindex="0"
                                        aria-pressed="@((Selected == collection) ? "true" : "false")"
                                        data-keyclick
                                        @onclick="() => _selected = collection">
                                <MudStack Row
                                          AlignItems="AlignItems.Center"
                                          Spacing="2">
                                    <MudImage Src="@collection.Actors.FirstOrDefault()?.ActorType?.IconPath"
                                              Alt="@collection.Name"
                                              Class="thumb thumb-round" />
                                    <MudText Typo="Typo.body2"
                                             Class="text-truncate">
                                        <MudHighlighter Text="@collection.Name"
                                                        HighlightedText="@_filter" />
                                        <ChangedDot When="@NpcsPage.IsChanged(collection)" />
                                    </MudText>
                                </MudStack>
                            </MudElement>
                        }
                    }
                </MudPaper>
            </MudStack>
        </MudElement>
        <MudElement HtmlTag="div"
                    Class="main-panel fill-column">
            @if (Selected is not { } selected)
            {
                <EmptyState Icon="@Icons.Material.Rounded.Pets"
                            Text="@AppText.Get("SelectGroup")" />
            }
            else
            {
                <Header Title="@selected.Name"
                        Class="fit">
                    <MudPaper Elevation="4"
                              Class="rounded-panel panel-flush fit fill-column">
                        <MudTable T="Actor"
                                  Items="selected.Actors"
                                  Dense
                                  Hover
                                  FixedHeader
                                  Virtualize
                                  OverscanCount="30"
                                  Elevation="0"
                                  Class="fit fixed-columns"
                                  Style="--table-min-width:660px">

                            <ColGroup>
                                <col />
                                <col style="width:112px" />
                                <col style="width:80px" />
                                <col style="width:100px" />
                                <col style="width:120px" />
                                <col style="width:96px" />
                            </ColGroup>
                            <HeaderContent>
                                <MudTh>@AppText.Get("Name")</MudTh>
                                <MudTh>@AppText.Get("UniqueId")</MudTh>
                                <MudTh>@AppText.Get("Family")</MudTh>
                                <MudTh>@AppText.Get("State")</MudTh>
                                <MudTh>@AppText.Get("Area")</MudTh>
                                <MudTh />
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd Class="overflow-hidden">
                                    <ItemLabel Name="@(context.ActorType?.Name ?? "???")"
                                               Detail="@DetailOf(context)"
                                               ImageUrl="@context.ActorType?.IconPath"
                                               Changed="@NpcsPage.IsChanged(context)"
                                               Round />
                                </MudTd>
                                <MudTd Class="selectable-text">@context.UniqueId</MudTd>
                                <MudTd>@(context.FamilyId?.ToString() ?? "-")</MudTd>
                                <MudTd Class="text-truncate"
                                       title="@context.StatePrintable">
                                    @context.StatePrintable
                                </MudTd>
                                <MudTd Class="text-truncate"
                                       title="@context.Position?.Area.Name">
                                    @context.Position?.Area.Name
                                </MudTd>
                                <MudTd Style="text-align:right">
                                    <ShowOnMapButton Position="context.Position" />
                                    @* Edit Actor *@
                                    <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                                                   aria-label="@AppText.Get("Edit")"
                                                   title="@AppText.Get("Edit")"
                                                   Size="Size.Small"
                                                   OnClick="() => EditAsync(context)" />
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Typo="Typo.body2"
                                         Class="mud-text-secondary">
                                    @AppText.Get("NothingFound")
                                </MudText>
                            </NoRecordsContent>

                        </MudTable>
                    </MudPaper>
                </Header>
            }
        </MudElement>
    </MudStack>
</RequiresSavegame>
