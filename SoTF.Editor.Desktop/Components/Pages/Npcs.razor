@page "/Npcs"
@inherits EditorPageBase

<RequiresSavegame NeedsWorld>
    <MudStack Class="page-fill">
        <MudGrid Class="fill">

            <MudItem xs="12"
                     md="3"
                     Class="fill-column">
                <MudStack Spacing="2"
                          Class="fill">
                    @* Grouping Toggle *@
                    <MudToggleGroup T="bool"
                                    @bind-Value="_byFamily"
                                    Color="Color.Secondary"
                                    Size="Size.Small">
                        <MudToggleItem Value="false"
                                       Text="@Localizer["ByType"]" />
                        <MudToggleItem Value="true"
                                       Text="@Localizer["ByFamily"]" />
                    </MudToggleGroup>
                    @if (_byFamily)
                    {
                        <MudText Typo="Typo.caption"
                                 Class="mud-text-secondary px-2">
                            @Localizer["ByFamilyHint"]
                        </MudText>
                    }
                    <MudPaper Elevation="4"
                              Class="rounded-panel panel-flush overflow-y-auto fill">
                        @foreach (var grouping in Groupings)
                        {
                            @if (grouping.Title is { } title)
                            {
                                <MudText Typo="Typo.subtitle2"
                                         Class="group-title px-4 pt-4 pb-1">
                                    @title
                                </MudText>
                            }
                            @foreach (var collection in grouping.Collections)
                            {
                                @* Collection Row *@
                                <MudElement HtmlTag="div"
                                            Class="@CollectionRowClass(collection)"
                                            role="button"
                                            tabindex="0"
                                            aria-pressed="@((Selected == collection) ? "true" : "false")"
                                            data-keyclick
                                            @onclick="() => _selected = collection">
                                    <MudStack Row
                                              AlignItems="AlignItems.Center"
                                              Spacing="2">
                                        <MudImage Src="@collection.Actors.FirstOrDefault()?.ActorType?.IconPath"
                                                  Alt="@collection.Name"
                                                  Class="thumb thumb-round" />
                                        <MudText Typo="Typo.body2"
                                                 Class="text-truncate">
                                            @collection.Name
                                            <ChangedDot When="@NpcsPage.IsChanged(collection)" />
                                        </MudText>
                                    </MudStack>
                                </MudElement>
                            }
                        }
                    </MudPaper>
                </MudStack>
            </MudItem>

            <MudItem xs="12"
                     md="9"
                     Class="fill-column">
                @if (Selected is not { } selected)
                {
                    <EmptyState Icon="@Icons.Material.Rounded.Pets"
                                Text="@Localizer["SelectGroup"]" />
                }
                else
                {
                    <Header Title="@selected.Name"
                            Class="fill">
                        <MudPaper Elevation="4"
                                  Class="rounded-panel panel-flush fill fill-column">
                            <MudTable T="Actor"
                                      Items="selected.Actors"
                                      Dense
                                      Hover
                                      FixedHeader
                                      Virtualize
                                      OverscanCount="30"
                                      Elevation="0"
                                      Class="fill fixed-columns">

                                <ColGroup>
                                    <col />
                                    <col style="width:105px" />
                                    <col style="width:90px" />
                                    <col style="width:130px" />
                                    <col style="width:200px" />
                                    <col style="width:96px" />
                                </ColGroup>
                                <HeaderContent>
                                    <MudTh>@Localizer["Name"]</MudTh>
                                    <MudTh>@Localizer["UniqueId"]</MudTh>
                                    <MudTh>@Localizer["Family"]</MudTh>
                                    <MudTh>@Localizer["State"]</MudTh>
                                    <MudTh>@Localizer["Area"]</MudTh>
                                    <MudTh />
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>
                                        <ItemLabel Name="@(context.ActorType?.Name ?? "???")"
                                                   Detail="@($"{context.ActorType?.PrintableClassification} · {context.ActorType?.PrintableGender}")"
                                                   ImageUrl="@context.ActorType?.IconPath"
                                                   Changed="@NpcsPage.IsChanged(context)"
                                                   Round />
                                    </MudTd>
                                    <MudTd Class="selectable-text">@context.UniqueId</MudTd>
                                    <MudTd>@context.FamilyId</MudTd>
                                    <MudTd Class="text-truncate"
                                           title="@context.StatePrintable">
                                        @context.StatePrintable
                                    </MudTd>
                                    <MudTd Class="text-truncate"
                                           title="@context.Position?.Area.Name">
                                        @context.Position?.Area.Name
                                    </MudTd>
                                    <MudTd Style="text-align:right">
                                        <ShowOnMapButton Position="context.Position" />
                                        @* Edit Actor *@
                                        <MudIconButton Icon="@Icons.Material.Rounded.Edit"
                                                       aria-label="@Localizer["Edit"]"
                                                       title="@Localizer["Edit"]"
                                                       Size="Size.Small"
                                                       OnClick="() => EditAsync(context)" />
                                    </MudTd>
                                </RowTemplate>

                            </MudTable>
                        </MudPaper>
                    </Header>
                }
            </MudItem>

        </MudGrid>
    </MudStack>
</RequiresSavegame>
