@page "/Map"
@inherits EditorPageBase

<RequiresSavegame>
    <MudStack Row
              AlignItems="AlignItems.Stretch"
              Spacing="6"
              Class="@(_menusHidden ? "page-fill menus-hidden" : "page-fill")">
        @* Filter Panel *@
        <MudElement HtmlTag="div"
                    Class="side-panel fill-column">
            <MudPaper Elevation="4"
                      Class="rounded-panel pa-4 fit d-flex flex-column">
                <MudStack Spacing="3"
                          Class="fill-column fit">
                    @* Point Search *@
                    <SearchField Value="@MapViewModel.MapFilter.FullText"
                                 ValueChanged="SetFullText"
                                 FullWidth />

                    @if (IsSearching)
                    {
                        var results = MapViewModel.SearchResults();
                        <MudStack Row
                                  AlignItems="AlignItems.Center"
                                  Spacing="1">
                            <MudText Typo="Typo.subtitle2">@AppText.Get("Results")</MudText>
                            <MudSpacer />
                            <MudText Typo="Typo.body2"
                                     Class="mud-text-secondary pr-1">
                                @results.Count
                            </MudText>
                        </MudStack>
                        @* Search Results *@
                        <MudPaper Elevation="0"
                                  Class="inset rounded-panel panel-flush overflow-y-auto flex-shrink-0"
                                  Style="max-height:240px">
                            @if (results.Count == 0)
                            {
                                <MudText Typo="Typo.body2"
                                         Class="mud-text-secondary px-4 py-2">
                                    @AppText.Get("NothingFound")
                                </MudText>
                            }
                            @foreach (var result in results.Take(MaxResults))
                            {
                                @* Result Row *@
                                <MudElement HtmlTag="div"
                                            Class="list-row d-flex align-center gap-3 px-4 py-1"
                                            role="button"
                                            tabindex="0"
                                            data-keyclick
                                            @onclick="() => FocusResultAsync(result)">
                                    <MudImage Src="@result.Poi.Icon"
                                              Alt="@result.Poi.Title"
                                              Width="20"
                                              Height="20" />
                                    <MudStack Spacing="0"
                                              Style="min-width:0">
                                        <MudText Typo="Typo.body2"
                                                 Class="text-truncate">
                                            <MudHighlighter Text="@result.Poi.Title"
                                                            HighlightedText="@MapViewModel.MapFilter.FullText" />
                                        </MudText>
                                        <MudText Typo="Typo.caption"
                                                 Class="mud-text-secondary text-truncate">
                                            @Formatter.JoinParts(result.Group.Title, result.Poi.AreaName)
                                        </MudText>
                                    </MudStack>
                                </MudElement>
                            }
                            @if (results.Count > MaxResults)
                            {
                                <MudText Typo="Typo.caption"
                                         Class="mud-text-secondary px-4 py-2">
                                    @AppText.Format("AndMore", results.Count - MaxResults)
                                </MudText>
                            }
                        </MudPaper>
                    }

                    <MudStack Row
                              AlignItems="AlignItems.Center"
                              Spacing="1">
                        <MudText Typo="Typo.subtitle2">@AppText.Get("PointsOfInterest")</MudText>
                        <MudSpacer />
                        @* Reset Points *@
                        <Tooltip Text="@AppText.Get("ResetToDefault")"
                                 Disabled="@MapViewModel.IsAtDefault()"
                                 RootClass="d-flex">
                            <MudIconButton Icon="@Icons.Material.Rounded.RestartAlt"
                                           aria-label="@AppText.Get("ResetToDefault")"
                                           Size="Size.Small"
                                           Disabled="@MapViewModel.IsAtDefault()"
                                           OnClick="ResetToDefault" />
                        </Tooltip>
                        @* Filter Menu *@
                        <Tooltip Text="@AppText.Get("Filters")"
                                 RootClass="d-flex">
                            <MudBadge Dot
                                      Overlap
                                      Color="Color.Info"
                                      Visible="@HasFilters"
                                      Class="d-flex">
                                <MudMenu Icon="@Icons.Material.Rounded.FilterList"
                                         AriaLabel="@AppText.Get("Filters")"
                                         Size="Size.Small"
                                         AnchorOrigin="Origin.BottomRight"
                                         TransformOrigin="Origin.TopRight">
                                    @* Area Menu *@
                                    <MudMenu Label="@($"{AppText.Get("Area")}: {MapViewModel.MapFilter.AreaFilter.Name}")"
                                             MaxHeight="400">
                                        @foreach (var areaFilter in MapViewModel.MapFilter.AreaFilterTypeValues)
                                        {
                                            <MudMenuItem Icon="@CheckOf(areaFilter == MapViewModel.MapFilter.AreaFilter)"
                                                         OnClick="() => SetAreaFilter(areaFilter)">
                                                @areaFilter.Name
                                            </MudMenuItem>
                                        }
                                    </MudMenu>
                                    @* Requirements Menu *@
                                    <MudMenu Label="@($"{AppText.Get("Requirements")}: {RequirementsName(MapViewModel.MapFilter.RequirementsFilter)}")">
                                        @foreach (var requirementsFilter in Enum.GetValues<MapFilter.RequirementsFilterType>())
                                        {
                                            <MudMenuItem Icon="@CheckOf(requirementsFilter == MapViewModel.MapFilter.RequirementsFilter)"
                                                         OnClick="() => SetRequirementsFilter(requirementsFilter)">
                                                @RequirementsName(requirementsFilter)
                                            </MudMenuItem>
                                        }
                                    </MudMenu>
                                    @* Near Player Menu *@
                                    <MudMenu Label="@($"{AppText.Get("NearPlayer")}: {NearPlayerName(MapViewModel.MapFilter.NearPlayerMetres)}")">
                                        @foreach (var metres in MapFilter.NearPlayerChoices)
                                        {
                                            <MudMenuItem Icon="@CheckOf(metres == MapViewModel.MapFilter.NearPlayerMetres)"
                                                         OnClick="() => SetNearPlayer(metres)">
                                                @NearPlayerName(metres)
                                            </MudMenuItem>
                                        }
                                    </MudMenu>
                                    @* Uncollected Only *@
                                    <MudMenuItem Icon="@(MapViewModel.MapFilter.ShowOnlyUncollectedItems ? Icons.Material.Rounded.CheckBox : Icons.Material.Rounded.CheckBoxOutlineBlank)"
                                                 AutoClose="false"
                                                 OnClick="() => SetUncollectedOnly(!MapViewModel.MapFilter.ShowOnlyUncollectedItems)">
                                        @AppText.Get("UncollectedOnly")
                                    </MudMenuItem>
                                    <MudDivider />
                                    @* Reset Filters *@
                                    <MudMenuItem Icon="@Icons.Material.Rounded.FilterListOff"
                                                 IconColor="Color.Error"
                                                 Class="mud-error-text"
                                                 Disabled="@(!HasFilters)"
                                                 OnClick="ResetFilters">
                                        @AppText.Get("ResetFilters")
                                    </MudMenuItem>
                                </MudMenu>
                            </MudBadge>
                        </Tooltip>
                        @* Select All *@
                        <Tooltip Text="@AppText.Get("SelectAll")"
                                 RootClass="d-flex">
                            <MudCheckBox T="bool?"
                                         Value="StateOf(MapViewModel.AllGroups())"
                                         ValueChanged="ToggleAll"
                                         TriState
                                         Color="Color.Info"
                                         Dense />
                        </Tooltip>
                    </MudStack>

                    @* Point Groups *@
                    <MudStack Spacing="0"
                              Class="overflow-y-auto fit">
                        @foreach (var grouper in MapViewModel.PoiGroups.OrderBy(grouper => grouper.Title))
                        {
                            @if (grouper is PoiGroupCollection collection)
                            {
                                <MudStack Row
                                          AlignItems="AlignItems.Center"
                                          Spacing="0"
                                          Class="@MatchClass(collection.PoiGroups)">
                                    @* Collection Checkbox *@
                                    <MudCheckBox T="bool?"
                                                 Value="StateOf(collection.PoiGroups)"
                                                 ValueChanged="() => SetEnabled(collection, StateOf(collection.PoiGroups) != true)"
                                                 TriState
                                                 Color="Color.Info"
                                                 Dense />
                                    @* Collection Button *@
                                    <MudElement HtmlTag="div"
                                                Class="list-row rounded-inner d-flex align-center align-self-stretch gap-1 flex-grow-1 px-1"
                                                role="button"
                                                tabindex="0"
                                                aria-expanded="@(IsExpanded(collection) ? "true" : "false")"
                                                data-keyclick
                                                @onclick="() => ToggleExpanded(collection)">
                                        <MudIcon Icon="@(IsExpanded(collection) ? Icons.Material.Rounded.ExpandMore : Icons.Material.Rounded.ChevronRight)"
                                                 Size="Size.Small" />
                                        <MudText Typo="Typo.body2"
                                                 Class="flex-grow-1">
                                            @collection.Title
                                        </MudText>
                                        <MudText Typo="Typo.body2"
                                                 Class="mud-text-secondary">
                                            @collection.Count
                                        </MudText>
                                    </MudElement>
                                </MudStack>
                            }
                            @foreach (var poiGroup in GroupsUnder(grouper))
                            {
                                <MudStack Row
                                          AlignItems="AlignItems.Center"
                                          Spacing="2"
                                          Class="@RowClass(poiGroup, grouper)">
                                    @* Group Checkbox *@
                                    <MudCheckBox T="bool"
                                                 Value="poiGroup.Enabled"
                                                 ValueChanged="value => SetEnabled(poiGroup, value)"
                                                 Color="Color.Info"
                                                 Dense>
                                        <MudStack Row
                                                  AlignItems="AlignItems.Center"
                                                  Spacing="2">
                                            <MudImage Src="@poiGroup.Icon"
                                                      Alt="@poiGroup.Title"
                                                      Width="20"
                                                      Height="20" />
                                            <MudText Typo="Typo.body2">@poiGroup.Title</MudText>
                                        </MudStack>
                                    </MudCheckBox>
                                    <MudSpacer />
                                    <MudText Typo="Typo.body2"
                                             Class="mud-text-secondary pr-1">
                                        @poiGroup.Count
                                    </MudText>
                                </MudStack>
                            }
                        }
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudElement>

        @* Map Viewport *@
        <MudPaper Elevation="4"
                  Class="rounded-panel flex-grow-1 position-relative overflow-hidden"
                  Style="@($"min-width:0;background-color:{MapBackground}")">
            <MudElement HtmlTag="div"
                        @bind-Ref="_viewport"
                        Class="map-viewport"
                        tabindex="0"
                        aria-label="@AppText.Get("MapKeyboardHint")"
                        @onclick="ClickMapAsync"
                        @oncontextmenu="ClickMapAsync">
                <MudElement HtmlTag="div"
                            @bind-Ref="_canvas"
                            Class="map-canvas">
                    @* Map Image *@
                    <img src="images/map/dark.webp"
                         alt="@AppText.Get("Map")"
                         class="map-image" />
                    <MapPoints Version="@MapViewModel.SyncPoints()" />
                    @if (MapViewModel.SelectedPoi is ZipPointPoi { Parent: { Visible: true } zipline })
                    {
                        @* Picked Zipline *@
                        <svg class="map-zipline map-zipline-pick"
                             viewBox="0 0 4096 4096">
                            <line x1="@MapPoints.Pixel(zipline.PointA.MapLeft)"
                                  y1="@MapPoints.Pixel(zipline.PointA.MapTop)"
                                  x2="@MapPoints.Pixel(zipline.PointB.MapLeft)"
                                  y2="@MapPoints.Pixel(zipline.PointB.MapTop)"
                                  class="map-zipline-picked" />
                        </svg>
                        @foreach (var anchor in new[] { zipline.PointA, zipline.PointB })
                        {
                            <img src="@anchor.Icon"
                                 alt="@anchor.Title"
                                 title="@anchor.Title"
                                 class="map-poi"
                                 style="@MapPoints.PoiStyle(anchor.MapLeft, anchor.MapTop, anchor.IconSize, PickedZIndex)" />
                            <span class="map-ring"
                                  style="@MapPoints.RingStyle(anchor.MapLeft, anchor.MapTop, anchor.IconSize, PickedZIndex)" />
                        }
                    }
                    else if (MapViewModel.SelectedPoi is LocationPoi location)
                    {
                        @* Location Pin *@
                        <img src="@location.Icon"
                             alt="@location.Title"
                             title="@location.Title"
                             class="map-pin"
                             style="@PinStyle(location)" />
                    }
                    else if (MapViewModel.SelectedPoi is BasePoi { Visible: true } picked)
                    {
                        @* Picked Point *@
                        <img src="@picked.Icon"
                             alt="@picked.Title"
                             title="@picked.Title"
                             class="map-poi"
                             style="@MapPoints.PoiStyle(picked.MapLeft, picked.MapTop, picked.IconSize, PickedZIndex)" />
                        <span class="map-ring"
                              style="@MapPoints.RingStyle(picked.MapLeft, picked.MapTop, picked.IconSize, PickedZIndex)" />
                    }
                    @if (MapViewModel.PickLineStart is { } pickStart)
                    {
                        @* Zipline Preview *@
                        <svg class="map-zipline map-pick-line idle"
                             viewBox="0 0 4096 4096">
                            <line x1="@MapPoints.Pixel(pickStart.MapLeft)"
                                  y1="@MapPoints.Pixel(pickStart.MapTop)"
                                  x2="@MapPoints.Pixel(pickStart.MapLeft)"
                                  y2="@MapPoints.Pixel(pickStart.MapTop)" />
                        </svg>
                        <img src="@ZipPointPoi.IconUrl"
                             alt=""
                             class="map-poi map-pick-ghost idle"
                             style="@MapPoints.PoiStyle(pickStart.MapLeft, pickStart.MapTop, 32, GhostZIndex)" />
                    }
                </MudElement>
            </MudElement>

            @* Zoom Buttons *@
            <MudStack Spacing="2"
                      Class="position-absolute ma-4"
                      Style="top:0;left:0">
                @* Zoom In *@
                <MudIconButton Icon="@Icons.Material.Rounded.Add"
                               aria-label="@AppText.Get("ZoomIn")"
                               Variant="Variant.Filled"
                               Size="Size.Small"
                               Class="map-overlay"
                               OnClick="() => ZoomAsync(1.25)" />
                @* Zoom Out *@
                <MudIconButton Icon="@Icons.Material.Rounded.Remove"
                               aria-label="@AppText.Get("ZoomOut")"
                               Variant="Variant.Filled"
                               Size="Size.Small"
                               Class="map-overlay"
                               OnClick="() => ZoomAsync(1 / 1.25)" />
                @* Whole Map *@
                <Tooltip Text="@AppText.Get("CenterMap")"
                         Placement="Placement.Right"
                         RootClass="d-flex">
                    <MudIconButton Icon="@Icons.Material.Rounded.ZoomOutMap"
                                   aria-label="@AppText.Get("CenterMap")"
                                   Variant="Variant.Filled"
                                   Size="Size.Small"
                                   Class="map-overlay"
                                   OnClick="CenterAsync" />
                </Tooltip>
                @* Menus Toggle *@
                <Tooltip Text="@MenusText"
                         Placement="Placement.Right"
                         RootClass="d-flex">
                    <MudIconButton Icon="@(_menusHidden ? Icons.Material.Rounded.Menu : Icons.Material.Rounded.MenuOpen)"
                                   aria-label="@MenusText"
                                   Variant="Variant.Filled"
                                   Size="Size.Small"
                                   Class="map-overlay"
                                   OnClick="ToggleMenus" />
                </Tooltip>
            </MudStack>

            @if (MapViewModel.StackedPois.Count > 0 || MapViewModel.SelectedPoi is BasePoi)
            {
                <MudPaper Elevation="4"
                          Class="rounded-panel pa-4 map-overlay position-absolute ma-4 overflow-y-auto"
                          Style="top:0;right:0;width:360px;max-height:calc(100% - 32px)">
                    @if (MapViewModel.SelectedPoi is BasePoi selectedPoi)
                    {
                        <PoiDetails Poi="selectedPoi"
                                    OnMapChanged="StateHasChanged" />
                    }
                    else
                    {
                        <MudStack Spacing="3">
                            <MudStack Row
                                      AlignItems="AlignItems.Center"
                                      Spacing="3">
                                <MudText Typo="Typo.h6"
                                         Class="text-tight">
                                    @AppText.Format("PointsHere", MapViewModel.StackedPois.Count)
                                </MudText>
                                <MudSpacer />
                                @* Close List *@
                                <MudIconButton Icon="@Icons.Material.Rounded.Close"
                                               aria-label="@AppText.Get("Close")"
                                               Size="Size.Small"
                                               OnClick="() => MapViewModel.SelectPoi(null)" />
                            </MudStack>
                            <MudStack Spacing="0">
                                @foreach (var poi in MapViewModel.StackedPois.Take(MaxStackRows))
                                {
                                    @* Stacked Point *@
                                    <MudElement HtmlTag="div"
                                                Class="list-row rounded-inner d-flex align-center gap-3 px-2 py-1"
                                                role="button"
                                                tabindex="0"
                                                data-keyclick
                                                @onclick="() => MapViewModel.SelectPoi(poi)">
                                        <MudImage Src="@poi.Icon"
                                                  Alt="@poi.Title"
                                                  Width="24"
                                                  Height="24" />
                                        <MudText Typo="Typo.body2">@poi.Title</MudText>
                                    </MudElement>
                                }
                            </MudStack>
                            @if (MapViewModel.StackedPois.Count > MaxStackRows)
                            {
                                <MudText Typo="Typo.body2"
                                         Class="mud-text-secondary px-2">
                                    @AppText.Format("MorePointsHere", MapViewModel.StackedPois.Count - MaxStackRows)
                                </MudText>
                            }
                        </MudStack>
                    }
                </MudPaper>
            }
        </MudPaper>
    </MudStack>
</RequiresSavegame>
