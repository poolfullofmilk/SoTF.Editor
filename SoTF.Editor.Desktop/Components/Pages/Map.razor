@page "/Map"
@inherits EditorPageBase

<RequiresSavegame>
    <MudStack Row
              AlignItems="AlignItems.Stretch"
              Spacing="6"
              Class="@(_menusHidden ? "page-fill menus-hidden" : "page-fill")">
        @* Filter Panel *@
        <MudPaper Elevation="4"
                  Class="rounded-panel pa-4 overflow-y-auto side-panel">
            <MudStack Spacing="3">
                <MudStack Row
                          AlignItems="AlignItems.Center"
                          Spacing="1">
                    <MudElement HtmlTag="div"
                                Class="flex-grow-1"
                                Style="min-width:0">
                        @* Point Search *@
                        <SearchField Value="@MapViewModel.MapFilter.FullText"
                                     ValueChanged="SetFullText"
                                     FullWidth />
                    </MudElement>
                    <MudElement HtmlTag="div">
                        @* Filter Button *@
                        <Tooltip Text="@AppText.Get("Filters")"
                                 RootClass="d-flex">
                            <MudBadge Dot
                                      Overlap
                                      Color="Color.Info"
                                      Visible="@HasFilters"
                                      Class="d-flex">
                                <MudIconButton Icon="@Icons.Material.Rounded.FilterList"
                                               aria-label="@AppText.Get("Filters")"
                                               Size="Size.Small"
                                               OnClick="() => _filtersOpen = true" />
                            </MudBadge>
                        </Tooltip>
                        @* Filter Popover *@
                        <MudPopover Open="_filtersOpen"
                                    AnchorOrigin="Origin.BottomRight"
                                    TransformOrigin="Origin.TopRight"
                                    Class="overflow-hidden"
                                    Style="width:320px">
                            <MudStack Spacing="3"
                                      Class="pa-4">
                                @* Area Filter *@
                                <MudSelect T="AreaFilter"
                                           Variant="Variant.Outlined"
                                           Value="MapViewModel.MapFilter.AreaFilter"
                                           ValueChanged="SetAreaFilter"
                                           Label="@AppText.Get("Area")"
                                           ToStringFunc="areaFilter => areaFilter?.Name ?? string.Empty"
                                           Dense
                                           Margin="Margin.Dense">
                                    @foreach (var areaFilter in MapViewModel.MapFilter.AreaFilterTypeValues)
                                    {
                                        <MudSelectItem Value="areaFilter">@areaFilter.Name</MudSelectItem>
                                    }
                                </MudSelect>
                                @* Requirements Filter *@
                                <MudSelect T="MapFilter.RequirementsFilterType"
                                           Variant="Variant.Outlined"
                                           Value="MapViewModel.MapFilter.RequirementsFilter"
                                           ValueChanged="SetRequirementsFilter"
                                           Label="@AppText.Get("Requirements")"
                                           HelperText="@AppText.Get("RequirementsTooltip")"
                                           ToStringFunc="RequirementsName"
                                           Dense
                                           Margin="Margin.Dense">
                                    @foreach (var requirementsFilter in Enum.GetValues<MapFilter.RequirementsFilterType>())
                                    {
                                        <MudSelectItem Value="requirementsFilter">@RequirementsName(requirementsFilter)</MudSelectItem>
                                    }
                                </MudSelect>
                                @* Uncollected Only *@
                                <MudSwitch T="bool"
                                           Value="MapViewModel.MapFilter.ShowOnlyUncollectedItems"
                                           ValueChanged="SetUncollectedOnly"
                                           Color="Color.Info"
                                           Label="@AppText.Get("UncollectedOnly")" />
                            </MudStack>
                            <MudStack Row
                                      AlignItems="AlignItems.Center"
                                      Spacing="4"
                                      Class="px-3 py-2"
                                      Style="border-top:1px solid var(--mud-palette-lines-default)">
                                @* Reset Filters *@
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           Disabled="@(!HasFilters)"
                                           OnClick="ResetFilters">
                                    @AppText.Get("Reset")
                                </MudButton>
                            </MudStack>
                        </MudPopover>
                    </MudElement>
                </MudStack>

                <MudStack Row
                          AlignItems="AlignItems.Center"
                          Spacing="1">
                    <MudText Typo="Typo.subtitle2">@AppText.Get("PointsOfInterest")</MudText>
                    <MudSpacer />
                    @* Select All *@
                    <Tooltip Text="@AppText.Get("SelectAll")"
                             RootClass="d-flex">
                        <MudCheckBox T="bool?"
                                     Value="StateOf(MapViewModel.AllGroups())"
                                     ValueChanged="SetAllEnabled"
                                     TriState
                                     Color="Color.Info"
                                     Dense />
                    </Tooltip>
                    @* Reset Points *@
                    <Tooltip Text="@AppText.Get("ResetToDefault")"
                             Disabled="@MapViewModel.IsAtDefault()"
                             RootClass="d-flex">
                        <MudIconButton Icon="@Icons.Material.Rounded.RestartAlt"
                                       aria-label="@AppText.Get("ResetToDefault")"
                                       Size="Size.Small"
                                       Disabled="@MapViewModel.IsAtDefault()"
                                       OnClick="ResetToDefault" />
                    </Tooltip>
                </MudStack>

                <MudStack Spacing="0">
                    @foreach (var grouper in MapViewModel.PoiGroups.OrderBy(grouper => grouper.BaseTitle))
                    {
                        @switch (grouper)
                        {
                            case PoiGroup poiGroup:
                                @* Group Checkbox *@
                                <MudCheckBox T="bool"
                                             Value="poiGroup.Enabled"
                                             ValueChanged="value => SetEnabled(poiGroup, value)"
                                             Color="Color.Info"
                                             Dense>
                                    <MudStack Row
                                              AlignItems="AlignItems.Center"
                                              Spacing="2">
                                        <MudImage Src="@poiGroup.Icon"
                                                  Alt="@poiGroup.BaseTitle"
                                                  Width="20"
                                                  Height="20" />
                                        <MudText Typo="Typo.body2">@poiGroup.Title</MudText>
                                    </MudStack>
                                </MudCheckBox>
                                break;
                            case PoiGroupCollection poiGroupCollection:
                                <MudStack Row
                                          AlignItems="AlignItems.Center"
                                          Spacing="0">
                                    @* Collection Checkbox *@
                                    <MudCheckBox T="bool?"
                                                 Value="StateOf(poiGroupCollection.PoiGroups)"
                                                 ValueChanged="value => SetEnabled(poiGroupCollection, value == true)"
                                                 TriState
                                                 Color="Color.Info"
                                                 Dense>
                                        <MudText Typo="Typo.body2">@poiGroupCollection.Title</MudText>
                                    </MudCheckBox>
                                    <MudSpacer />
                                    @* Expand Button *@
                                    <Tooltip Text="@(IsExpanded(poiGroupCollection) ? AppText.Get("Collapse") : AppText.Get("Expand"))">
                                        <MudIconButton Icon="@(IsExpanded(poiGroupCollection) ? Icons.Material.Rounded.ExpandLess : Icons.Material.Rounded.ExpandMore)"
                                                       Size="Size.Small"
                                                       OnClick="() => ToggleExpanded(poiGroupCollection)" />
                                    </Tooltip>
                                </MudStack>
                                @foreach (var poiGroup in ExpandedGroups(poiGroupCollection))
                                {
                                    @* Sub Group Checkbox *@
                                    <MudCheckBox T="bool"
                                                 Value="poiGroup.Enabled"
                                                 ValueChanged="value => SetEnabled(poiGroup, value)"
                                                 Color="Color.Info"
                                                 Dense
                                                 Class="ml-6">
                                        <MudStack Row
                                                  AlignItems="AlignItems.Center"
                                                  Spacing="2">
                                            <MudImage Src="@poiGroup.Icon"
                                                      Alt="@poiGroup.BaseTitle"
                                                      Width="20"
                                                      Height="20" />
                                            <MudText Typo="Typo.body2">@poiGroup.Title</MudText>
                                        </MudStack>
                                    </MudCheckBox>
                                }
                                break;
                        }
                    }
                </MudStack>
            </MudStack>
        </MudPaper>

        @* Map Viewport *@
        <MudPaper Elevation="4"
                  Class="rounded-panel flex-grow-1 position-relative overflow-hidden"
                  Style="@($"min-width:0;background-color:{MapBackground}")">
            <MudElement HtmlTag="div"
                        @bind-Ref="_viewport"
                        Class="map-viewport"
                        tabindex="0"
                        aria-label="@AppText.Get("MapKeyboardHint")"
                        @onclick="() => MapViewModel.SelectPoi(null)">
                <MudElement HtmlTag="div"
                            @bind-Ref="_canvas"
                            Class="map-canvas">
                    @* Map Image *@
                    <img src="images/map/dark.jpg"
                         alt="@AppText.Get("Map")"
                         class="map-image" />
                    <svg class="map-zipline"
                         viewBox="0 0 4096 4096">
                        @foreach (var zipline in MapViewModel.VisibleZiplines())
                        {
                            <line x1="@zipline.PointA.MapLeft"
                                  y1="@zipline.PointA.MapTop"
                                  x2="@zipline.PointB.MapLeft"
                                  y2="@zipline.PointB.MapTop"
                                  stroke="white"
                                  stroke-width="3"
                                  stroke-dasharray="8 6" />
                        }
                    </svg>
                    @if (_focusPixel is { } focus)
                    {
                        <img src="images/icons/crosshair.svg"
                             alt="@AppText.Get("Position")"
                             class="map-poi"
                             style="@PoiStyle(focus.Left, focus.Top, 32, 0, 98)" />
                    }
                    @foreach (var poi in MapViewModel.VisiblePois())
                    {
                        @* Point Icon *@
                        <img src="@poi.Icon"
                             alt="@poi.Title"
                             title="@poi.Title"
                             class="@(poi.IsSelected ? "map-poi selected" : "map-poi")"
                             role="button"
                             tabindex="-1"
                             data-keyclick
                             style="@PoiStyle(poi.MapLeft, poi.MapTop, poi.IconSize, poi.IconRotation, poi.IconZIndex)"
                             @onclick="() => MapViewModel.SelectPoi(poi)"
                             @onclick:stopPropagation />
                    }
                </MudElement>
            </MudElement>

            @* Zoom Buttons *@
            <MudStack Spacing="2"
                      Class="position-absolute ma-4"
                      Style="top:0;left:0">
                @* Zoom In *@
                <MudIconButton Icon="@Icons.Material.Rounded.Add"
                               aria-label="@AppText.Get("ZoomIn")"
                               Variant="Variant.Filled"
                               Size="Size.Small"
                               Class="map-overlay"
                               OnClick="() => ZoomAsync(1.25)" />
                @* Zoom Out *@
                <MudIconButton Icon="@Icons.Material.Rounded.Remove"
                               aria-label="@AppText.Get("ZoomOut")"
                               Variant="Variant.Filled"
                               Size="Size.Small"
                               Class="map-overlay"
                               OnClick="() => ZoomAsync(1 / 1.25)" />
                @* Whole Map *@
                <Tooltip Text="@AppText.Get("CenterMap")"
                         Placement="Placement.Right"
                         RootClass="d-flex">
                    <MudIconButton Icon="@Icons.Material.Rounded.ZoomOutMap"
                                   aria-label="@AppText.Get("CenterMap")"
                                   Variant="Variant.Filled"
                                   Size="Size.Small"
                                   Class="map-overlay"
                                   OnClick="CenterAsync" />
                </Tooltip>
                @* Menus Toggle *@
                <Tooltip Text="@MenusText"
                         Placement="Placement.Right"
                         RootClass="d-flex">
                    <MudIconButton Icon="@(_menusHidden ? Icons.Material.Rounded.Menu : Icons.Material.Rounded.MenuOpen)"
                                   aria-label="@MenusText"
                                   Variant="Variant.Filled"
                                   Size="Size.Small"
                                   Class="map-overlay"
                                   OnClick="ToggleMenusAsync" />
                </Tooltip>
            </MudStack>

            @if (MapViewModel.SelectedPoi is BasePoi selectedPoi)
            {
                <MudPaper Elevation="4"
                          Class="rounded-panel pa-4 map-overlay position-absolute ma-4 overflow-y-auto"
                          Style="top:0;right:0;width:360px;max-height:calc(100% - 32px)">
                    <PoiDetails Poi="selectedPoi"
                                OnMapChanged="StateHasChanged" />
                </MudPaper>
            }
        </MudPaper>
    </MudStack>

    @* Filter Overlay *@
    <MudOverlay Visible="_filtersOpen"
                OnClick="() => _filtersOpen = false" />
</RequiresSavegame>
