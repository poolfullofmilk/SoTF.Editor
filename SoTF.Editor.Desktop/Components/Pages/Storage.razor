@page "/Storage"
@inherits EditorPageBase

<RequiresSavegame NeedsWorld>
    @{
        // The Shown Storages, Worked Out Once Per Render
        var collections = FilteredCollections();
    }
    <MudStack Row
              Spacing="6"
              Class="page-fill">
        <MudElement HtmlTag="div"
                    Class="side-panel fill-column">
            <Header Title="@AppText.Get("StorageTypes")"
                    Class="fit">
                <TitleContent>
                    <MudSpacer />
                    @* Fill All Storages *@
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Info"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Rounded.AllInbox"
                               Disabled="@(!StoragePage.CanFillAllStorages())"
                               OnClick="FillAllStoragesAsync">
                        @AppText.Get("FillAllStorages")
                    </MudButton>
                </TitleContent>
                <ChildContent>
                    @* Storage Search *@
                    <SearchField @bind-Value="_filter"
                                 FullWidth />
                    <MudPaper Elevation="4"
                              Class="rounded-panel panel-flush overflow-y-auto fit">
                        @if (collections.Count == 0)
                        {
                            <MudText Typo="Typo.body2"
                                     Class="mud-text-secondary pa-4">
                                @AppText.Get("NothingFound")
                            </MudText>
                        }
                        @foreach (var (title, storages) in collections)
                        {
                            <GroupTitle Title="@title"
                                        Count="storages.Count"
                                        Highlight="@_filter" />
                            @foreach (var storage in storages)
                            {
                                @* Storage Row *@
                                <MudElement HtmlTag="div"
                                            Class="@StorageRowClass(storage)"
                                            role="button"
                                            tabindex="0"
                                            aria-pressed="@((StoragePage.SelectedStorage == storage) ? "true" : "false")"
                                            data-keyclick
                                            @onclick="() => SelectStorage(storage)">
                                    <MudStack Row
                                              AlignItems="AlignItems.Center"
                                              Spacing="2">
                                        <MudText Typo="Typo.body2"
                                                 Class="mud-typography-nowrap flex-grow-1">
                                            <MudHighlighter Text="@storage.Description"
                                                            HighlightedText="@_filter" />
                                            <ChangedDot When="@StoragePage.IsChanged(storage)" />
                                        </MudText>
                                        <MudText Typo="Typo.body2"
                                                 Class="mud-text-secondary">
                                            @storage.TotalStored
                                        </MudText>
                                    </MudStack>
                                </MudElement>
                            }
                        }
                    </MudPaper>
                </ChildContent>
            </Header>
        </MudElement>
        <MudElement HtmlTag="div"
                    Class="main-panel fill-column">
            @if (SelectedIn(collections) is not { } selected)
            {
                <EmptyState Icon="@Icons.Material.Rounded.Inventory2"
                            Text="@AppText.Get("SelectStorage")" />
            }
            else
            {
                <Header Title="@selected.Description"
                        Class="fit">
                    <TitleContent>
                        <MudText Typo="Typo.h5"
                                 Class="mud-text-secondary">
                            @selected.TotalStored
                        </MudText>
                        <MudSpacer />
                        @* Slot Item Menu *@
                        <MudMenu @ref="_slotMenu"
                                 PositionAtCursor
                                 Dense
                                 MaxHeight="400">
                            <ActivatorContent />
                            <ChildContent>
                                @foreach (var item in _menuSlot?.SupportedItems.OrderBy(item => item.Name) ?? Enumerable.Empty<ItemWrapper>())
                                {
                                    <MudMenuItem Icon="@(item == _menuSlot?.SelectedItem ? Icons.Material.Rounded.Check : null)"
                                                 OnClick="() => PickSlotItem(item)">
                                        <MudStack Row
                                                  AlignItems="AlignItems.Center"
                                                  Spacing="2">
                                            <MudImage Src="@PictureOf(item)"
                                                      Alt="@item.Name"
                                                      Class="thumb thumb-small" />
                                            @item.Name
                                        </MudStack>
                                    </MudMenuItem>
                                }
                            </ChildContent>
                        </MudMenu>
                        @* Set All Max *@
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   Disabled="@(!StoragePageViewModel.CanSetAllToMax(selected))"
                                   OnClick="() => StoragePageViewModel.SetAllToMax(selected)"
                                   StartIcon="@Icons.Material.Rounded.KeyboardDoubleArrowUp">
                            @AppText.Get("SetAllToMax")
                        </MudButton>
                        @* Apply To Same Type *@
                        <Tooltip Text="@AppText.Get("ApplyToSameTypeTooltip")"
                                 Disabled="@(!StoragePage.HasSameTypeStorages(selected))">
                            <MudButton Variant="Variant.Text"
                                       Size="Size.Small"
                                       Disabled="@(!StoragePage.HasSameTypeStorages(selected))"
                                       OnClick="() => ApplyToSameTypeAsync(selected)"
                                       StartIcon="@Icons.Material.Rounded.CopyAll">
                                @AppText.Get("ApplyToSameType")
                            </MudButton>
                        </Tooltip>
                        @* Clear All *@
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   Disabled="@(!StoragePageViewModel.HasStoredItems(selected))"
                                   OnClick="() => StoragePageViewModel.ClearAll(selected)"
                                   StartIcon="@Icons.Material.Rounded.ClearAll">
                            @AppText.Get("ClearAll")
                        </MudButton>
                        <ShowOnMapButton Position="selected.Pos" />
                    </TitleContent>
                    <ChildContent>
                        <MudPaper Elevation="4"
                                  Class="rounded-panel pa-4 overflow-y-auto fit">
                            <MudStack Spacing="4">
                                <MudStack Row
                                          AlignItems="AlignItems.Center"
                                          Wrap="Wrap.Wrap"
                                          Spacing="2">
                                    @* Fill Item *@
                                    <MudElement HtmlTag="div"
                                                Class="fixed-width"
                                                Style="width:220px">
                                        <MudSelect T="ItemWrapper"
                                                   Variant="Variant.Outlined"
                                                   Value="_fillItem"
                                                   ValueChanged="SelectFillItem"
                                                   Placeholder="@AppText.Get("FillAllWith")"
                                                   ToStringFunc="item => item?.Name ?? string.Empty"
                                                   Dense
                                                   Margin="Margin.Dense">
                                            @foreach (var item in selected.SupportedItems.OrderBy(item => item.Name))
                                            {
                                                <MudSelectItem Value="item">
                                                    <MudStack Row
                                                              AlignItems="AlignItems.Center"
                                                              Spacing="2">
                                                        <MudImage Src="@PictureOf(item)"
                                                                  Alt="@item.Name"
                                                                  Class="thumb thumb-small" />
                                                        @item.Name
                                                    </MudStack>
                                                </MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudElement>
                                    @* Fill Count *@
                                    <NumberField T="int"
                                                 @bind-Value="_fillCount"
                                                 Min="1"
                                                 Max="_fillItem?.Max ?? 1000"
                                                 Margin="Margin.Dense"
                                                 Style="width:110px" />
                                    @* Fill Button *@
                                    <Tooltip Text="@AppText.Get("FillFittingSlotsTooltip")"
                                             Disabled="@(_fillItem is null)">
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Info"
                                                   Size="Size.Small"
                                                   Disabled="@(_fillItem is null)"
                                                   OnClick="() => StoragePageViewModel.FillAll(selected, _fillItem!, _fillCount)">
                                            @AppText.Get("FillFittingSlots")
                                        </MudButton>
                                    </Tooltip>
                                </MudStack>

                                <MudDivider />

                                @foreach (var storedItem in StoragePageViewModel.StoredItemsOf(selected))
                                {
                                    <MudStack Row
                                              AlignItems="AlignItems.Center"
                                              Spacing="3"
                                              Class="hover-host">
                                        @if (storedItem.SelectedItem is { } slotItem)
                                        {
                                            <MudImage Src="@PictureOf(slotItem)"
                                                      Alt="@slotItem.Name"
                                                      Class="thumb rounded-thumb" />
                                        }
                                        else
                                        {
                                            <MudElement HtmlTag="span"
                                                        Class="thumb thumb-empty" />
                                        }
                                        @* Slot Item *@
                                        <MudButton Variant="Variant.Text"
                                                   Size="Size.Small"
                                                   EndIcon="@Icons.Material.Rounded.ArrowDropDown"
                                                   Class="@(storedItem.HasItem() ? null : "mud-text-secondary")"
                                                   data-menu-at
                                                   OnClick="args => OpenSlotMenuAsync(args, storedItem)">
                                            @(storedItem.SelectedItem?.Name ?? AppText.Get("EmptySlot"))
                                        </MudButton>
                                        <MudSpacer />
                                        @* Slot Count *@
                                        <ChangedBadge When="@StoragePage.IsChanged(selected, storedItem)">
                                            <NumberField T="int"
                                                         @bind-Value="storedItem.Count"
                                                         Min="0"
                                                         Max="storedItem.Max"
                                                         Disabled="@(!storedItem.HasItem())"
                                                         Margin="Margin.Dense"
                                                         Style="width:110px" />
                                        </ChangedBadge>
                                        @* Slot Max *@
                                        <MaxButton Max="storedItem.Max"
                                                   Disabled="@(!storedItem.HasItem() || storedItem.Count >= storedItem.Max)"
                                                   Class="hover-action"
                                                   OnClick="storedItem.SetToMax" />
                                        @* Slot Remove *@
                                        <MudIconButton Icon="@Icons.Material.Rounded.Delete"
                                                       aria-label="@AppText.Get("Remove")"
                                                       title="@(storedItem.HasItem() ? AppText.Get("Remove") : null)"
                                                       Size="Size.Small"
                                                       Class="hover-action danger-hover"
                                                       Disabled="@(!storedItem.HasItem())"
                                                       OnClick="storedItem.Clear" />
                                    </MudStack>
                                }
                            </MudStack>
                        </MudPaper>
                    </ChildContent>
                </Header>
            }
        </MudElement>
    </MudStack>
</RequiresSavegame>
