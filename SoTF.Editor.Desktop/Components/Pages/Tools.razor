@page "/Tools"
@inherits EditorPageBase

<RequiresSavegame>
    <MudStack Spacing="6">
        <MudAlert Severity="Severity.Info"
                  Dense
                  Elevation="4"
                  Class="rounded-panel">
            @AppText.Get("ToolsHint")
        </MudAlert>

        @foreach (var section in s_sections)
        {
            <Header Title="@AppText.Get(section.TitleKey)">
                <MudGrid>

                    @foreach (var tool in section.Tools)
                    {
                        <MudItem xs="12"
                                 sm="6"
                                 lg="4">
                            @* Tool Card *@
                            <ChangedBadge When="MainViewModel.IsToolChanged(tool.TitleKey)"
                                          Class="d-block mud-height-full">
                                <MudPaper Elevation="4"
                                          Class="@CardClass(tool)"
                                          role="button"
                                          tabindex="@(IsAvailable(tool) ? 0 : -1)"
                                          aria-disabled="@(IsAvailable(tool) ? "false" : "true")"
                                          data-keyclick
                                          @onclick="() => RunAsync(tool)">
                                    <MudStack Row
                                              AlignItems="AlignItems.Stretch"
                                              Spacing="3"
                                              Class="mud-height-full">
                                        <MudIcon Icon="@tool.Icon"
                                                 Color="Color.Info" />
                                        <MudStack Spacing="1"
                                                  Class="flex-grow-1"
                                                  Style="min-width:0">
                                            <MudStack Row
                                                      AlignItems="AlignItems.Start"
                                                      Spacing="2">
                                                <MudText Typo="Typo.subtitle1"
                                                         Class="text-tight flex-grow-1"
                                                         Style="font-weight:700">
                                                    @AppText.Get(tool.TitleKey)
                                                </MudText>
                                                <MudChip T="string"
                                                         Variant="Variant.Text"
                                                         Size="Size.Small"
                                                         Color="@ChipColor(tool)"
                                                         Class="ma-0 flex-shrink-0"
                                                         Style="margin-top:2px !important">
                                                    @AppText.Get(ChipKey(tool))
                                                </MudChip>
                                            </MudStack>
                                            <MudText Typo="Typo.body2"
                                                     Class="mud-text-secondary text-relaxed">
                                                @AppText.Get(tool.TextKey)
                                            </MudText>
                                            @if (ValueOf(tool) is { } value)
                                            {
                                                <MudText Typo="Typo.body2"
                                                         Color="Color.Info"
                                                         Class="mt-auto pt-1">
                                                    @value
                                                </MudText>
                                            }
                                        </MudStack>
                                    </MudStack>
                                </MudPaper>
                            </ChangedBadge>
                        </MudItem>
                    }

                </MudGrid>
            </Header>
        }
    </MudStack>
</RequiresSavegame>
