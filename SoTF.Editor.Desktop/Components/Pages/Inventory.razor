@page "/Inventory"
@inherits EditorPageBase

<RequiresSavegame>
    <MudStack Class="page-fill">
        <Header Title="@AppText.Get("Items")"
                Class="fit">
            <TitleContent>
                <MudSpacer />
                @* Add All *@
                <MudButton Variant="Variant.Text"
                           Size="Size.Small"
                           Disabled="@(!InventoryPage.HasUnassignedItems())"
                           OnClick="AddAllAsync">
                    @AppText.Get("AddAll")
                </MudButton>
                @* Set All Min *@
                <MudButton Variant="Variant.Text"
                           Size="Size.Small"
                           Disabled="@(!InventoryPage.CanSetAllToMin())"
                           OnClick="InventoryPage.SetAllEquippedToMin">
                    @AppText.Get("SetAllToMin")
                </MudButton>
                @* Set All Max *@
                <MudButton Variant="Variant.Text"
                           Size="Size.Small"
                           Disabled="@(!InventoryPage.CanSetAllToMax())"
                           OnClick="InventoryPage.SetAllEquippedToMax">
                    @AppText.Get("SetAllToMax")
                </MudButton>
                @* Remove All *@
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           Size="Size.Small"
                           Disabled="@(!InventoryPage.HasInventoryItems())"
                           OnClick="RemoveAllAsync">
                    @AppText.Get("RemoveAll")
                </MudButton>
            </TitleContent>
            <ChildContent>
                <MudPaper Elevation="4"
                          Class="rounded-panel panel-flush fit fill-column">
                    <MudStack Row
                              AlignItems="AlignItems.Center"
                              Spacing="4"
                              Class="pa-4 pb-2">
                        @* Item Search *@
                        <SearchField @bind-Value="_filter" />
                        @* Category *@
                        <MudSelect T="Category"
                                   Variant="Variant.Outlined"
                                   @bind-Value="_category"
                                   Placeholder="@AppText.Get("Type")"
                                   ToStringFunc="category => category?.TypeRendered ?? string.Empty"
                                   Clearable
                                   Dense
                                   Margin="Margin.Dense"
                                   Style="max-width:200px">
                            @foreach (var category in InventoryPage.Categories.OrderBy(category => category.TypeRendered))
                            {
                                <MudSelectItem Value="category">@category.TypeRendered</MudSelectItem>
                            }
                        </MudSelect>
                        @* Add Category *@
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   Disabled="@(_category is null)"
                                   Class="text-nowrap flex-shrink-0"
                                   OnClick="AddCategory">
                            @AppText.Get("AddAllFromCategory")
                        </MudButton>
                        @* Held Only *@
                        <MudSwitch T="bool"
                                   @bind-Value="_heldOnly"
                                   Color="Color.Info"
                                   Label="@AppText.Get("HeldOnly")"
                                   Class="flex-shrink-0" />
                    </MudStack>
                    <MudTable T="InventoryItem"
                              Items="Items"
                              Dense
                              Hover
                              FixedHeader
                              Virtualize
                              OverscanCount="20"
                              ItemSize="AppTheme.ListRowHeight"
                              RowStyle="@AppTheme.ListRowStyle"
                              Elevation="0"
                              Class="fit fixed-columns">

                        <ColGroup>
                            <col />
                            <col class="count-column" />
                            <col class="actions-column" />
                        </ColGroup>
                        <HeaderContent>
                            <MudTh>@AppText.Get("Name")</MudTh>
                            <MudTh>@AppText.Get("Count")</MudTh>
                            <MudTh />
                        </HeaderContent>
                        <RowTemplate>
                            @if (InventoryPage.IsHeld(context))
                            {
                                <MudTd>
                                    <ItemLabel Name="@context.Name"
                                               Detail="@($"{context.TypeRendered} · {context.Id}")"
                                               ImageUrl="@context.ImageUrl"
                                               Highlight="@_filter" />
                                </MudTd>
                                <MudTd>
                                    @* Count *@
                                    <ChangedBadge When="@InventoryPage.IsChanged(context)"
                                                  Class="d-inline-block">
                                        <NumberField T="int"
                                                     @bind-Value="context.TotalCount"
                                                     Min="1"
                                                     Max="context.Max"
                                                     Disabled="context.IsEquipped"
                                                     Margin="Margin.Dense"
                                                     Style="width:110px" />
                                    </ChangedBadge>
                                </MudTd>
                                <MudTd Style="text-align:right">
                                    @* Max Button *@
                                    <MaxButton Max="context.Max"
                                               Disabled="@(context.IsEquipped || context.TotalCount >= context.Max)"
                                               OnClick="context.SetToMax" />
                                    @* Remove Button *@
                                    <MudIconButton Icon="@Icons.Material.Rounded.Delete"
                                                   aria-label="@AppText.Get("Remove")"
                                                   title="@AppText.Get("Remove")"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="() => InventoryPage.RemoveItemFromInventory(context)" />
                                </MudTd>
                            }
                            else
                            {
                                <MudTd Class="not-held">
                                    <ItemLabel Name="@context.Name"
                                               Detail="@($"{context.TypeRendered} · {context.Id}")"
                                               ImageUrl="@context.ImageUrl"
                                               Highlight="@_filter" />
                                </MudTd>
                                <MudTd>
                                    <ChangedDot When="@InventoryPage.IsChanged(context)"
                                                Centered />
                                </MudTd>
                                <MudTd Style="text-align:right">
                                    @* Add Button *@
                                    <MudIconButton Icon="@Icons.Material.Rounded.AddCircle"
                                                   aria-label="@AppText.Get("AddToInventory")"
                                                   title="@AppText.Get("AddToInventory")"
                                                   Color="Color.Success"
                                                   Size="Size.Small"
                                                   OnClick="() => InventoryPage.AddUnassignedItem(context)" />
                                </MudTd>
                            }
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Typo="Typo.body2"
                                     Class="mud-text-secondary">
                                @AppText.Get("NothingFound")
                            </MudText>
                        </NoRecordsContent>

                    </MudTable>
                </MudPaper>
            </ChildContent>
        </Header>
    </MudStack>
</RequiresSavegame>
