@page "/Inventory"
@inherits EditorPageBase

<RequiresSavegame>
    <MudStack Class="page-fill">
        <MudGrid Class="fill">

            <MudItem xs="12"
                     md="6"
                     Class="fill-column">
                <Header Title="@Localizer["ItemsInInventory"]"
                        Class="fill">
                    <TitleContent>
                        <MudSpacer />
                        @* Set All Min *@
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   Disabled="@(!InventoryPage.HasInventoryItems())"
                                   OnClick="InventoryPage.SetAllEquippedToMin">
                            @Localizer["SetAllToMin"]
                        </MudButton>
                        @* Set All Max *@
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   Disabled="@(!InventoryPage.HasInventoryItems())"
                                   OnClick="InventoryPage.SetAllEquippedToMax">
                            @Localizer["SetAllToMax"]
                        </MudButton>
                        @* Remove All *@
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   Disabled="@(!InventoryPage.HasInventoryItems())"
                                   OnClick="RemoveAllAsync">
                            @Localizer["RemoveAll"]
                        </MudButton>
                    </TitleContent>
                    <ChildContent>
                        <MudPaper Elevation="4"
                                  Class="rounded-panel pa-4 fill fill-column">
                            @* Inventory Search *@
                            <MudTextField T="string"
                                          @bind-Value="_inventoryFilter"
                                          DebounceInterval="300"
                                          Placeholder="@Localizer["Filter"]"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Rounded.Search"
                                          Clearable
                                          Class="mb-2" />
                            <MudTable T="InventoryItem"
                                      Items="InventoryPage.FilterInventory(_inventoryFilter)"
                                      Dense
                                      Hover
                                      FixedHeader
                                      Virtualize
                                      Elevation="0"
                                      Class="fill fixed-columns">

                                <ColGroup>
                                    <col />
                                    <col class="count-column" />
                                    <col class="actions-column" />
                                </ColGroup>
                                <HeaderContent>
                                    <MudTh>@Localizer["Name"]</MudTh>
                                    <MudTh>@Localizer["Count"]</MudTh>
                                    <MudTh />
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>
                                        <ItemLabel Name="@context.Name"
                                                   Detail="@($"{context.TypeRendered} · {context.Id}")"
                                                   ImageUrl="@context.ImageUrl" />
                                    </MudTd>
                                    <MudTd>
                                        @* Count *@
                                        <MudNumericField T="int"
                                                         @bind-Value="context.TotalCount"
                                                         Min="1"
                                                         Max="context.Max"
                                                         Disabled="context.IsEquipped"
                                                         Margin="Margin.Dense"
                                                         Style="width:110px" />
                                    </MudTd>
                                    <MudTd Style="text-align:right">
                                        @* Max Button *@
                                        <MaxButton Max="context.Max"
                                                   Disabled="context.IsEquipped"
                                                   OnClick="context.SetToMax" />
                                        @* Remove Button *@
                                        <Tooltip Text="@Localizer["Remove"]">
                                            <MudIconButton Icon="@Icons.Material.Rounded.Delete"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           OnClick="() => InventoryPage.RemoveItemFromInventory(context)" />
                                        </Tooltip>
                                    </MudTd>
                                </RowTemplate>

                            </MudTable>
                        </MudPaper>
                    </ChildContent>
                </Header>
            </MudItem>

            <MudItem xs="12"
                     md="6"
                     Class="fill-column">
                <Header Title="@Localizer["UnassignedItems"]"
                        Class="fill">
                    <MudPaper Elevation="4"
                              Class="rounded-panel pa-4 fill fill-column">
                        <MudStack Row
                                  AlignItems="AlignItems.Center"
                                  Spacing="4"
                                  Class="mb-2">
                            @* Unassigned Search *@
                            <MudTextField T="string"
                                          @bind-Value="_unassignedFilter"
                                          DebounceInterval="300"
                                          Placeholder="@Localizer["Filter"]"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Rounded.Search"
                                          Clearable />
                            @* Category *@
                            <MudSelect T="Category"
                                       @bind-Value="_category"
                                       Placeholder="@Localizer["Type"]"
                                       ToStringFunc="category => category?.TypeRendered ?? string.Empty"
                                       Dense
                                       Style="max-width:180px">
                                @foreach (var category in InventoryPage.Categories)
                                {
                                    <MudSelectItem Value="category">@category.TypeRendered</MudSelectItem>
                                }
                            </MudSelect>
                            @* Add Category *@
                            <MudButton Variant="Variant.Text"
                                       Size="Size.Small"
                                       Disabled="@(_category is null)"
                                       Class="text-nowrap flex-shrink-0"
                                       OnClick="AddCategory">
                                @Localizer["AddAllFromCategory"]
                            </MudButton>
                        </MudStack>
                        <MudTable T="InventoryItem"
                                  Items="InventoryPage.FilterUnassignedItems(_unassignedFilter)"
                                  Dense
                                  Hover
                                  FixedHeader
                                  Virtualize
                                  Elevation="0"
                                  Class="fill">

                            <HeaderContent>
                                <MudTh>@Localizer["Name"]</MudTh>
                                <MudTh />
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <ItemLabel Name="@context.Name"
                                               Detail="@($"{context.TypeRendered} · {context.Id}")"
                                               ImageUrl="@context.ImageUrl" />
                                </MudTd>
                                <MudTd Style="text-align:right">
                                    @* Add Button *@
                                    <Tooltip Text="@Localizer["Add"]">
                                        <MudIconButton Icon="@Icons.Material.Rounded.AddCircle"
                                                       Color="Color.Info"
                                                       Size="Size.Small"
                                                       OnClick="() => InventoryPage.AddUnassignedItem(context)" />
                                    </Tooltip>
                                </MudTd>
                            </RowTemplate>

                        </MudTable>
                    </MudPaper>
                </Header>
            </MudItem>

        </MudGrid>
    </MudStack>
</RequiresSavegame>
