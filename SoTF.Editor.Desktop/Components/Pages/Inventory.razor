@page "/Inventory"
@inherits EditorPageBase

<RequiresSavegame>
    <MudStack Class="page-fill">
        <Header Title="@Localizer["Items"]"
                Class="fill">
            <TitleContent>
                <MudSpacer />
                @* Set All Min *@
                <MudButton Variant="Variant.Text"
                           Size="Size.Small"
                           Disabled="@(!InventoryPage.HasInventoryItems())"
                           OnClick="InventoryPage.SetAllEquippedToMin">
                    @Localizer["SetAllToMin"]
                </MudButton>
                @* Set All Max *@
                <MudButton Variant="Variant.Text"
                           Size="Size.Small"
                           Disabled="@(!InventoryPage.HasInventoryItems())"
                           OnClick="InventoryPage.SetAllEquippedToMax">
                    @Localizer["SetAllToMax"]
                </MudButton>
                @* Remove All *@
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           Size="Size.Small"
                           Disabled="@(!InventoryPage.HasInventoryItems())"
                           OnClick="RemoveAllAsync">
                    @Localizer["RemoveAll"]
                </MudButton>
            </TitleContent>
            <ChildContent>
                <MudPaper Elevation="4"
                          Class="rounded-panel panel-flush fill fill-column">
                    <MudStack Row
                              AlignItems="AlignItems.Center"
                              Spacing="4"
                              Class="pa-4 pb-2">
                        @* Item Search *@
                        <MudTextField T="string"
                                      Variant="Variant.Outlined"
                                      @bind-Value="_filter"
                                      DebounceInterval="300"
                                      Placeholder="@Localizer["Filter"]"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Rounded.Search"
                                      Margin="Margin.Dense"
                                      Clearable />
                        @* Category *@
                        <MudSelect T="Category"
                                   Variant="Variant.Outlined"
                                   @bind-Value="_category"
                                   Placeholder="@Localizer["Type"]"
                                   ToStringFunc="category => category?.TypeRendered ?? string.Empty"
                                   Clearable
                                   Dense
                                   Margin="Margin.Dense"
                                   Style="max-width:200px">
                            @foreach (var category in InventoryPage.Categories)
                            {
                                <MudSelectItem Value="category">@category.TypeRendered</MudSelectItem>
                            }
                        </MudSelect>
                        @* Add Category *@
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   Disabled="@(_category is null)"
                                   Class="text-nowrap flex-shrink-0"
                                   OnClick="AddCategory">
                            @Localizer["AddAllFromCategory"]
                        </MudButton>
                        @* Held Only *@
                        <MudSwitch T="bool"
                                   @bind-Value="_heldOnly"
                                   Color="Color.Info"
                                   Label="@Localizer["HeldOnly"]"
                                   Class="flex-shrink-0" />
                    </MudStack>
                    <MudTable T="InventoryItem"
                              Items="Items"
                              Dense
                              Hover
                              FixedHeader
                              Virtualize
                              Elevation="0"
                              Class="fill fixed-columns">

                        <ColGroup>
                            <col />
                            <col class="count-column" />
                            <col class="actions-column" />
                        </ColGroup>
                        <HeaderContent>
                            <MudTh>@Localizer["Name"]</MudTh>
                            <MudTh>@Localizer["Count"]</MudTh>
                            <MudTh />
                        </HeaderContent>
                        <RowTemplate>
                            @if (InventoryPage.IsHeld(context))
                            {
                                <MudTd>
                                    <ItemLabel Name="@context.Name"
                                               Detail="@($"{context.TypeRendered} · {context.Id}")"
                                               ImageUrl="@context.ImageUrl" />
                                </MudTd>
                                <MudTd>
                                    @* Count *@
                                    <MudNumericField T="int"
                                                     Variant="Variant.Outlined"
                                                     @bind-Value="context.TotalCount"
                                                     Min="1"
                                                     Max="context.Max"
                                                     Disabled="context.IsEquipped"
                                                     Margin="Margin.Dense"
                                                     Style="width:110px" />
                                </MudTd>
                                <MudTd Style="text-align:right">
                                    @* Max Button *@
                                    <MaxButton Max="context.Max"
                                               Disabled="context.IsEquipped"
                                               OnClick="context.SetToMax" />
                                    @* Remove Button *@
                                    <Tooltip Text="@Localizer["Remove"]">
                                        <MudIconButton Icon="@Icons.Material.Rounded.Delete"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       OnClick="() => InventoryPage.RemoveItemFromInventory(context)" />
                                    </Tooltip>
                                </MudTd>
                            }
                            else
                            {
                                <MudTd Class="not-held">
                                    <ItemLabel Name="@context.Name"
                                               Detail="@($"{context.TypeRendered} · {context.Id}")"
                                               ImageUrl="@context.ImageUrl" />
                                </MudTd>
                                <MudTd />
                                <MudTd Style="text-align:right">
                                    @* Add Button *@
                                    <Tooltip Text="@Localizer["AddToInventory"]">
                                        <MudIconButton Icon="@Icons.Material.Rounded.AddCircle"
                                                       Color="Color.Success"
                                                       Size="Size.Small"
                                                       OnClick="() => InventoryPage.AddUnassignedItem(context)" />
                                    </Tooltip>
                                </MudTd>
                            }
                        </RowTemplate>

                    </MudTable>
                </MudPaper>
            </ChildContent>
        </Header>
    </MudStack>
</RequiresSavegame>
