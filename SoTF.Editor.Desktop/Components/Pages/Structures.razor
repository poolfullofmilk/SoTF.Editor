@page "/Structures"
@inherits EditorPageBase

<RequiresSavegame NeedsWorld>
    <MudStack Row
              Spacing="6"
              Class="page-fill">
        <MudElement HtmlTag="div"
                    Class="side-panel fill-column">
            <MudStack Spacing="2"
                      Class="fill">
                @* Structure Search *@
                <SearchField @bind-Value="_filter"
                             FullWidth />
                <MudPaper Elevation="4"
                          Class="rounded-panel panel-flush overflow-y-auto fit">
                    @* All Structures Row *@
                    <MudElement HtmlTag="div"
                                Class="@RowClass(_showAll)"
                                role="button"
                                tabindex="0"
                                aria-pressed="@(_showAll ? "true" : "false")"
                                data-keyclick
                                @onclick="SelectAll">
                        <MudStack Row
                                  AlignItems="AlignItems.Center"
                                  Spacing="2">
                            <MudIcon Icon="@Icons.Material.Rounded.Cabin"
                                     Class="thumb" />
                            <MudStack Spacing="0"
                                      Style="min-width:0">
                                <MudText Typo="Typo.body2"
                                         Class="text-truncate">
                                    @AppText.Get("AllStructures")
                                    <ChangedDot When="@StructuresPage.HasChanges" />
                                </MudText>
                                <MudText Typo="Typo.caption"
                                         Class="mud-text-secondary">
                                    @CountsOf(FilteredTypes.SelectMany(type => type.Structures))
                                </MudText>
                            </MudStack>
                        </MudStack>
                    </MudElement>
                    @if (!FilteredTypes.Any())
                    {
                        <MudText Typo="Typo.body2"
                                 Class="mud-text-secondary pa-4">
                            @AppText.Get("NothingFound")
                        </MudText>
                    }
                    @foreach (var category in FilteredTypes.GroupBy(type => type.Category))
                    {
                        <MudText Typo="Typo.subtitle2"
                                 Class="group-title px-4 pt-4 pb-1">
                            <MudHighlighter Text="@category.Key"
                                            HighlightedText="@_filter" />
                        </MudText>
                        @foreach (var type in category)
                        {
                            @* Structure Type Row *@
                            <MudElement HtmlTag="div"
                                        Class="@RowClass(!_showAll && _selectedName == type.Name)"
                                        role="button"
                                        tabindex="0"
                                        aria-pressed="@((!_showAll && _selectedName == type.Name) ? "true" : "false")"
                                        data-keyclick
                                        @onclick="() => Select(type)">
                                <ItemLabel Name="@type.Name"
                                           Detail="@CountsOf(type.Structures)"
                                           ImageUrl="@type.Icon"
                                           Changed="@type.Structures.Exists(structure => structure.IsChanged)"
                                           Highlight="@_filter" />
                            </MudElement>
                        }
                    }
                </MudPaper>
            </MudStack>
        </MudElement>
        <MudElement HtmlTag="div"
                    Class="main-panel fill-column">
            @if (ShownStructures is not { } shown)
            {
                <EmptyState Icon="@Icons.Material.Rounded.Cabin"
                            Text="@AppText.Get("SelectStructure")" />
            }
            else
            {
                <Header Title="@ShownTitle"
                        Info="@AppText.Get("StructuresInfo")"
                        Class="fit">
                    <TitleContent>
                        <MudSpacer />
                        @* Set All Menu *@
                        <MudMenu Label="@AppText.Get("SetAllTo")"
                                 EndIcon="@Icons.Material.Rounded.ArrowDropDown"
                                 Variant="Variant.Filled"
                                 Color="Color.Info"
                                 Size="Size.Small"
                                 AnchorOrigin="Origin.BottomRight"
                                 TransformOrigin="Origin.TopRight">
                            @foreach (var mode in s_modes)
                            {
                                @* Set All Item *@
                                <MudMenuItem Disabled="@(!StructuresPageViewModel.CanSetAll(shown, mode))"
                                             OnClick="() => SetAllAsync(shown, mode)">
                                    @ModeName(mode)
                                </MudMenuItem>
                            }
                        </MudMenu>
                    </TitleContent>
                    <ChildContent>
                        <MudPaper Elevation="4"
                                  Class="rounded-panel panel-flush fit fill-column">
                            <MudTable T="ScrewStructureWrapper"
                                      Items="shown"
                                      Dense
                                      Hover
                                      FixedHeader
                                      Virtualize
                                      OverscanCount="20"
                                      ItemSize="AppTheme.ListRowHeight"
                                      RowStyle="@AppTheme.ListRowStyle"
                                      Elevation="0"
                                      Class="fit fixed-columns"
                                      Style="--table-min-width:640px">

                                <ColGroup>
                                    <col />
                                    <col style="width:160px" />
                                    <col style="width:200px" />
                                    <col style="width:96px" />
                                </ColGroup>
                                <HeaderContent>
                                    <MudTh>@AppText.Get("Name")</MudTh>
                                    <MudTh>@AppText.Get("State")</MudTh>
                                    <MudTh>@AppText.Get("OnSave")</MudTh>
                                    <MudTh />
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd Class="overflow-hidden">
                                        <ItemLabel Name="@context.Name"
                                                   Detail="@context.Category"
                                                   ImageUrl="@IconOf(context)" />
                                    </MudTd>
                                    <MudTd>
                                        <MudText Typo="Typo.body2"
                                                 Color="@StateColor(context)">
                                            @StateText(context)
                                        </MudText>
                                    </MudTd>
                                    <MudTd>
                                        <MudStack Row
                                                  AlignItems="AlignItems.Center"
                                                  Spacing="1">
                                            @* Modification Button *@
                                            <ChangedBadge When="@context.IsChanged"
                                                          Class="d-inline-block">
                                                <MudButton Variant="Variant.Text"
                                                           Size="Size.Small"
                                                           EndIcon="@Icons.Material.Rounded.ArrowDropDown"
                                                           Disabled="@(context.ModificationModes.Count <= 1)"
                                                           OnClick="args => OpenModesAsync(args, context)">
                                                    @ModeName(context.ModificationMode ?? ScrewStructureModificationMode.None)
                                                </MudButton>
                                            </ChangedBadge>
                                            @if (context.NewPctDone is { } newPctDone)
                                            {
                                                <MudIcon Icon="@Icons.Material.Rounded.ArrowForward"
                                                         Size="Size.Small" />
                                                <MudText Typo="Typo.body2"
                                                         Color="Color.Warning">
                                                    @ScrewStructureWrapper.Printable(newPctDone)
                                                </MudText>
                                            }
                                        </MudStack>
                                    </MudTd>
                                    <MudTd Style="text-align:right">
                                        <ShowOnMapButton Position="context.Position" />
                                        @* Change Type *@
                                        <MudIconButton Icon="@Icons.Material.Rounded.SwapHoriz"
                                                       aria-label="@AppText.Get("ChangeType")"
                                                       title="@(context.CanChangeType() ? AppText.Get("ChangeType") : null)"
                                                       Size="Size.Small"
                                                       Disabled="@(!context.CanChangeType())"
                                                       OnClick="() => ChangeTypeAsync(context)" />
                                    </MudTd>
                                </RowTemplate>
                                <NoRecordsContent>
                                    <MudText Typo="Typo.body2"
                                             Class="mud-text-secondary">
                                        @AppText.Get("NothingFound")
                                    </MudText>
                                </NoRecordsContent>

                            </MudTable>
                            @* Modification Menu *@
                            <MudMenu @ref="_modeMenu"
                                     PositionAtCursor>
                                <ActivatorContent />
                                <ChildContent>
                                    @foreach (var mode in _menuStructure?.ModificationModes ?? [])
                                    {
                                        <MudMenuItem Icon="@(mode == _menuStructure?.ModificationMode ? Icons.Material.Rounded.Check : null)"
                                                     OnClick="() => SetMode(mode)">
                                            @ModeName(mode)
                                        </MudMenuItem>
                                    }
                                </ChildContent>
                            </MudMenu>
                        </MudPaper>
                    </ChildContent>
                </Header>
            }
        </MudElement>
    </MudStack>
</RequiresSavegame>
