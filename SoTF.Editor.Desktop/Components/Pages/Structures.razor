@page "/Structures"
@inherits EditorPageBase

<RequiresSavegame NeedsWorld>
    <MudStack Spacing="6"
              Class="page-fill">
        <Header Title="@AppText.Get("Batch")"
                Info="@AppText.Get("BatchHint")">
            <MudPaper Elevation="4"
                      Class="rounded-panel pa-4">
                <MudStack Spacing="3">
                    @* Batch Type *@
                    <MudSelect T="ScrewStructure"
                               Variant="Variant.Outlined"
                               @bind-Value="StructuresPage.BatchSelectedStructureType"
                               Label="@AppText.Get("StructureType")"
                               HelperText="@AppText.Get("AllTypesHint")"
                               ToStringFunc="StructureName"
                               Clearable
                               Dense>
                        @foreach (var structure in StructuresPage.StructureTypes)
                        {
                            <MudSelectItem Value="structure">@StructureName(structure)</MudSelectItem>
                        }
                    </MudSelect>
                    @foreach (var origin in s_origins)
                    {
                        var hasTargets = HasBatchTargets(origin.Origin);
                        <MudStack Row
                                  AlignItems="AlignItems.Center"
                                  Wrap="Wrap.Wrap"
                                  Spacing="2">
                            <MudText Typo="Typo.subtitle2"
                                     Style="width:200px">
                                @AppText.Get(origin.TitleKey)
                            </MudText>
                            @foreach (var batch in origin.Batches)
                            {
                                @* Batch Button *@
                                <MudButton Variant="Variant.Text"
                                           Size="Size.Small"
                                           Color="@(batch.Mode == ScrewStructureModificationMode.Remove ? Color.Error : Color.Default)"
                                           Disabled="@(!hasTargets)"
                                           OnClick="() => SetAllAsync(origin.Origin, batch.Mode)">
                                    @AppText.Get(batch.LabelKey)
                                </MudButton>
                            }
                        </MudStack>
                    }
                </MudStack>
            </MudPaper>
        </Header>

        <Header Title="@AppText.Get("Structures")"
                Class="fit">
            <MudPaper Elevation="4"
                      Class="rounded-panel panel-flush fit fill-column">
                @* Structure Search *@
                <SearchField @bind-Value="_filter"
                             Class="mx-4 mt-4 mb-2" />
                <MudTable T="StructureRow"
                          Items="Rows"
                          Dense
                          Hover
                          FixedHeader
                          Virtualize
                          OverscanCount="20"
                          ItemSize="AppTheme.ListRowHeight"
                          RowStyle="@AppTheme.ListRowStyle"
                          Elevation="0"
                          Class="fit fixed-columns">

                    <ColGroup>
                        <col />
                        <col style="width:160px" />
                        <col style="width:120px" />
                        <col style="width:160px" />
                        <col style="width:220px" />
                        <col style="width:112px" />
                    </ColGroup>
                    <HeaderContent>
                        <MudTh>@AppText.Get("Name")</MudTh>
                        <MudTh>@AppText.Get("Category")</MudTh>
                        <MudTh>@AppText.Get("Added")</MudTh>
                        <MudTh>@AppText.Get("PercentDone")</MudTh>
                        <MudTh>@AppText.Get("Modification")</MudTh>
                        <MudTh />
                    </HeaderContent>
                    <RowTemplate>
                        @if (context.Structure is { } structure)
                        {
                            <MudTd>
                                <ItemLabel Name="@structure.Name"
                                           Detail="@OriginName(structure)"
                                           ImageUrl="@IconOf(structure)"
                                           Highlight="@_filter" />
                            </MudTd>
                            <MudTd>
                                <MudHighlighter Text="@structure.Category"
                                                HighlightedText="@_filter" />
                            </MudTd>
                            <MudTd>
                                <MudHighlighter Text="@AddedText(structure)"
                                                HighlightedText="@_filter" />
                            </MudTd>
                            <MudTd>
                                @* Percent Done *@
                                <MudStack Row
                                          AlignItems="AlignItems.Center"
                                          Spacing="1">
                                    <MudText Typo="Typo.body2"
                                             Color="@(structure.NewPctDone is null ? ProgressColor(structure) : Color.Success)">
                                        <MudHighlighter Text="@structure.PctDonePrintable"
                                                        HighlightedText="@_filter" />
                                    </MudText>
                                    @if (structure.NewPctDone is { } newPctDone)
                                    {
                                        <MudIcon Icon="@Icons.Material.Rounded.ArrowForward"
                                                 Size="Size.Small" />
                                        <MudText Typo="Typo.body2"
                                                 Color="Color.Warning">
                                            @ScrewStructureWrapper.Printable(newPctDone)
                                        </MudText>
                                    }
                                </MudStack>
                            </MudTd>
                            <MudTd>
                                @* Modification Button *@
                                <ChangedBadge When="@structure.IsChanged"
                                              Class="d-inline-block">
                                    <MudButton Variant="Variant.Text"
                                               Size="Size.Small"
                                               EndIcon="@Icons.Material.Rounded.ArrowDropDown"
                                               Disabled="@(structure.ModificationModes.Count <= 1)"
                                               OnClick="args => OpenModesAsync(args, structure)">
                                        @ModeName(structure.ModificationMode)
                                    </MudButton>
                                </ChangedBadge>
                            </MudTd>
                            <MudTd Style="text-align:right">
                                <ShowOnMapButton Position="structure.Position" />
                                @* Change Type *@
                                <MudIconButton Icon="@Icons.Material.Rounded.SwapHoriz"
                                               aria-label="@AppText.Get("ChangeType")"
                                               title="@(structure.CanChangeType() ? AppText.Get("ChangeType") : null)"
                                               Size="Size.Small"
                                               Disabled="@(!structure.CanChangeType())"
                                               OnClick="() => ChangeTypeAsync(structure)" />
                            </MudTd>
                        }
                        else
                        {
                            <MudTd colspan="6">
                                <MudText Typo="Typo.subtitle2"
                                         Class="group-title">
                                    @context.Title
                                </MudText>
                            </MudTd>
                        }
                    </RowTemplate>

                </MudTable>
                @* Modification Menu *@
                <MudMenu @ref="_modeMenu"
                         PositionAtCursor>
                    <ActivatorContent />
                    <ChildContent>
                        @foreach (var mode in _menuStructure?.ModificationModes ?? [])
                        {
                            <MudMenuItem Icon="@(mode == _menuStructure?.ModificationMode ? Icons.Material.Rounded.Check : null)"
                                         OnClick="() => SetMode(mode)">
                                @ModeName(mode)
                            </MudMenuItem>
                        }
                    </ChildContent>
                </MudMenu>
            </MudPaper>
        </Header>
    </MudStack>
</RequiresSavegame>
