@page "/Structures"
@inherits EditorPageBase

<RequiresSavegame NeedsWorld>
    <MudStack Spacing="6"
              Class="page-fill">
        <Header Title="@Localizer["Batch"]"
                Info="@Localizer["BatchHint"]">
            <MudPaper Elevation="4"
                      Class="rounded-panel pa-4">
                <MudStack Spacing="3">
                    @* Batch Type *@
                    <MudSelect T="ScrewStructure"
                               Variant="Variant.Outlined"
                               @bind-Value="StructuresPage.BatchSelectedStructureType"
                               Label="@Localizer["StructureType"]"
                               HelperText="@Localizer["AllTypesHint"]"
                               ToStringFunc="StructureName"
                               Clearable
                               Dense>
                        @foreach (var structure in StructuresPage.StructureTypes)
                        {
                            <MudSelectItem Value="structure">@StructureName(structure)</MudSelectItem>
                        }
                    </MudSelect>
                    @foreach (var origin in s_origins)
                    {
                        var hasTargets = HasBatchTargets(origin.Origin);
                        <MudStack Row
                                  AlignItems="AlignItems.Center"
                                  Wrap="Wrap.Wrap"
                                  Spacing="2">
                            <MudText Typo="Typo.subtitle2"
                                     Style="width:200px">
                                @Localizer[origin.TitleKey]
                            </MudText>
                            @foreach (var batch in origin.Batches)
                            {
                                @* Batch Button *@
                                <MudButton Variant="Variant.Text"
                                           Size="Size.Small"
                                           Color="@(batch.Mode == ScrewStructureModificationMode.Remove ? Color.Error : Color.Default)"
                                           Disabled="@(!hasTargets)"
                                           OnClick="() => SetAllAsync(origin.Origin, batch.Mode)">
                                    @Localizer[batch.LabelKey]
                                </MudButton>
                            }
                        </MudStack>
                    }
                </MudStack>
            </MudPaper>
        </Header>

        <Header Title="@Localizer["Structures"]"
                Class="fit">
            <MudPaper Elevation="4"
                      Class="rounded-panel panel-flush fit fill-column">
                @* Structure Search *@
                <MudTextField T="string"
                              Variant="Variant.Outlined"
                              @bind-Value="_filter"
                              DebounceInterval="300"
                              Placeholder="@Localizer["Filter"]"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Rounded.Search"
                              Margin="Margin.Dense"
                              Clearable
                              Class="flex-grow-0 px-4 pt-4 pb-2" />
                <MudTable T="ScrewStructureWrapper"
                          Items="FilteredStructures"
                          GroupBy="s_groupByName"
                          Dense
                          Hover
                          FixedHeader
                          Elevation="0"
                          Class="fit">

                    <HeaderContent>
                        <MudTh>@Localizer["Name"]</MudTh>
                        <MudTh>@Localizer["Category"]</MudTh>
                        <MudTh>@Localizer["Added"]</MudTh>
                        <MudTh>@Localizer["PercentDone"]</MudTh>
                        <MudTh>@Localizer["Modification"]</MudTh>
                        <MudTh />
                    </HeaderContent>
                    <GroupHeaderTemplate>
                        <MudTh colspan="6">
                            <MudText Typo="Typo.subtitle2"
                                     Class="group-title">
                                @($"{context.Key} ({context.Items.Count()})")
                            </MudText>
                        </MudTh>
                    </GroupHeaderTemplate>
                    <RowTemplate>
                        <MudTd>
                            <ItemLabel Name="@context.Name"
                                       Detail="@Localizer[context.Origin == ScrewStructureOrigin.Finished ? "FinishedStructures" : "UnfinishedStructures"]"
                                       ImageUrl="@IconOf(context)" />
                        </MudTd>
                        <MudTd>@context.Category</MudTd>
                        <MudTd>@($"{context.Added} / {context.BuildCost}")</MudTd>
                        <MudTd>
                            @* Percent Done *@
                            <MudStack Row
                                      AlignItems="AlignItems.Center"
                                      Spacing="1">
                                <MudText Typo="Typo.body2"
                                         Color="@(context.NewPctDone is null ? ProgressColor(context) : Color.Success)">
                                    @context.PctDonePrintable
                                </MudText>
                                @if (context.NewPctDone is { } newPctDone)
                                {
                                    <MudIcon Icon="@Icons.Material.Rounded.ArrowForward"
                                             Size="Size.Small" />
                                    <MudText Typo="Typo.body2"
                                             Color="Color.Warning">
                                        @ScrewStructureWrapper.Printable(newPctDone)
                                    </MudText>
                                }
                            </MudStack>
                        </MudTd>
                        <MudTd>
                            @* Modification *@
                            <ChangedBadge When="@context.IsChanged"
                                          Class="d-block">
                                <MudSelect T="ScrewStructureModificationMode?"
                                           Variant="Variant.Outlined"
                                           @bind-Value="context.ModificationMode"
                                           ToStringFunc="ModeName"
                                           Disabled="@(context.ModificationModes.Count <= 1)"
                                           Dense
                                           Margin="Margin.Dense"
                                           Style="min-width:150px">
                                    @foreach (var mode in context.ModificationModes)
                                    {
                                        <MudSelectItem T="ScrewStructureModificationMode?"
                                                       Value="mode">
                                            @ModeName(mode)
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </ChangedBadge>
                        </MudTd>
                        <MudTd Style="text-align:right">
                            <ShowOnMapButton Position="context.Position" />
                            @* Change Type *@
                            <Tooltip Text="@Localizer["ChangeType"]">
                                <MudIconButton Icon="@Icons.Material.Rounded.SwapHoriz"
                                               Size="Size.Small"
                                               Disabled="@(!context.CanChangeType())"
                                               OnClick="() => ChangeTypeAsync(context)" />
                            </Tooltip>
                        </MudTd>
                    </RowTemplate>

                </MudTable>
            </MudPaper>
        </Header>
    </MudStack>
</RequiresSavegame>
