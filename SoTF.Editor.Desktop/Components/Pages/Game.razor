@page "/Game"
@inherits EditorPageBase

<RequiresSavegame NeedsWorld>
    <MudTabs Elevation="4"
             TabHeaderClass="mb-6"
             AlwaysShowScrollButtons
             Rounded>

        @* Setup Tab *@
        <MudTabPanel Text="@AppText.Get("GameSetup")"
                     Icon="@Icons.Material.Rounded.Tune"
                     IconColor="Color.Tertiary">
            <MudStack Spacing="6">
                <MudPaper Elevation="4"
                          Class="rounded-panel pa-4">
                    <MudGrid>

                        <MudItem xs="12"
                                 md="6">
                            <MudStack Row
                                      AlignItems="AlignItems.Center"
                                      Spacing="1">
                                @* Load Preset *@
                                <Tooltip Text="@AppText.Get("LoadPreset")"
                                         RootClass="d-flex flex-shrink-0">
                                    <MudMenu Icon="@Icons.Material.Rounded.Tune"
                                             AriaLabel="@AppText.Get("LoadPreset")"
                                             Size="Size.Small">
                                        @foreach (var mode in Presets)
                                        {
                                            <MudMenuItem OnClick="() => LoadPresetAsync(mode.Value)">@AppText.Get(mode.LabelKey)</MudMenuItem>
                                        }
                                    </MudMenu>
                                </Tooltip>
                                @* Game Mode *@
                                <ChangedBadge When="ModeChanged"
                                              Class="flex-grow-1">
                                    <MudSelect T="string"
                                               Variant="Variant.Outlined"
                                               @bind-Value="GameSetup.SelectedMode"
                                               Label="@AppText.Get("Mode")"
                                               ToStringFunc="value => LabelOf(s_modes, value)">
                                        @foreach (var mode in s_modes)
                                        {
                                            <MudSelectItem Value="mode.Value">@AppText.Get(mode.LabelKey)</MudSelectItem>
                                        }
                                    </MudSelect>
                                </ChangedBadge>
                                <InfoIcon Text="@AppText.Get("ModeInfo")" />
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12"
                                 md="6">
                            <MudStack Row
                                      AlignItems="AlignItems.Center"
                                      Spacing="1">
                                <MudTextField T="string"
                                              Variant="Variant.Outlined"
                                              Value="GameSetup.Uid"
                                              Label="@AppText.Get("Uid")"
                                              Disabled />
                                <InfoIcon Text="@AppText.Get("UidInfo")" />
                            </MudStack>
                        </MudItem>

                    </MudGrid>
                </MudPaper>

                @if (IsCustom)
                {
                    @foreach (var group in s_setupGroups)
                    {
                        <Header Title="@AppText.Get(group.TitleKey)"
                                Icon="@group.Icon">
                            <TitleContent>
                                <MudSpacer />
                                @* Reset Group *@
                                <MudButton Variant="Variant.Text"
                                           Size="Size.Small"
                                           Disabled="@(!GameSetup.HasAny(KeysOf(group)))"
                                           OnClick="() => GameSetup.ResetSettings(KeysOf(group))">
                                    @AppText.Get("SetAllToDefault")
                                </MudButton>
                            </TitleContent>
                            <ChildContent>
                                <MudPaper Elevation="4"
                                          Class="rounded-panel pa-4">
                                    <MudGrid>

                                        @foreach (var setting in group.Selects)
                                        {
                                            <MudItem xs="12"
                                                     sm="6"
                                                     md="4">
                                                <MudStack Row
                                                          AlignItems="AlignItems.Center"
                                                          Spacing="1">
                                                    @* Setup Select *@
                                                    <ChangedBadge When="@GameSetup.IsChanged(setting.Key, setting.Fallback)"
                                                                  Class="flex-grow-1">
                                                        <MudSelect T="string"
                                                                   Variant="Variant.Outlined"
                                                                   Value="GameSetup.GetString(setting.Key, setting.Fallback)"
                                                                   ValueChanged="value => GameSetup.SetString(setting.Key, value, setting.Fallback)"
                                                                   Label="@AppText.Get(setting.LabelKey)"
                                                                   Clearable
                                                                   ToStringFunc="value => LabelOf(setting.Options, value)">
                                                            @foreach (var option in setting.Options)
                                                            {
                                                                <MudSelectItem Value="option.Value">@AppText.Get(option.LabelKey)</MudSelectItem>
                                                            }
                                                        </MudSelect>
                                                    </ChangedBadge>
                                                    <InfoIcon Text="@AppText.Get(setting.InfoKey)" />
                                                </MudStack>
                                            </MudItem>
                                        }
                                        @foreach (var toggle in group.Toggles)
                                        {
                                            <MudItem xs="12"
                                                     sm="6"
                                                     md="4"
                                                     Class="d-flex align-center">
                                                @* Setup Switch *@
                                                <MudSwitch T="bool"
                                                           Value="GameSetup.GetBool(toggle.Key, toggle.Fallback)"
                                                           ValueChanged="value => GameSetup.SetBool(toggle.Key, value, toggle.Fallback)"
                                                           Color="Color.Info">
                                                    @AppText.Get(toggle.LabelKey)
                                                    <ChangedDot When="@GameSetup.IsChanged(toggle.Key, toggle.Fallback)" />
                                                    <InfoIcon Text="@AppText.Get(toggle.InfoKey)" />
                                                </MudSwitch>
                                            </MudItem>
                                        }

                                    </MudGrid>
                                </MudPaper>
                            </ChildContent>
                        </Header>
                    }
                }
                else
                {
                    @* Custom Hint *@
                    <MudAlert Severity="Severity.Info"
                              Dense
                              Elevation="4"
                              Class="rounded-panel">
                        @AppText.Get("CustomHint")
                    </MudAlert>
                }
            </MudStack>
        </MudTabPanel>

        @* State Tab *@
        <MudTabPanel Text="@AppText.Get("GameState")"
                     Icon="@Icons.Material.Rounded.AccessTimeFilled"
                     IconColor="Color.Tertiary">
            <MudStack Row
                      Spacing="6"
                      Class="fill">

                <MudElement HtmlTag="div"
                            Class="main-panel fill-column">
                    <Header Title="@AppText.Get("GameState")"
                            Class="fit">
                        <MudPaper Elevation="4"
                                  Class="rounded-panel panel-flush overflow-y-auto fit">
                            <MudSimpleTable Dense
                                            Elevation="0">
                                <tbody>
                                    @foreach (var setting in GameState.Settings)
                                    {
                                        <tr>
                                            <td style="width:40%">
                                                <MudStack Row
                                                          AlignItems="AlignItems.Center"
                                                          Spacing="1">
                                                    <MudText Typo="Typo.body2">@AppText.Get(TextKeys.Setting(setting.Name))</MudText>
                                                    @if (InfoOf(setting.Name) is { } info)
                                                    {
                                                        <InfoIcon Text="@info" />
                                                    }
                                                </MudStack>
                                            </td>
                                            <td>
                                                <GenericSettingEditor Setting="setting"
                                                                      Changed="@GameState.IsChanged(setting)" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </MudPaper>
                    </Header>
                </MudElement>

                <MudElement HtmlTag="div"
                            Class="main-panel fill-column">
                    <Header Title="@AppText.Get("WorldObjectStates")"
                            Info="@AppText.Get("WorldObjectStatesInfo")"
                            Class="fit">
                        <MudPaper Elevation="4"
                                  Class="rounded-panel panel-flush fit fill-column">
                            @* World Object Search *@
                            <SearchField @bind-Value="_namedIntFilter"
                                         Class="mx-4 mt-4 mb-2" />
                            <MudTable T="GenericSetting"
                                      Items="FilteredNamedIntDatas"
                                      Dense
                                      Hover
                                      FixedHeader
                                      Virtualize
                                      Elevation="0"
                                      Class="fit fixed-columns">

                                <ColGroup>
                                    <col />
                                    <col style="width:200px" />
                                    <col style="width:64px" />
                                </ColGroup>
                                <HeaderContent>
                                    <MudTh>@AppText.Get("Name")</MudTh>
                                    <MudTh>@AppText.Get("Value")</MudTh>
                                    <MudTh />
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd Class="selectable-text text-truncate"
                                           title="@context.Name">
                                        <MudHighlighter Text="@context.Name"
                                                        HighlightedText="@_namedIntFilter" />
                                    </MudTd>
                                    <MudTd>
                                        <GenericSettingEditor Setting="context"
                                                              Changed="@GameState.IsChanged(context)" />
                                    </MudTd>
                                    <MudTd Style="text-align:right">
                                        @* Clear Value *@
                                        @if (context.IntValue is not null)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Rounded.Backspace"
                                                           title="@AppText.Get("ClearValue")"
                                                           aria-label="@AppText.Get("ClearValue")"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           OnClick="() => context.IntValue = null" />
                                        }
                                    </MudTd>
                                </RowTemplate>
                                <NoRecordsContent>
                                    <MudText Typo="Typo.body2"
                                             Class="mud-text-secondary">
                                        @AppText.Get("NothingFound")
                                    </MudText>
                                </NoRecordsContent>

                            </MudTable>
                        </MudPaper>
                    </Header>
                </MudElement>

            </MudStack>
        </MudTabPanel>

        @* Weather Tab *@
        <MudTabPanel Text="@AppText.Get("WeatherState")"
                     Icon="@Icons.Material.Rounded.WbSunny"
                     IconColor="Color.Tertiary">
            <MudStack Spacing="6">
                @if (Calendar is { } calendar)
                {
                    var loaded = LoadedCalendar ?? calendar;
                    var marks = MarksOf(calendar, loaded);
                    @* Season Panel *@
                    <MudPaper Elevation="4"
                              Class="rounded-panel pa-4">
                        <MudStack Spacing="2">
                            <MudStack Row
                                      AlignItems="AlignItems.Center"
                                      Wrap="Wrap.Wrap"
                                      Spacing="2">
                                <MudText Typo="Typo.subtitle1"
                                         Style="font-weight:700">
                                    @AppText.Get("Season")
                                </MudText>
                                <InfoIcon Text="@AppText.Get("SeasonInfo")" />
                                <MudSpacer />
                                <MudText Typo="Typo.body2"
                                         Class="mud-text-secondary">
                                    @AppText.Format("DaysUntilSeasonOf", SeasonName(calendar.NextSeason), calendar.DaysLeft)
                                </MudText>
                            </MudStack>
                            @* Season Bar *@
                            <MudStack Row
                                      Spacing="2">
                                @foreach (var (index, option) in s_seasons.Index())
                                {
                                    <MudStack Spacing="1"
                                              Class="@($"flex-grow-1 season-{index}")"
                                              Style="flex-basis:0;min-width:0">
                                        @* Season Marks *@
                                        <MudElement HtmlTag="div"
                                                    Class="season-marks">
                                            @foreach (var mark in marks.Where(candidate => candidate.Season == index))
                                            {
                                                <MudText Typo="Typo.caption"
                                                         Class="season-mark"
                                                         Style="@MarkStyle(mark, marks, calendar.Length)">
                                                    @mark.Label
                                                    <ChangedDot When="@mark.IsNew" />
                                                </MudText>
                                            }
                                        </MudElement>
                                        <MudElement HtmlTag="div"
                                                    Class="@(calendar.Length > MaxDayCells ? "season-days dense" : "season-days")">
                                            @for (var day = 1; day <= calendar.Length; day++)
                                            {
                                                var picked = day;
                                                var title = DayTitle(index, day);
                                                @* Season Day *@
                                                <MudElement HtmlTag="span"
                                                            Class="@DayClass(calendar, loaded, index, day)"
                                                            role="button"
                                                            tabindex="@(calendar.Length > MaxDayCells ? -1 : 0)"
                                                            title="@title"
                                                            aria-label="@title"
                                                            data-keyclick
                                                            @onclick="() => PickDay(index, picked)" />
                                            }
                                        </MudElement>
                                        <MudText Typo="Typo.caption"
                                                 Class="@(index == calendar.Season ? null : "mud-text-secondary")">
                                            @AppText.Get(option.LabelKey)
                                        </MudText>
                                    </MudStack>
                                }
                            </MudStack>
                            <MudText Typo="Typo.caption"
                                     Class="mud-text-secondary">
                                @AppText.Get("SeasonClickHint")
                            </MudText>
                        </MudStack>
                    </MudPaper>
                }
                <MudPaper Elevation="4"
                          Class="rounded-panel panel-flush">
                    <MudSimpleTable Dense
                                    Elevation="0">
                        <tbody>
                            @foreach (var setting in WeatherRows)
                            {
                                <tr>
                                    <td style="width:40%">
                                        <MudStack Row
                                                  AlignItems="AlignItems.Center"
                                                  Spacing="1">
                                            <MudText Typo="Typo.body2">@AppText.Get(TextKeys.Setting(setting.Name))</MudText>
                                            @if (InfoOf(setting.Name) is { } info)
                                            {
                                                <InfoIcon Text="@info" />
                                            }
                                        </MudStack>
                                    </td>
                                    <td>
                                        <GenericSettingEditor Setting="setting"
                                                              Changed="@Weather.IsChanged(setting)" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudPaper>
            </MudStack>
        </MudTabPanel>

    </MudTabs>
</RequiresSavegame>
