@page "/Game"
@inherits EditorPageBase

<RequiresSavegame NeedsWorld>
    <MudTabs Elevation="4"
             TabHeaderClass="mb-6"
             AlwaysShowScrollButtons
             Rounded>

        @* Setup Tab *@
        <MudTabPanel Text="@AppText.Get("GameSetup")"
                     Icon="@Icons.Material.Rounded.Tune"
                     IconColor="Color.Tertiary">
            <MudStack Spacing="6">
                <Header Title="@AppText.Get("Mode")"
                        Info="@AppText.Get("ModeInfo")">
                    <TitleContent>
                        <MudSpacer />
                        <MudText Typo="Typo.body2"
                                 Class="mud-text-secondary text-truncate"
                                 title="@AppText.Get("UidInfo")">
                            @AppText.Get("Uid") @GameSetup.Uid
                        </MudText>
                    </TitleContent>
                    <ChildContent>
                        <MudPaper Elevation="4"
                                  Class="rounded-panel pa-4">
                            <MudGrid Spacing="3">

                                @foreach (var mode in s_modes)
                                {
                                    <MudItem xs="12"
                                             sm="6"
                                             md="4"
                                             lg="2"
                                             Class="d-flex">
                                        @* Mode Card *@
                                        <MudPaper Elevation="0"
                                                  Class="@ModeClass(mode)"
                                                  role="button"
                                                  tabindex="0"
                                                  aria-pressed="@(IsMode(mode) ? "true" : "false")"
                                                  data-keyclick
                                                  @onclick="() => GameSetup.SelectedMode = mode.Value">
                                            <MudStack Spacing="1">
                                                <MudStack Row
                                                          AlignItems="AlignItems.Center"
                                                          Spacing="2">
                                                    <MudIcon Icon="@mode.Icon"
                                                             Color="@(IsMode(mode) ? Color.Info : Color.Tertiary)" />
                                                    <MudText Typo="Typo.subtitle1"
                                                             Class="flex-grow-1"
                                                             Style="font-weight:700">
                                                        @AppText.Get(mode.LabelKey)
                                                        <ChangedDot When="@IsModeChanged(mode)" />
                                                    </MudText>
                                                    @if (mode.IsPreset)
                                                    {
                                                        @* Load Preset *@
                                                        <span class="d-flex"
                                                              @onclick:stopPropagation="true">
                                                            <MudIconButton Icon="@Icons.Material.Rounded.EditNote"
                                                                           aria-label="@AppText.Get("LoadPreset")"
                                                                           title="@AppText.Get("LoadPreset")"
                                                                           Size="Size.Small"
                                                                           Class="my-n1"
                                                                           OnClick="() => LoadPresetAsync(mode.Value)" />
                                                        </span>
                                                    }
                                                </MudStack>
                                                <MudText Typo="Typo.body2"
                                                         Class="mud-text-secondary">
                                                    @AppText.Get(mode.TextKey)
                                                </MudText>
                                            </MudStack>
                                        </MudPaper>
                                    </MudItem>
                                }

                            </MudGrid>
                        </MudPaper>
                    </ChildContent>
                </Header>

                @if (IsCustom)
                {
                    @foreach (var group in s_setupGroups)
                    {
                        <Header Title="@AppText.Get(group.TitleKey)"
                                Icon="@group.Icon">
                            <TitleContent>
                                <MudSpacer />
                                @* Reset Group *@
                                <MudButton Variant="Variant.Text"
                                           Size="Size.Small"
                                           Disabled="@(!GameSetup.HasAny(KeysOf(group)))"
                                           OnClick="() => GameSetup.ResetSettings(KeysOf(group))">
                                    @AppText.Get("SetAllToDefault")
                                </MudButton>
                            </TitleContent>
                            <ChildContent>
                                <MudPaper Elevation="4"
                                          Class="rounded-panel pa-4">
                                    <MudGrid Spacing="3">

                                        @foreach (var setting in group.Selects)
                                        {
                                            <MudItem xs="12"
                                                     sm="6"
                                                     md="4"
                                                     Class="d-flex">
                                                <MudPaper Elevation="0"
                                                          Class="@SettingClass(IsSet(setting))">
                                                    <MudStack Spacing="2">
                                                        <MudStack Row
                                                                  AlignItems="AlignItems.Center"
                                                                  Spacing="1">
                                                            <MudText Typo="Typo.subtitle2"
                                                                     Class="text-truncate">
                                                                @AppText.Get(setting.LabelKey)
                                                                <ChangedDot When="@GameSetup.IsChanged(setting.Key, setting.Fallback)" />
                                                            </MudText>
                                                            <InfoIcon Text="@AppText.Get(setting.InfoKey)" />
                                                        </MudStack>
                                                        @* Setting Choices *@
                                                        <MudButtonGroup OverrideStyles="false"
                                                                        Size="Size.Small"
                                                                        Class="setting-choices">
                                                            @foreach (var option in setting.Options)
                                                            {
                                                                <MudButton Variant="Variant.Filled"
                                                                           Size="Size.Small"
                                                                           Color="@(IsPicked(setting, option) ? Color.Info : Color.Default)"
                                                                           OnClick="() => GameSetup.SetString(setting.Key, option.Value, setting.Fallback)">
                                                                    @AppText.Get(option.LabelKey)
                                                                </MudButton>
                                                            }
                                                        </MudButtonGroup>
                                                    </MudStack>
                                                </MudPaper>
                                            </MudItem>
                                        }
                                        @foreach (var toggle in group.Toggles)
                                        {
                                            <MudItem xs="12"
                                                     sm="6"
                                                     md="4"
                                                     Class="d-flex">
                                                <MudPaper Elevation="0"
                                                          Class="@(SettingClass(IsSet(toggle)) + " d-flex align-center")">
                                                    @* Setup Switch *@
                                                    <MudSwitch T="bool"
                                                               Value="GameSetup.GetBool(toggle.Key, toggle.Fallback)"
                                                               ValueChanged="value => GameSetup.SetBool(toggle.Key, value, toggle.Fallback)"
                                                               Color="Color.Info"
                                                               Class="ma-0">
                                                        @AppText.Get(toggle.LabelKey)
                                                        <ChangedDot When="@GameSetup.IsChanged(toggle.Key, toggle.Fallback)" />
                                                        <InfoIcon Text="@AppText.Get(toggle.InfoKey)" />
                                                    </MudSwitch>
                                                </MudPaper>
                                            </MudItem>
                                        }

                                    </MudGrid>
                                </MudPaper>
                            </ChildContent>
                        </Header>
                    }
                }
                else
                {
                    @* Custom Hint *@
                    <MudAlert Severity="Severity.Info"
                              Dense
                              Elevation="4"
                              Class="rounded-panel">
                        @AppText.Get("CustomHint")
                    </MudAlert>
                }
            </MudStack>
        </MudTabPanel>

        @* State Tab *@
        <MudTabPanel Text="@AppText.Get("GameState")"
                     Icon="@Icons.Material.Rounded.AccessTimeFilled"
                     IconColor="Color.Tertiary">
            <MudStack Row
                      Spacing="6"
                      Class="fill">

                <MudElement HtmlTag="div"
                            Class="main-panel fill-column">
                    <Header Title="@AppText.Get("GameState")"
                            Class="fit">
                        <MudPaper Elevation="4"
                                  Class="rounded-panel pa-4 overflow-y-auto fit">
                            <MudGrid Spacing="3">

                                @foreach (var setting in GameState.Settings)
                                {
                                    <MudItem xs="12"
                                             lg="6"
                                             Class="d-flex">
                                        <SettingCard Setting="setting"
                                                     Changed="@GameState.IsChanged(setting)"
                                                     Info="@InfoOf(setting.Name)" />
                                    </MudItem>
                                }

                            </MudGrid>
                        </MudPaper>
                    </Header>
                </MudElement>

                <MudElement HtmlTag="div"
                            Class="main-panel fill-column">
                    <Header Title="@AppText.Get("WorldObjectStates")"
                            Info="@AppText.Get("WorldObjectStatesInfo")"
                            Class="fit">
                        <MudPaper Elevation="4"
                                  Class="rounded-panel panel-flush fit fill-column">
                            @* World Object Search *@
                            <SearchField @bind-Value="_namedIntFilter"
                                         Class="mx-4 mt-4 mb-2" />
                            <MudTable T="GenericSetting"
                                      Items="FilteredNamedIntDatas"
                                      Dense
                                      Hover
                                      FixedHeader
                                      Virtualize
                                      Elevation="0"
                                      Class="fit fixed-columns">

                                <ColGroup>
                                    <col />
                                    <col style="width:200px" />
                                    <col style="width:64px" />
                                </ColGroup>
                                <HeaderContent>
                                    <MudTh>@AppText.Get("Name")</MudTh>
                                    <MudTh>@AppText.Get("Value")</MudTh>
                                    <MudTh />
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd Class="selectable-text text-truncate"
                                           title="@context.Name">
                                        <MudHighlighter Text="@context.Name"
                                                        HighlightedText="@_namedIntFilter" />
                                    </MudTd>
                                    <MudTd>
                                        <GenericSettingEditor Setting="context"
                                                              Changed="@GameState.IsChanged(context)" />
                                    </MudTd>
                                    <MudTd Style="text-align:right">
                                        @* Clear Value *@
                                        @if (context.IntValue is not null)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Rounded.Backspace"
                                                           title="@AppText.Get("ClearValue")"
                                                           aria-label="@AppText.Get("ClearValue")"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           OnClick="() => context.IntValue = null" />
                                        }
                                    </MudTd>
                                </RowTemplate>
                                <NoRecordsContent>
                                    <MudText Typo="Typo.body2"
                                             Class="mud-text-secondary">
                                        @AppText.Get("NothingFound")
                                    </MudText>
                                </NoRecordsContent>

                            </MudTable>
                        </MudPaper>
                    </Header>
                </MudElement>

            </MudStack>
        </MudTabPanel>

        @* Weather Tab *@
        <MudTabPanel Text="@AppText.Get("WeatherState")"
                     Icon="@Icons.Material.Rounded.WbSunny"
                     IconColor="Color.Tertiary">
            <MudStack Spacing="6">
                @if (Calendar is { } calendar)
                {
                    var loaded = LoadedCalendar ?? calendar;
                    var marks = MarksOf(calendar, loaded);
                    @* Season Panel *@
                    <MudPaper Elevation="4"
                              Class="rounded-panel pa-4">
                        <MudStack Spacing="2">
                            <MudStack Row
                                      AlignItems="AlignItems.Center"
                                      Wrap="Wrap.Wrap"
                                      Spacing="2">
                                <MudText Typo="Typo.subtitle1"
                                         Style="font-weight:700">
                                    @AppText.Get("Season")
                                </MudText>
                                <InfoIcon Text="@AppText.Get("SeasonInfo")" />
                                <MudSpacer />
                                <MudText Typo="Typo.body2"
                                         Class="mud-text-secondary">
                                    @AppText.Format("DaysUntilSeasonOf", SeasonName(calendar.NextSeason), calendar.DaysLeft)
                                </MudText>
                            </MudStack>
                            @* Season Bar *@
                            <MudStack Row
                                      Spacing="2">
                                @foreach (var (index, option) in s_seasons.Index())
                                {
                                    <MudStack Spacing="1"
                                              Class="@($"flex-grow-1 season-{index}")"
                                              Style="flex-basis:0;min-width:0">
                                        @* Season Marks *@
                                        <MudElement HtmlTag="div"
                                                    Class="season-marks">
                                            @foreach (var mark in marks.Where(candidate => candidate.Season == index))
                                            {
                                                <MudText Typo="Typo.caption"
                                                         Class="season-mark"
                                                         Style="@MarkStyle(mark, marks, calendar.Length)">
                                                    @mark.Label
                                                    <ChangedDot When="@mark.IsNew" />
                                                </MudText>
                                            }
                                        </MudElement>
                                        <MudElement HtmlTag="div"
                                                    Class="@(calendar.Length > MaxDayCells ? "season-days dense" : "season-days")">
                                            @for (var day = 1; day <= calendar.Length; day++)
                                            {
                                                var picked = day;
                                                var title = DayTitle(index, day);
                                                @* Season Day *@
                                                <MudElement HtmlTag="span"
                                                            Class="@DayClass(calendar, loaded, index, day)"
                                                            role="button"
                                                            tabindex="@(calendar.Length > MaxDayCells ? -1 : 0)"
                                                            title="@title"
                                                            aria-label="@title"
                                                            data-keyclick
                                                            @onclick="() => PickDay(index, picked)" />
                                            }
                                        </MudElement>
                                        <MudText Typo="Typo.caption"
                                                 Class="@(index == calendar.Season ? null : "mud-text-secondary")">
                                            @AppText.Get(option.LabelKey)
                                        </MudText>
                                    </MudStack>
                                }
                            </MudStack>
                            <MudText Typo="Typo.caption"
                                     Class="mud-text-secondary">
                                @AppText.Get("SeasonClickHint")
                            </MudText>
                        </MudStack>
                    </MudPaper>
                }
                <MudPaper Elevation="4"
                          Class="rounded-panel pa-4">
                    <MudGrid Spacing="3">

                        @foreach (var setting in WeatherRows)
                        {
                            <MudItem xs="12"
                                     sm="6"
                                     md="4"
                                     Class="d-flex">
                                <SettingCard Setting="setting"
                                             Changed="@Weather.IsChanged(setting)"
                                             Info="@InfoOf(setting.Name)" />
                            </MudItem>
                        }

                    </MudGrid>
                </MudPaper>
            </MudStack>
        </MudTabPanel>

    </MudTabs>
</RequiresSavegame>
