@page "/Game"
@inherits EditorPageBase

<RequiresSavegame NeedsWorld>
    <MudTabs Elevation="4"
             TabHeaderClass="mb-6"
             AlwaysShowScrollButtons
             Rounded>

        @* Setup Tab *@
        <MudTabPanel ToolTip="@Localizer["GameSetup"].Value"
                     Icon="@Icons.Material.Rounded.Tune"
                     IconColor="Color.Tertiary">
            <MudStack Spacing="6">
                <MudPaper Elevation="4"
                          Class="rounded-panel pa-4">
                    <MudGrid>

                        <MudItem xs="12"
                                 md="6">
                            <MudStack Row
                                      AlignItems="AlignItems.Center"
                                      Spacing="1">
                                @* Load Preset *@
                                <Tooltip Text="@Localizer["LoadPreset"]"
                                         RootClass="d-flex flex-shrink-0">
                                    <MudMenu Icon="@Icons.Material.Rounded.Tune"
                                             AriaLabel="@Localizer["LoadPreset"]"
                                             Size="Size.Small">
                                        @foreach (var mode in Presets)
                                        {
                                            <MudMenuItem OnClick="() => LoadPresetAsync(mode.Value)">@Localizer[mode.LabelKey]</MudMenuItem>
                                        }
                                    </MudMenu>
                                </Tooltip>
                                @* Game Mode *@
                                <ChangedBadge When="ModeChanged"
                                              Class="flex-grow-1">
                                    <MudSelect T="string"
                                               Variant="Variant.Outlined"
                                               @bind-Value="GameSetup.SelectedMode"
                                               Label="@Localizer["Mode"]"
                                               ToStringFunc="value => LabelOf(s_modes, value)">
                                        @foreach (var mode in s_modes)
                                        {
                                            <MudSelectItem Value="mode.Value">@Localizer[mode.LabelKey]</MudSelectItem>
                                        }
                                    </MudSelect>
                                </ChangedBadge>
                                <InfoIcon Text="@Localizer["ModeInfo"]" />
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12"
                                 md="6">
                            <MudStack Row
                                      AlignItems="AlignItems.Center"
                                      Spacing="1">
                                <MudTextField T="string"
                                              Variant="Variant.Outlined"
                                              Value="GameSetup.Uid"
                                              Label="@Localizer["Uid"]"
                                              ReadOnly />
                                <InfoIcon Text="@Localizer["UidInfo"]" />
                            </MudStack>
                        </MudItem>

                    </MudGrid>
                </MudPaper>

                @if (IsCustom)
                {
                    @foreach (var group in s_setupGroups)
                    {
                        <Header Title="@Localizer[group.TitleKey]"
                                Icon="@group.Icon">
                            <TitleContent>
                                <MudSpacer />
                                @* Reset Group *@
                                <MudButton Variant="Variant.Text"
                                           Size="Size.Small"
                                           Disabled="@(!GameSetup.HasAny(KeysOf(group)))"
                                           OnClick="() => GameSetup.ResetSettings(KeysOf(group))">
                                    @Localizer["SetAllToDefault"]
                                </MudButton>
                            </TitleContent>
                            <ChildContent>
                                <MudPaper Elevation="4"
                                          Class="rounded-panel pa-4">
                                    <MudGrid>

                                        @foreach (var setting in group.Selects)
                                        {
                                            <MudItem xs="12"
                                                     sm="6"
                                                     md="4">
                                                <MudStack Row
                                                          AlignItems="AlignItems.Center"
                                                          Spacing="1">
                                                    @* Setup Select *@
                                                    <ChangedBadge When="@GameSetup.IsChanged(setting.Key, setting.Fallback)"
                                                                  Class="flex-grow-1">
                                                        <MudSelect T="string"
                                                                   Variant="Variant.Outlined"
                                                                   Value="GameSetup.GetString(setting.Key, setting.Fallback)"
                                                                   ValueChanged="value => GameSetup.SetString(setting.Key, value, setting.Fallback)"
                                                                   Label="@Localizer[setting.LabelKey]"
                                                                   Clearable
                                                                   ToStringFunc="value => LabelOf(setting.Options, value)">
                                                            @foreach (var option in setting.Options)
                                                            {
                                                                <MudSelectItem Value="option.Value">@Localizer[option.LabelKey]</MudSelectItem>
                                                            }
                                                        </MudSelect>
                                                    </ChangedBadge>
                                                    <InfoIcon Text="@Localizer[setting.InfoKey]" />
                                                </MudStack>
                                            </MudItem>
                                        }
                                        @foreach (var toggle in group.Toggles)
                                        {
                                            <MudItem xs="12"
                                                     sm="6"
                                                     md="4"
                                                     Class="d-flex align-center">
                                                @* Setup Switch *@
                                                <MudSwitch T="bool"
                                                           Value="GameSetup.GetBool(toggle.Key, toggle.Fallback)"
                                                           ValueChanged="value => GameSetup.SetBool(toggle.Key, value, toggle.Fallback)"
                                                           Color="Color.Info">
                                                    @Localizer[toggle.LabelKey]
                                                    <ChangedDot When="@GameSetup.IsChanged(toggle.Key, toggle.Fallback)" />
                                                    <InfoIcon Text="@Localizer[toggle.InfoKey]" />
                                                </MudSwitch>
                                            </MudItem>
                                        }

                                    </MudGrid>
                                </MudPaper>
                            </ChildContent>
                        </Header>
                    }
                }
                else
                {
                    @* Custom Hint *@
                    <MudAlert Severity="Severity.Info"
                              Dense
                              Elevation="4"
                              Class="rounded-panel">
                        @Localizer["CustomHint"]
                    </MudAlert>
                }
            </MudStack>
        </MudTabPanel>

        @* State Tab *@
        <MudTabPanel ToolTip="@Localizer["GameState"].Value"
                     Icon="@Icons.Material.Rounded.AccessTimeFilled"
                     IconColor="Color.Tertiary">
            <MudGrid Class="fill">

                <MudItem xs="12"
                         md="6"
                         Class="fill-column">
                    <Header Title="@Localizer["GameState"]"
                            Class="fit">
                        <MudPaper Elevation="4"
                                  Class="rounded-panel panel-flush overflow-y-auto fit">
                            <MudSimpleTable Dense
                                            Elevation="0">
                                <tbody>
                                    @foreach (var setting in GameState.Settings)
                                    {
                                        <tr>
                                            <td style="width:40%">
                                    <MudStack Row
                                              AlignItems="AlignItems.Center"
                                              Spacing="1">
                                        <MudText Typo="Typo.body2">@Localizer[TextKeys.Setting(setting.Name)]</MudText>
                                        @if (InfoOf(setting.Name) is { } info)
                                        {
                                            <InfoIcon Text="@info" />
                                        }
                                    </MudStack>
                                </td>
                                            <td>
                                                <GenericSettingEditor Setting="setting"
                                                                      Changed="@GameState.IsChanged(setting)" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </MudPaper>
                    </Header>
                </MudItem>

                <MudItem xs="12"
                         md="6"
                         Class="fill-column">
                    <Header Title="@Localizer["WorldObjectStates"]"
                            Info="@Localizer["WorldObjectStatesInfo"]"
                            Class="fill">
                        <MudPaper Elevation="4"
                                  Class="rounded-panel panel-flush fill fill-column">
                            @* World Object Search *@
                            <SearchField @bind-Value="_namedIntFilter"
                                         Class="mx-4 mt-4 mb-2" />
                            <MudTable T="GenericSetting"
                                      Items="FilteredNamedIntDatas"
                                      Dense
                                      Hover
                                      FixedHeader
                                      Virtualize
                                      Elevation="0"
                                      Class="fill fixed-columns">

                                <ColGroup>
                                    <col />
                                    <col style="width:200px" />
                                    <col style="width:64px" />
                                </ColGroup>
                                <HeaderContent>
                                    <MudTh>@Localizer["Name"]</MudTh>
                                    <MudTh>@Localizer["Value"]</MudTh>
                                    <MudTh />
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd Class="selectable-text text-truncate"
                                           title="@context.Name">
                                        <MudHighlighter Text="@context.Name"
                                                        HighlightedText="@_namedIntFilter" />
                                    </MudTd>
                                    <MudTd>
                                        <GenericSettingEditor Setting="context"
                                                              Changed="@GameState.IsChanged(context)" />
                                    </MudTd>
                                    <MudTd Style="text-align:right">
                                        @* Clear Value *@
                                        @if (context.IntValue is not null)
                                        {
                                            <Tooltip Text="@Localizer["ClearValue"]">
                                                <MudIconButton Icon="@Icons.Material.Rounded.Backspace"
                                                               aria-label="@Localizer["ClearValue"]"
                                                               Color="Color.Error"
                                                               Size="Size.Small"
                                                               OnClick="() => context.IntValue = null" />
                                            </Tooltip>
                                        }
                                    </MudTd>
                                </RowTemplate>

                            </MudTable>
                        </MudPaper>
                    </Header>
                </MudItem>

            </MudGrid>
        </MudTabPanel>

        @* Weather Tab *@
        <MudTabPanel ToolTip="@Localizer["WeatherState"].Value"
                     Icon="@Icons.Material.Rounded.WbSunny"
                     IconColor="Color.Tertiary">
            <MudPaper Elevation="4"
                      Class="rounded-panel panel-flush">
                <MudSimpleTable Dense
                                Elevation="0">
                    <tbody>
                        @* Season Select *@
                        @if (CurrentSeason is { } season)
                        {
                            <tr>
                                <td style="width:40%">
                                    <MudText Typo="Typo.body2">@Localizer["Season"]</MudText>
                                </td>
                                <td>
                                    <ChangedBadge When="SeasonChanged"
                                                  Class="d-block">
                                        <MudSelect T="string"
                                                   Variant="Variant.Outlined"
                                                   Value="season"
                                                   ValueChanged="ChangeSeason"
                                                   ToStringFunc="value => LabelOf(s_seasons, value)"
                                                   Dense
                                                   Margin="Margin.Dense">
                                            @foreach (var option in s_seasons)
                                            {
                                                <MudSelectItem Value="option.Value">@Localizer[option.LabelKey]</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </ChangedBadge>
                                </td>
                            </tr>
                        }
                        @foreach (var setting in Weather.Settings)
                        {
                            <tr>
                                <td style="width:40%">
                                                <MudStack Row
                                                          AlignItems="AlignItems.Center"
                                                          Spacing="1">
                                                    <MudText Typo="Typo.body2">@Localizer[TextKeys.Setting(setting.Name)]</MudText>
                                                    @if (InfoOf(setting.Name) is { } info)
                                                    {
                                                        <InfoIcon Text="@info" />
                                                    }
                                                </MudStack>
                                            </td>
                                <td>
                                    <GenericSettingEditor Setting="setting"
                                                          Changed="@Weather.IsChanged(setting)" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudTabPanel>

    </MudTabs>
</RequiresSavegame>
