@page "/Player"
@inherits EditorPageBase

<RequiresSavegame>
    <MudGrid>

        <MudItem xs="12"
                 lg="6">
            <Header Title="@AppText.Get("Player")">
                <TitleContent>
                    <MudSpacer />
                    <ShowOnMapButton Position="State.Pos" />
                </TitleContent>
                <ChildContent>
                    <MudPaper Elevation="4"
                              Class="rounded-panel pa-4">
                        <MudStack Spacing="2">
                            <MudStack Row
                                      Wrap="Wrap.Wrap"
                                      Spacing="2">
                                @* Fill Bars *@
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Info"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Rounded.BatteryChargingFull"
                                           Disabled="@(!PlayerPage.CanFillAllBars)"
                                           OnClick="PlayerPage.FillAllBars">
                                    @AppText.Get("FillAllBars")
                                </MudButton>
                                @* Move To Kelvin *@
                                <MudButton Variant="Variant.Text"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Rounded.NearMe"
                                           Disabled="@(!IsInSave(FollowerPage.KelvinState))"
                                           OnClick="() => PlayerPage.MoveToFollower(FollowerPage.KelvinState)">
                                    @AppText.Get("MoveToKelvin")
                                </MudButton>
                                @* Move To Virginia *@
                                <MudButton Variant="Variant.Text"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Rounded.NearMe"
                                           Disabled="@(!IsInSave(FollowerPage.VirginiaState))"
                                           OnClick="() => PlayerPage.MoveToFollower(FollowerPage.VirginiaState)">
                                    @AppText.Get("MoveToVirginia")
                                </MudButton>
                            </MudStack>

                            <MudText Typo="Typo.body2"
                                     Class="mud-text-secondary selectable-text">
                                @($"{AppText.Get("Position")}: {State.Pos.PrintableShort} · {AppText.Get("Area")}: {State.Pos.Area.Name}")
                                <ChangedDot When="@PlayerPage.IsChanged(nameof(PlayerState.Pos))" />
                            </MudText>

                            @* Strength *@
                            <StatSlider Label="@AppText.Get("StrengthLevel")"
                                        Changed="@PlayerPage.IsChanged(nameof(PlayerState.StrengthLevel))"
                                        Value="State.StrengthLevel"
                                        ValueChanged="value => State.ChangeStrengthLevel((int)value)"
                                        Info="@AppText.Get("StrengthLevelInfo")"
                                        Min="1"
                                        Max="PlayerState.MaxStrengthLevel" />
                            @* Max Health *@
                            <StatSlider Label="@AppText.Get("MaxHealth")"
                                        Tint="@StatColors.Health"
                                        Changed="@PlayerPage.IsChanged(nameof(PlayerState.MaxHealth))"
                                        Info="@AppText.Get("MaxHealthFollowsStrength")"
                                        Value="State.MaxHealth"
                                        Max="MaxHealthCeiling"
                                        ReadOnly />
                            @* Current Health *@
                            <StatSlider Label="@AppText.Get("CurrentHealth")"
                                        Tint="@StatColors.Health"
                                        Changed="@PlayerPage.IsChanged(nameof(PlayerState.CurrentHealth))"
                                        Warning="@CurrentHealthWarning"
                                        @bind-Value="State.CurrentHealth"
                                        Min="0.1f"
                                        Max="State.MaxHealth"
                                        Step="0.1f" />
                            @* Sickness *@
                            <StatSlider Label="@AppText.Get("Sickness")"
                                        Tint="@StatColors.Sickness"
                                        Changed="@PlayerPage.IsChanged(nameof(PlayerState.Sickness))"
                                        @bind-Value="State.Sickness"
                                        Max="State.MaxHealth"
                                        Step="0.1f" />
                            @* Fullness *@
                            <StatSlider Label="@AppText.Get("Fullness")"
                                        Tint="@StatColors.Fullness"
                                        Changed="@PlayerPage.IsChanged(nameof(PlayerState.Fullness))"
                                        @bind-Value="State.Fullness" />
                            @* Hydration *@
                            <StatSlider Label="@AppText.Get("Hydration")"
                                        Tint="@StatColors.Hydration"
                                        Changed="@PlayerPage.IsChanged(nameof(PlayerState.Hydration))"
                                        @bind-Value="State.Hydration" />
                            @* Rest *@
                            <StatSlider Label="@AppText.Get("Rest")"
                                        Tint="@StatColors.Rest"
                                        Changed="@PlayerPage.IsChanged(nameof(PlayerState.Rest))"
                                        @bind-Value="State.Rest" />
                            @* Stamina *@
                            <StatSlider Label="@AppText.Get("Stamina")"
                                        Tint="@StatColors.Stamina"
                                        Changed="@PlayerPage.IsChanged(nameof(PlayerState.Stamina))"
                                        @bind-Value="State.Stamina" />
                            @* Fullness Buff *@
                            <StatSlider Label="@AppText.Get("FullnessBuff")"
                                        Tint="@StatColors.Fullness"
                                        Changed="@PlayerPage.IsChanged(nameof(PlayerState.FullnessBuff))"
                                        @bind-Value="State.FullnessBuff"
                                        Min="-100"
                                        Max="65535" />
                            @* Hydration Buff *@
                            <StatSlider Label="@AppText.Get("HydrationBuff")"
                                        Tint="@StatColors.Hydration"
                                        Changed="@PlayerPage.IsChanged(nameof(PlayerState.HydrationBuff))"
                                        @bind-Value="State.HydrationBuff"
                                        Min="-100"
                                        Max="65535" />
                            @* Rest Buff *@
                            <StatSlider Label="@AppText.Get("RestBuff")"
                                        Tint="@StatColors.Rest"
                                        Changed="@PlayerPage.IsChanged(nameof(PlayerState.RestBuff))"
                                        @bind-Value="State.RestBuff"
                                        Max="1"
                                        Step="0.1f" />

                            @* Outfit *@
                            <ChangedBadge When="@PlayerPage.IsChanged(nameof(PlayerState.SelectedCloth))"
                                          Class="d-block mt-2">
                                <MudSelect T="Item"
                                           Variant="Variant.Outlined"
                                           @bind-Value="State.SelectedCloth"
                                           Label="@AppText.Get("Outfit")"
                                           ToStringFunc="item => item?.Name ?? string.Empty"
                                           Dense>
                                    @foreach (var cloth in PlayerPage.AvailableClothes)
                                    {
                                        <MudSelectItem Value="cloth">@cloth.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </ChangedBadge>
                        </MudStack>
                    </MudPaper>
                </ChildContent>
            </Header>
        </MudItem>

        <MudItem xs="12"
                 lg="6">
            <Header Title="@AppText.Format("ArmorCount", ArmorPage.Armour.Count())"
                    Info="@AppText.Get("ArmorInfo")">
                <TitleContent>
                    <MudSpacer />
                    @* Default Durability *@
                    <Tooltip Text="@AppText.Get("SetAllToDefaultTooltip")"
                             Disabled="@(!ArmorPage.CanSetAllToDefault())">
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   Disabled="@(!ArmorPage.CanSetAllToDefault())"
                                   OnClick="ArmorPage.SetAllToDefault"
                                   StartIcon="@Icons.Material.Rounded.SettingsBackupRestore">
                            @AppText.Get("SetAllToDefault")
                        </MudButton>
                    </Tooltip>
                    @* Max Durability *@
                    <Tooltip Text="@AppText.Get("SetAllToMaxTooltip")"
                             Disabled="@(!ArmorPage.CanSetAllToMax())">
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   Disabled="@(!ArmorPage.CanSetAllToMax())"
                                   OnClick="ArmorPage.SetAllToMax"
                                   StartIcon="@Icons.Material.Rounded.KeyboardDoubleArrowUp">
                            @AppText.Get("SetAllToMax")
                        </MudButton>
                    </Tooltip>
                </TitleContent>
                <ChildContent>
                    <MudPaper Elevation="4"
                              Class="rounded-panel pa-4">
                        <MudStack Spacing="2">
                            <MudStack Row
                                      AlignItems="AlignItems.Center"
                                      Spacing="2">
                                <MudText Typo="Typo.subtitle2">@AppText.Get("ArmourWorn")</MudText>
                                <MudSpacer />
                                @* Add Piece *@
                                <Tooltip Text="@AppText.Get("AddArmour")"
                                         Disabled="@(!CanAddPiece)"
                                         RootClass="d-flex">
                                    <MudIconButton Icon="@Icons.Material.Rounded.Add"
                                                   aria-label="@AppText.Get("AddArmour")"
                                                   Size="Size.Small"
                                                   Disabled="@(!CanAddPiece)"
                                                   OnClick="() => ArmorPage.AddPiece(ArmorPage.ArmourTypes.FirstOrDefault())" />
                                </Tooltip>
                            </MudStack>
                            @foreach (var (index, armour) in ArmorPage.Armour.Index())
                            {
                                <MudStack Row
                                          AlignItems="AlignItems.Center"
                                          Spacing="2"
                                          Class="hover-host pa-1">
                                    @* Armour Type *@
                                    <ArmourSelect Value="armour.Item"
                                                  ValueChanged="armour.ChangeType"
                                                  Types="ArmorPage.ArmourTypes"
                                                  Label="@(index == 0 ? AppText.Get("Type") : null)"
                                                  Changed="@ArmorPage.IsTypeChanged(armour)" />
                                    <MudSpacer />
                                    @* Durability *@
                                    <ChangedBadge When="@ArmorPage.IsDurabilityChanged(armour)"
                                                  Class="flex-shrink-0">
                                        <NumberField T="float"
                                                     @bind-Value="armour.ArmourPiece.RemainingArmourpoints"
                                                     Min="armour.MinDurability"
                                                     Max="armour.MaxDurability"
                                                     Margin="Margin.Dense"
                                                     Label="@(index == 0 ? AppText.Get("Durability") : null)"
                                                     Style="width:120px" />
                                    </ChangedBadge>
                                    @* Default Button *@
                                    <Tooltip Text="@AppText.Format("SetToDefaultDurabilityOf", armour.DefaultDurability)"
                                             Disabled="@IsDefault(armour)">
                                        <MudIconButton Icon="@Icons.Material.Rounded.SettingsBackupRestore"
                                                       aria-label="@AppText.Get("SetToDefaultDurability")"
                                                       Size="Size.Small"
                                                       Class="hover-action"
                                                       Disabled="@IsDefault(armour)"
                                                       OnClick="() => armour.ArmourPiece.RemainingArmourpoints = armour.DefaultDurability" />
                                    </Tooltip>
                                    @* Max Button *@
                                    <Tooltip Text="@AppText.Format("SetToMaxOf", armour.MaxDurability)"
                                             Disabled="@(armour.ArmourPiece.RemainingArmourpoints >= armour.MaxDurability)">
                                        <MudIconButton Icon="@Icons.Material.Rounded.KeyboardDoubleArrowUp"
                                                       aria-label="@AppText.Get("SetToMax")"
                                                       Size="Size.Small"
                                                       Class="hover-action"
                                                       Disabled="@(armour.ArmourPiece.RemainingArmourpoints >= armour.MaxDurability)"
                                                       OnClick="() => armour.ArmourPiece.RemainingArmourpoints = armour.MaxDurability" />
                                    </Tooltip>
                                    @* Unequip Button *@
                                    <Tooltip Text="@UnequipText(armour)">
                                        <MudIconButton Icon="@Icons.Material.Rounded.Backpack"
                                                       aria-label="@AppText.Get("Unequip")"
                                                       Size="Size.Small"
                                                       Class="hover-action"
                                                       Disabled="@(!ArmorPage.CanMoveToInventory(armour))"
                                                       OnClick="() => ArmorPage.MoveToInventory(armour)" />
                                    </Tooltip>
                                    @* Delete Button *@
                                    <Tooltip Text="@AppText.Get("DeleteArmour")">
                                        <MudIconButton Icon="@Icons.Material.Rounded.Delete"
                                                       aria-label="@AppText.Get("DeleteArmour")"
                                                       Size="Size.Small"
                                                       Class="hover-action danger-hover"
                                                       OnClick="() => DeleteArmourAsync(armour)" />
                                    </Tooltip>
                                </MudStack>
                            }

                            @if (ArmorPage.InventoryArmour.Any())
                            {
                                <MudDivider Class="my-2" />
                                <MudText Typo="Typo.subtitle2">@AppText.Get("ArmourInInventory")</MudText>
                                @foreach (var item in ArmorPage.InventoryArmour)
                                {
                                    <MudStack Row
                                              AlignItems="AlignItems.Center"
                                              Spacing="2"
                                              Class="@(InventoryPage.IsHeld(item) ? "hover-host pa-1" : "hover-host pa-1 not-held")">
                                        @* Inventory Armour Type *@
                                        <ArmourSelect Value="item.Item"
                                                      ValueChanged="type => ArmorPage.ChangeType(item, type)"
                                                      Types="ArmorPage.TypesFor(item)"
                                                      Disabled="@(!InventoryPage.IsHeld(item))" />
                                        <MudText Typo="Typo.body2"
                                                 Class="mud-text-secondary">
                                            @AppText.Format("InInventoryCount", InventoryPage.IsHeld(item) ? item.TotalCount : 0)
                                            <ChangedDot When="@InventoryPage.IsChanged(item)" />
                                        </MudText>
                                        <MudSpacer />
                                        @* Wear Button *@
                                        <Tooltip Text="@WearText(item)">
                                            <MudIconButton Icon="@Icons.Material.Rounded.Shield"
                                                           aria-label="@AppText.Get("WearArmour")"
                                                           Size="Size.Small"
                                                           Class="hover-action"
                                                           Disabled="@(!ArmorPage.CanWear(item))"
                                                           OnClick="() => ArmorPage.Wear(item)" />
                                        </Tooltip>
                                        @* Delete Button *@
                                        <Tooltip Text="@AppText.Get("DeleteArmour")"
                                                 Disabled="@(!InventoryPage.IsHeld(item))">
                                            <MudIconButton Icon="@Icons.Material.Rounded.Delete"
                                                           aria-label="@AppText.Get("DeleteArmour")"
                                                           Size="Size.Small"
                                                           Class="hover-action danger-hover"
                                                           Disabled="@(!InventoryPage.IsHeld(item))"
                                                           OnClick="() => DeleteFromInventoryAsync(item)" />
                                        </Tooltip>
                                    </MudStack>
                                }
                            }
                        </MudStack>
                    </MudPaper>
                </ChildContent>
            </Header>
        </MudItem>

    </MudGrid>
</RequiresSavegame>
