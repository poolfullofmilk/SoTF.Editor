@page "/Player"
@inherits EditorPageBase

<RequiresSavegame>
    <MudGrid>

        <MudItem xs="12"
                 lg="6">
            <Header Title="@Localizer["Player"]">
                <TitleContent>
                    <MudSpacer />
                    <ShowOnMapButton Position="State.Pos" />
                </TitleContent>
                <ChildContent>
                    <MudPaper Elevation="4"
                              Class="rounded-panel pa-4">
                        <MudStack Spacing="2">
                            <MudStack Row
                                      Wrap="Wrap.Wrap"
                                      Spacing="2">
                                @* Fill Bars *@
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Info"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Rounded.BatteryChargingFull"
                                           OnClick="PlayerPage.FillAllBars">
                                    @Localizer["FillAllBars"]
                                </MudButton>
                                @* Move To Kelvin *@
                                <MudButton Variant="Variant.Text"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Rounded.NearMe"
                                           Disabled="@(!IsInSave(FollowerPage.KelvinState))"
                                           OnClick="() => PlayerPage.MoveToFollower(FollowerPage.KelvinState)">
                                    @Localizer["MoveToKelvin"]
                                </MudButton>
                                @* Move To Virginia *@
                                <MudButton Variant="Variant.Text"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Rounded.NearMe"
                                           Disabled="@(!IsInSave(FollowerPage.VirginiaState))"
                                           OnClick="() => PlayerPage.MoveToFollower(FollowerPage.VirginiaState)">
                                    @Localizer["MoveToVirginia"]
                                </MudButton>
                            </MudStack>

                            <MudText Typo="Typo.body2"
                                     Class="mud-text-secondary selectable-text">
                                @($"{Localizer["Position"]}: {State.Pos.PrintableShort} · {Localizer["Area"]}: {State.Pos.Area.Name}")
                                <ChangedDot When="@PlayerPage.IsChanged(nameof(PlayerState.Pos))" />
                            </MudText>

                            @* Strength *@
                            <StatSlider Label="@Localizer["StrengthLevel"]"
                                        Changed="@PlayerPage.IsChanged(nameof(PlayerState.StrengthLevel))"
                                        Value="State.StrengthLevel"
                                        ValueChanged="value => State.ChangeStrengthLevel((int)value)"
                                        Info="@Localizer["StrengthLevelInfo"]"
                                        Min="1"
                                        Max="100" />
                            @* Max Health *@
                            <StatSlider Label="@Localizer["MaxHealth"]"
                                        Changed="@PlayerPage.IsChanged(nameof(PlayerState.MaxHealth))"
                                        Info="@Localizer["MaxHealthFollowsStrength"]"
                                        Value="State.MaxHealth"
                                        Max="MaxHealthCeiling"
                                        ReadOnly />
                            @* Current Health *@
                            <StatSlider Label="@Localizer["CurrentHealth"]"
                                        Changed="@PlayerPage.IsChanged(nameof(PlayerState.CurrentHealth))"
                                        Warning="@CurrentHealthWarning"
                                        @bind-Value="State.CurrentHealth"
                                        Min="0.1f"
                                        Max="State.MaxHealth"
                                        Step="0.1f" />
                            @* Sickness *@
                            <StatSlider Label="@Localizer["Sickness"]"
                                        Changed="@PlayerPage.IsChanged(nameof(PlayerState.Sickness))"
                                        @bind-Value="State.Sickness"
                                        Max="State.MaxHealth"
                                        Step="0.1f" />
                            @* Fullness *@
                            <StatSlider Label="@Localizer["Fullness"]"
                                        Changed="@PlayerPage.IsChanged(nameof(PlayerState.Fullness))"
                                        @bind-Value="State.Fullness" />
                            @* Hydration *@
                            <StatSlider Label="@Localizer["Hydration"]"
                                        Changed="@PlayerPage.IsChanged(nameof(PlayerState.Hydration))"
                                        @bind-Value="State.Hydration" />
                            @* Rest *@
                            <StatSlider Label="@Localizer["Rest"]"
                                        Changed="@PlayerPage.IsChanged(nameof(PlayerState.Rest))"
                                        @bind-Value="State.Rest" />
                            @* Stamina *@
                            <StatSlider Label="@Localizer["Stamina"]"
                                        Changed="@PlayerPage.IsChanged(nameof(PlayerState.Stamina))"
                                        @bind-Value="State.Stamina" />
                            @* Fullness Buff *@
                            <StatSlider Label="@Localizer["FullnessBuff"]"
                                        Changed="@PlayerPage.IsChanged(nameof(PlayerState.FullnessBuff))"
                                        @bind-Value="State.FullnessBuff"
                                        Min="-100"
                                        Max="65535" />
                            @* Hydration Buff *@
                            <StatSlider Label="@Localizer["HydrationBuff"]"
                                        Changed="@PlayerPage.IsChanged(nameof(PlayerState.HydrationBuff))"
                                        @bind-Value="State.HydrationBuff"
                                        Min="-100"
                                        Max="65535" />
                            @* Rest Buff *@
                            <StatSlider Label="@Localizer["RestBuff"]"
                                        Changed="@PlayerPage.IsChanged(nameof(PlayerState.RestBuff))"
                                        @bind-Value="State.RestBuff"
                                        Max="1"
                                        Step="0.1f" />

                            @* Outfit *@
                            <ChangedBadge When="@PlayerPage.IsChanged(nameof(PlayerState.SelectedCloth))"
                                          Class="d-block mt-2">
                                <MudSelect T="Item"
                                           Variant="Variant.Outlined"
                                           @bind-Value="State.SelectedCloth"
                                           Label="@Localizer["Outfit"]"
                                           ToStringFunc="item => item?.Name ?? string.Empty">
                                    @foreach (var cloth in PlayerPage.AvailableClothes)
                                    {
                                        <MudSelectItem Value="cloth">@cloth.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </ChangedBadge>
                        </MudStack>
                    </MudPaper>
                </ChildContent>
            </Header>
        </MudItem>

        <MudItem xs="12"
                 lg="6">
            <Header Title="@Localizer["EquippedArmor"]">
                <TitleContent>
                    <MudSpacer />
                    @* Default Durability *@
                    <Tooltip Text="@Localizer["SetAllToDefaultTooltip"]"
                             Disabled="@(!ArmorPage.CanSetAllToDefault())">
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   Disabled="@(!ArmorPage.CanSetAllToDefault())"
                                   OnClick="ArmorPage.SetAllToDefault">
                            @Localizer["SetAllToDefault"]
                        </MudButton>
                    </Tooltip>
                    @* Max Durability *@
                    <Tooltip Text="@Localizer["SetAllToMaxTooltip"]"
                             Disabled="@(!ArmorPage.CanSetAllToMax())">
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   Disabled="@(!ArmorPage.CanSetAllToMax())"
                                   OnClick="ArmorPage.SetAllToMax">
                            @Localizer["SetAllToMax"]
                        </MudButton>
                    </Tooltip>
                </TitleContent>
                <ChildContent>
                    <MudPaper Elevation="4"
                              Class="rounded-panel pa-4">
                        <MudStack Spacing="2">
                            @foreach (var armour in ArmorPage.Armour)
                            {
                                <MudStack Row
                                          AlignItems="AlignItems.Center"
                                          Spacing="4"
                                          Class="pa-1">
                                    <MudImage Src="@armour.ImageUrl"
                                              Alt="@armour.Name"
                                              Class="thumb rounded-thumb" />
                                    <MudStack Spacing="0"
                                              Class="flex-grow-1"
                                              Style="min-width:0">
                                        <MudText Typo="Typo.body1"
                                                 Class="text-truncate text-tight">
                                            @armour.Name
                                        </MudText>
                                        <MudText Typo="Typo.caption"
                                                 Class="mud-text-secondary">
                                            @($"{Localizer["Slot"]} {armour.Slot}")
                                        </MudText>
                                    </MudStack>
                                    @* Durability *@
                                    <ChangedBadge When="@ArmorPage.IsChanged(armour)">
                                        <NumberField T="float"
                                                     @bind-Value="armour.ArmourPiece.RemainingArmourpoints"
                                                     Min="armour.MinDurability"
                                                     Max="armour.MaxDurability"
                                                     Margin="Margin.Dense"
                                                     Label="@Localizer["Durability"]"
                                                     Style="width:140px" />
                                    </ChangedBadge>
                                    @* Default Button *@
                                    <Tooltip Text="@Localizer["SetToDefaultDurability"]"
                                             Disabled="@IsDefault(armour)">
                                        <MudIconButton Icon="@Icons.Material.Rounded.SettingsBackupRestore"
                                                       Size="Size.Small"
                                                       Disabled="@IsDefault(armour)"
                                                       OnClick="() => armour.ArmourPiece.RemainingArmourpoints = armour.DefaultDurability" />
                                    </Tooltip>
                                    @* Max Button *@
                                    <MaxButton Max="armour.MaxDurability"
                                               Disabled="@(armour.ArmourPiece.RemainingArmourpoints >= armour.MaxDurability)"
                                               OnClick="() => armour.ArmourPiece.RemainingArmourpoints = armour.MaxDurability" />
                                    @* Remove Button *@
                                    <Tooltip Text="@Localizer["Remove"]">
                                        <MudIconButton Icon="@Icons.Material.Rounded.Delete"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       OnClick="() => ArmorPage.RemoveArmour(armour)" />
                                    </Tooltip>
                                </MudStack>
                            }

                            @if (ArmorPage.HasArmorPieces())
                            {
                                <MudDivider Class="my-2" />
                            }

                            <MudStack Row
                                      AlignItems="AlignItems.Center"
                                      Wrap="Wrap.Wrap"
                                      Spacing="2">
                                @* New Armor *@
                                <MudElement HtmlTag="div"
                                            Class="fixed-width"
                                            Style="width:250px">
                                    <MudSelect T="Item"
                                               Variant="Variant.Outlined"
                                               @bind-Value="ArmorPage.NewArmour.SelectedItem"
                                               Label="@Localizer["Name"]"
                                               ToStringFunc="item => item?.Name ?? string.Empty"
                                               Margin="Margin.Dense">
                                        @foreach (var armourType in ArmorPage.ArmourTypes)
                                        {
                                            <MudSelectItem Value="armourType">
                                                <MudStack Row
                                                          Justify="Justify.SpaceBetween"
                                                          Spacing="4">
                                                    <MudText Typo="Typo.body2">@armourType.Name</MudText>
                                                    <MudText Typo="Typo.body2"
                                                             Class="mud-text-secondary">
                                                        @armourType.Durability?.Default
                                                    </MudText>
                                                </MudStack>
                                            </MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudElement>
                                @* New Durability *@
                                <NumberField T="int"
                                             @bind-Value="ArmorPage.NewArmour.RemainingArmourpoints"
                                             Min="1"
                                             Label="@Localizer["Durability"]"
                                             Margin="Margin.Dense"
                                             Style="width:140px" />
                                @* Add Armor *@
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Info"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Rounded.Add"
                                           Disabled="@(!ArmorPage.NewArmour.CanAddArmor())"
                                           OnClick="ArmorPage.NewArmour.AddArmor">
                                    @Localizer["Add"]
                                </MudButton>
                            </MudStack>
                            <MudText Typo="Typo.caption"
                                     Class="mud-text-secondary">
                                @Localizer["DurabilityTooltip"]
                            </MudText>
                        </MudStack>
                    </MudPaper>
                </ChildContent>
            </Header>
        </MudItem>

    </MudGrid>
</RequiresSavegame>
