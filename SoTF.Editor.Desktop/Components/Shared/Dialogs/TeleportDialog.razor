<MudDialog Class="dialog-page">

    <DialogContent>
        <MudStack Spacing="4">
            <MudText Typo="Typo.body2"
                     Class="text-relaxed">
                @AppText.Get("TeleportHint")
            </MudText>

            @if (_viewModel.Landing.FarHeightSourceMetres is { } metres)
            {
                @* Guessed Height Warning *@
                <MudAlert Severity="Severity.Warning"
                          Dense
                          Elevation="4"
                          Class="rounded-panel mud-warning-text">
                    @AppText.Format("HeightFromFar", Formatter.FormatDistance(metres))
                </MudAlert>
            }

            @* Teleport Section *@
            <MudPaper Elevation="0"
                      Class="inset rounded-panel pa-4">
                <MudGrid Spacing="2">

                    @foreach (var (label, value, wide) in Details)
                    {
                        <MudItem xs="@(wide ? 12 : 6)">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.caption"
                                         Class="mud-text-secondary">
                                    @label
                                </MudText>
                                <MudText Typo="Typo.body2"
                                         Class="selectable-text">
                                    @value
                                </MudText>
                            </MudStack>
                        </MudItem>
                    }

                </MudGrid>
            </MudPaper>

            @if (_viewModel.AreaChoices.Count > 0)
            {
                @* Cave Section *@
                <MudPaper Elevation="0"
                          Class="inset rounded-panel pa-4">
                    <MudStack Spacing="3">
                        <MudText Typo="Typo.subtitle2">@AppText.Get("PickCave")</MudText>
                        <MudText Typo="Typo.body2"
                                 Class="mud-text-secondary">
                            @AppText.Get("PickCaveText")
                        </MudText>
                        @* Cave Choices *@
                        <MudButtonGroup OverrideStyles="false"
                                        Size="Size.Small"
                                        Class="setting-choices">
                            @foreach (var area in _viewModel.AreaChoices)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Size="Size.Small"
                                           Color="@(IsPicked(area) ? Color.Info : Color.Default)"
                                           OnClick="() => _viewModel.PickArea(area)">
                                    @area.Name
                                </MudButton>
                            }
                        </MudButtonGroup>
                    </MudStack>
                </MudPaper>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudSpacer />
        @* Teleport Button *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   StartIcon="@Icons.Material.Rounded.NearMe"
                   Disabled="@(!_viewModel.IsAreaPicked)"
                   OnClick="Teleport">
            @AppText.Get("Teleport")
        </MudButton>
    </DialogActions>

</MudDialog>
