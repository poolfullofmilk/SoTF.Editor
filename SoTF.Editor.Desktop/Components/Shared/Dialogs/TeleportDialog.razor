<MudDialog Class="dialog-page">

    <DialogContent>
        <MudStack Spacing="4">
            <MudText Typo="Typo.body2"
                     Class="text-relaxed">
                @AppText.Get("TeleportHint")
            </MudText>

            @* Teleport Section *@
            <MudPaper Elevation="0"
                      Class="inset rounded-panel pa-4">
                <MudGrid Spacing="2">

                    @foreach (var (label, value) in Details)
                    {
                        <MudItem xs="@(label == AppText.Get("Position") ? 12 : 6)">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.caption"
                                         Class="mud-text-secondary">
                                    @label
                                </MudText>
                                <MudText Typo="Typo.body2"
                                         Class="selectable-text">
                                    @value
                                </MudText>
                            </MudStack>
                        </MudItem>
                    }

                </MudGrid>
            </MudPaper>

            @* Landing Section *@
            <MudPaper Elevation="0"
                      Class="inset rounded-panel pa-4">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.subtitle2">@AppText.Get("SpawnWhere")</MudText>
                    <LandingFields Landing="_viewModel.Landing" />
                </MudStack>
            </MudPaper>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudSpacer />
        @* Teleport Button *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   StartIcon="@Icons.Material.Rounded.NearMe"
                   OnClick="Teleport">
            @AppText.Get("Teleport")
        </MudButton>
    </DialogActions>

</MudDialog>
