<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">@Localizer["RegrowTrees"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            @* All States *@
            <MudCheckBox T="bool"
                         Value="_viewModel.VegetationStateIsAllSelected"
                         ValueChanged="value => _viewModel.VegetationStateIsAllSelected = value"
                         Color="Color.Info"
                         Label="@_viewModel.PrintAll" />
            @foreach (var state in RegrowTreesViewModel.States)
            {
                @* State *@
                <MudCheckBox T="bool"
                             Value="_viewModel.VegetationStateSelected.HasFlag(state)"
                             ValueChanged="value => Toggle(state, value)"
                             Color="Color.Info"
                             Class="ml-6"
                             Label="@_viewModel.Label(state)" />
            }
            @* Percent *@
            <MudSlider T="int"
                       @bind-Value="_viewModel.PctRegrow"
                       Min="1"
                       Max="100"
                       Color="Color.Info"
                       ValueLabel
                       Class="mt-4">
                @($"{Localizer["RegrowPercent"]}: {_viewModel.PctRegrow}%")
            </MudSlider>
        </MudStack>
    </DialogContent>
    <DialogActions>
        @* Cancel Button *@
        <MudButton OnClick="@MudDialog.Cancel">@Localizer["Cancel"]</MudButton>
        @* Regrow Button *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   StartIcon="@Icons.Material.Rounded.Forest"
                   Disabled="@(!_viewModel.CanRegrowTrees())"
                   OnClick="Regrow">
            @Localizer["RegrowTrees"]
        </MudButton>
    </DialogActions>

</MudDialog>
