<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">@AppText.Get("RegrowTrees")</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            @* State Chips *@
            <MudChipSet T="string"
                        SelectionMode="SelectionMode.MultiSelection"
                        CheckMark
                        Variant="Variant.Text"
                        SelectedColor="Color.Info">
                @foreach (var state in RegrowTreesViewModel.States)
                {
                    <MudChip T="string"
                             Value="@state.ToString()"
                             Selected="_viewModel.VegetationStateSelected.HasFlag(state)"
                             SelectedChanged="value => Toggle(state, value)">
                        @RegrowTreesViewModel.Label(state)
                        <MudElement HtmlTag="span"
                                    Class="mud-text-secondary ml-2">
                            @_viewModel.CountOf(state)
                        </MudElement>
                    </MudChip>
                }
            </MudChipSet>
            @* Percent *@
            <MudSlider T="int"
                       @bind-Value="_viewModel.PctRegrow"
                       Min="1"
                       Max="100"
                       Color="Color.Info"
                       Class="mt-4">
                @($"{AppText.Get("RegrowPercent")}: {_viewModel.PctRegrow}%")
            </MudSlider>
        </MudStack>
    </DialogContent>
    <DialogActions>
        @* Regrow Button *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   StartIcon="@Icons.Material.Rounded.Forest"
                   Disabled="@(!_viewModel.CanRegrowTrees())"
                   OnClick="Regrow">
            @AppText.Get("RegrowTrees")
        </MudButton>
    </DialogActions>

</MudDialog>
