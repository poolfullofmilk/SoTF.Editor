<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">@AppText.Get("RegrowTrees")</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudStack Row
                      AlignItems="AlignItems.Center">
                @* All States *@
                <MudCheckBox T="bool"
                             Value="_viewModel.VegetationStateIsAllSelected"
                             ValueChanged="value => _viewModel.VegetationStateIsAllSelected = value"
                             Color="Color.Info"
                             Label="@AppText.Get("All")" />
                <MudSpacer />
                <MudText Typo="Typo.body2"
                         Class="mud-text-secondary">
                    @_viewModel.AllCount
                </MudText>
            </MudStack>
            @foreach (var state in RegrowTreesViewModel.States)
            {
                <MudStack Row
                          AlignItems="AlignItems.Center"
                          Class="ml-6">
                    @* State *@
                    <MudCheckBox T="bool"
                                 Value="_viewModel.VegetationStateSelected.HasFlag(state)"
                                 ValueChanged="value => Toggle(state, value)"
                                 Color="Color.Info"
                                 Label="@RegrowTreesViewModel.Label(state)" />
                    <MudSpacer />
                    <MudText Typo="Typo.body2"
                             Class="mud-text-secondary">
                        @_viewModel.CountOf(state)
                    </MudText>
                </MudStack>
            }
            @* Percent *@
            <MudSlider T="int"
                       @bind-Value="_viewModel.PctRegrow"
                       Min="1"
                       Max="100"
                       Color="Color.Info"
                       Class="mt-4">
                @($"{AppText.Get("RegrowPercent")}: {_viewModel.PctRegrow}%")
            </MudSlider>
        </MudStack>
    </DialogContent>
    <DialogActions>
        @* Regrow Button *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   StartIcon="@Icons.Material.Rounded.Forest"
                   Disabled="@(!_viewModel.CanRegrowTrees())"
                   OnClick="Regrow">
            @AppText.Get("RegrowTrees")
        </MudButton>
    </DialogActions>

</MudDialog>
