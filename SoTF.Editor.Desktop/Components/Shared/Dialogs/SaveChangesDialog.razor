<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">@AppText.Get(Revert ? "RevertPage" : "SaveChangesTitle")</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.body2"
                     Class="mud-text-secondary">
                @(Revert ? AppText.Format("RevertPageText", AppText.Get(Pages[0].LabelKey)) : AppText.Get("SaveChangesText"))
            </MudText>
            @foreach (var link in Pages)
            {
                <ChangeList Icon="@link.Icon"
                            Label="@AppText.Get(link.LabelKey)"
                            Changes="_changes[link.Href]" />
            }
            @if (!Revert)
            {
                <MudText Typo="Typo.caption"
                         Class="mud-text-secondary text-relaxed">
                    @AppText.Get("SaveChangesBackup")
                </MudText>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @if (_gameRunning && !Revert)
        {
            <MudText Typo="Typo.caption"
                     Color="Color.Warning"
                     Class="px-2">
                @AppText.Get("GameRunningWarning")
            </MudText>
        }
        <MudSpacer />
        @* Save Or Revert Button *@
        <MudButton Variant="Variant.Filled"
                   Color="@(Revert ? Color.Error : Color.Info)"
                   StartIcon="@(Revert ? Icons.Material.Rounded.Undo : Icons.Material.Rounded.Save)"
                   OnClick="Save">
            @AppText.Get(Revert ? "Revert" : "Save")
        </MudButton>
    </DialogActions>

</MudDialog>
