<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">@AppText.Get("Unlocks")</MudText>
    </TitleContent>
    <DialogContent>
        @if (_viewModel is null)
        {
            <EmptyState Icon="@Icons.Material.Rounded.PersonOff"
                        Text="@AppText.Format("PlayerProfileNotFound", SavegameManager.GetSavePath())" />
        }
        else
        {
            <MudStack Spacing="2">
                @foreach (var (key, labelKey) in UnlocksViewModel.Settings)
                {
                    @* Unlock Switch *@
                    <MudSwitch T="bool"
                               @bind-Value="_viewModel.Values[key]"
                               Color="Color.Info"
                               Label="@AppText.Get(labelKey)" />
                }
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        @* Save Button *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   Disabled="@(_viewModel?.HasChanges != true)"
                   OnClick="Save">
            @AppText.Get("Save")
        </MudButton>
    </DialogActions>

</MudDialog>
