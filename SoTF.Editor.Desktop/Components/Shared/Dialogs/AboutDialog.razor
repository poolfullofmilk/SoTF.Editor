<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">@AppText.Get("About")</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="4">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h5">@AppInfo.DisplayName</MudText>
                <MudText Typo="Typo.body2"
                         Class="mud-text-secondary">
                    @($"{AppText.Get("Version")} {AppInfo.VersionText} · {AppInfo.Author}")
                </MudText>
            </MudStack>
            <MudText Typo="Typo.body1"
                     Class="text-relaxed">
                @AppText.Get("AboutText")
            </MudText>
            <MudStack Row
                      Wrap="Wrap.Wrap"
                      Spacing="2">
                @* Project Link *@
                <MudButton Variant="Variant.Filled"
                           Color="Color.Info"
                           Size="Size.Small"
                           StartIcon="@Icons.Custom.Brands.GitHub"
                           Href="@AppInfo.RepositoryUrl">
                    @AppText.Get("GitHubProject")
                </MudButton>
            </MudStack>
            <MudStack Spacing="0">
                <MudText Typo="Typo.caption"
                         Class="mud-text-secondary">
                    @AppText.Get("Disclaimer")
                </MudText>
                @* Notices Link *@
                <MudLink Typo="Typo.caption"
                         Color="Color.Default"
                         Href="@AppInfo.NoticesUrl">
                    @AppText.Get("MapDataNotice")
                </MudLink>
            </MudStack>
        </MudStack>
    </DialogContent>

</MudDialog>
