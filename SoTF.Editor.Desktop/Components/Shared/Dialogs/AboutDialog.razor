<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">@Localizer["About"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="4">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h5">@AppInfo.DisplayName</MudText>
                <MudText Typo="Typo.body2"
                         Class="mud-text-secondary">
                    @($"{Localizer["Version"]} {AppInfo.Version.ToString(2)} · {AppInfo.Author}")
                </MudText>
            </MudStack>
            <MudText Typo="Typo.body1"
                     Class="text-relaxed">
                @Localizer["AboutText"]
            </MudText>
            <MudStack Row
                      Wrap="Wrap.Wrap"
                      Spacing="2">
                @* Project Link *@
                <MudButton Variant="Variant.Filled"
                           Color="Color.Info"
                           Size="Size.Small"
                           StartIcon="@Icons.Custom.Brands.GitHub"
                           Href="@AppInfo.RepositoryUrl">
                    @Localizer["GitHubProject"]
                </MudButton>
            </MudStack>
            <MudStack Spacing="0">
                <MudText Typo="Typo.caption"
                         Class="mud-text-secondary">
                    @Localizer["Disclaimer"]
                </MudText>
                @* Notices Link *@
                <MudLink Typo="Typo.caption"
                         Color="Color.Default"
                         Href="@AppInfo.NoticesUrl">
                    @Localizer["MapDataNotice"]
                </MudLink>
            </MudStack>
        </MudStack>
    </DialogContent>
    <DialogActions>
        @* Close Button *@
        <MudButton OnClick="Close">@Localizer["Close"]</MudButton>
    </DialogActions>

</MudDialog>
