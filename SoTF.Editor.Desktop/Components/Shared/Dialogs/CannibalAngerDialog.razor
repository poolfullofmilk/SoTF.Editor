<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">@Localizer["CannibalAnger"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.body2"
                     Class="mud-text-secondary">
                @Localizer["CannibalAngerText"]
            </MudText>
            @* Anger Level *@
            <MudSlider T="int"
                       @bind-Value="_level"
                       Min="0"
                       Max="100"
                       Step="10"
                       Color="Color.Info"
                       ValueLabel
                       Class="mt-4">
                @($"{Localizer["AngerLevel"]}: {_level}%")
            </MudSlider>
        </MudStack>
    </DialogContent>
    <DialogActions>
        @* Apply Button *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   OnClick="Apply">
            @Localizer["Apply"]
        </MudButton>
    </DialogActions>

</MudDialog>
