<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">@AppText.Get("CannibalAnger")</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.body2"
                     Class="mud-text-secondary">
                @AppText.Get("CannibalAngerText")
            </MudText>
            @* Anger Level *@
            <MudSlider T="int"
                       @bind-Value="_level"
                       Min="0"
                       Max="100"
                       Step="10"
                       Color="Color.Info"
                       Class="mt-4">
                @($"{AppText.Get("AngerLevel")}: {_level}%")
            </MudSlider>
            @if (_mood is not null)
            {
                <MudText Typo="Typo.caption"
                         Class="mud-text-secondary">
                    @AppText.Format("CannibalAngerNow", _mood.Average)
                </MudText>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @* Apply Button *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   Disabled="@(_mood?.Changes(_level) != true)"
                   OnClick="Apply">
            @AppText.Get("Apply")
        </MudButton>
    </DialogActions>

</MudDialog>
