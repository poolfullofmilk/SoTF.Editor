<MudDialog>

    <DialogContent>
        <MudStack Spacing="4">
            <MudAlert Severity="Severity.Warning"
                      Dense
                      Elevation="4"
                      Class="rounded-panel">
                @AppText.Get("ChangeTypeWarning")
            </MudAlert>
            @* Structure Type *@
            <MudSelect T="ScrewStructure"
                       Variant="Variant.Outlined"
                       @bind-Value="_selected"
                       Label="@AppText.Get("StructureType")"
                       ToStringFunc="StructureName"
                       Dense>
                @foreach (var structure in EditableTypes)
                {
                    <MudSelectItem Value="structure">@StructureName(structure)</MudSelectItem>
                }
            </MudSelect>
        </MudStack>
    </DialogContent>
    <DialogActions>
        @* Apply Button *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   Disabled="@(_selected is null)"
                   OnClick="Ok">
            @AppText.Get("Apply")
        </MudButton>
    </DialogActions>

</MudDialog>
