<MudDialog>

    <DialogContent>
        <MudStack Spacing="4">
            <MudText Typo="Typo.body2"
                     Class="text-relaxed">
                @Localizer["ChangeTypeWarning"]
            </MudText>
            @* Structure Type *@
            <MudSelect T="ScrewStructure"
                       Variant="Variant.Outlined"
                       @bind-Value="_selected"
                       Label="@Localizer["StructureType"]"
                       ToStringFunc="StructureName"
                       Dense>
                @foreach (var structure in EditableTypes)
                {
                    <MudSelectItem Value="structure">@StructureName(structure)</MudSelectItem>
                }
            </MudSelect>
        </MudStack>
    </DialogContent>
    <DialogActions>
        @* Apply Button *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   Disabled="@(_selected is null)"
                   OnClick="Ok">
            @Localizer["Apply"]
        </MudButton>
    </DialogActions>

</MudDialog>
