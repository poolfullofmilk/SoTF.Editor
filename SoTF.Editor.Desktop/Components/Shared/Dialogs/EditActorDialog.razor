<MudDialog Class="dialog-page">

    <TitleContent>
        <MudText Typo="Typo.h6">@_viewModel.Actor.PrintableTitle</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>

            <MudItem xs="12"
                     md="6">
                <MudStack Spacing="4">

                    @* Details Section *@
                    <MudPaper Elevation="0"
                              Class="inset rounded-panel pa-4">
                        <MudStack Row
                                  AlignItems="AlignItems.Start"
                                  Spacing="4">
                            <MudImage Src="@_viewModel.Actor.ImageUrl"
                                      Alt="@_viewModel.Actor.ActorType?.Name"
                                      Width="120"
                                      Class="rounded-inner flex-shrink-0" />
                            <MudGrid Spacing="2"
                                     Class="flex-grow-1">

                                @foreach (var detail in Details)
                                {
                                    <MudItem xs="@(detail.Label == AppText.Get("Position") ? 12 : 6)">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.caption"
                                                     Class="mud-text-secondary">
                                                @detail.Label
                                            </MudText>
                                            <MudText Typo="Typo.body2"
                                                     Class="selectable-text">
                                                @(string.IsNullOrEmpty(detail.Value) ? "-" : detail.Value)
                                            </MudText>
                                        </MudStack>
                                    </MudItem>
                                }

                            </MudGrid>
                        </MudStack>
                    </MudPaper>

                    @* Apply To Section *@
                    <MudPaper Elevation="0"
                              Class="inset rounded-panel pa-4">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle2">@AppText.Get("ApplyTo")</MudText>
                            @* Apply To Buttons *@
                            <MudButtonGroup Variant="Variant.Filled"
                                            Size="Size.Small"
                                            OverrideStyles="false"
                                            Class="align-self-start">
                                @foreach (var selection in s_selections)
                                {
                                    @* Apply To Button *@
                                    <MudButton Variant="Variant.Filled"
                                               Color="@(_viewModel.ActorSelection == selection.Value ? Color.Info : Color.Default)"
                                               Size="Size.Small"
                                               Disabled="@(selection.Value == 1 && !_viewModel.HasFamily)"
                                               OnClick="() => Select(selection.Value)">
                                        @AppText.Get(selection.LabelKey)
                                        @if (selection.Value != 0)
                                        {
                                            <MudElement HtmlTag="span"
                                                        Class="mud-text-secondary ml-2">
                                                @CountFor(selection.Value)
                                            </MudElement>
                                        }
                                    </MudButton>
                                }
                            </MudButtonGroup>
                            @if (ShowsSameArea || ShowsSkipFollowers)
                            {
                                <MudStack Row
                                          Wrap="Wrap.Wrap"
                                          Spacing="0">
                                    @if (ShowsSameArea)
                                    {
                                        @* Same Area *@
                                        <MudCheckBox T="bool"
                                                     @bind-Value="_viewModel.OnlyInSameAreaAsActor"
                                                     Color="Color.Info"
                                                     Dense
                                                     Label="@AppText.Get("OnlySameArea")" />
                                    }
                                    @if (ShowsSkipFollowers)
                                    {
                                        @* Skip Followers *@
                                        <MudCheckBox T="bool"
                                                     @bind-Value="_viewModel.SkipFollowers"
                                                     Color="Color.Info"
                                                     Dense
                                                     Label="@AppText.Get("SkipFollowers")" />
                                    }
                                </MudStack>
                            }
                        </MudStack>
                    </MudPaper>

                    @* Teleport Section *@
                    <MudPaper Elevation="0"
                              Class="inset rounded-panel pa-4">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle2">@AppText.Get("Teleport")</MudText>
                            @* Teleport Buttons *@
                            <MudButtonGroup Variant="Variant.Filled"
                                            Size="Size.Small"
                                            OverrideStyles="false"
                                            Class="align-self-start">
                                @foreach (var teleport in s_teleports)
                                {
                                    @* Teleport Button *@
                                    <MudButton Variant="Variant.Filled"
                                               Color="@(_viewModel.ModifyOptions.TeleportMode == teleport.Mode ? Color.Info : Color.Default)"
                                               Size="Size.Small"
                                               OnClick="() => _viewModel.ModifyOptions.TeleportMode = teleport.Mode">
                                        @AppText.Get(teleport.LabelKey)
                                    </MudButton>
                                }
                            </MudButtonGroup>
                            @if (_viewModel.ModifyOptions.TeleportMode == "NpcToPlayer" && MatchCount > 1)
                            {
                                <MudText Typo="Typo.caption"
                                         Color="Color.Warning">
                                    @AppText.Get("TeleportManyWarning")
                                </MudText>
                            }
                        </MudStack>
                    </MudPaper>

                </MudStack>
            </MudItem>

            <MudItem xs="12"
                     md="6">
                <MudStack Spacing="4">

                    @* Changes Section *@
                    <MudPaper Elevation="0"
                              Class="inset rounded-panel pa-4">
                        <MudStack Spacing="3">
                            <MudText Typo="Typo.subtitle2">@AppText.Get("Changes")</MudText>
                            <MudStack Row
                                      Spacing="2">
                                @* Health *@
                                <ChangedBadge When="@_viewModel.ModifyOptions.UpdateHealth"
                                              Class="flex-grow-1">
                                    <NumberField T="float"
                                                 @bind-Value="_viewModel.ModifyOptions.ActorHealth"
                                                 Label="@AppText.Get("Health")"
                                                 Min="0" />
                                </ChangedBadge>
                                @* Energy *@
                                <ChangedBadge When="@_viewModel.ModifyOptions.UpdateEnergy"
                                              Class="flex-grow-1">
                                    <NumberField T="float"
                                                 @bind-Value="_viewModel.ModifyOptions.ActorEnergy"
                                                 Label="@AppText.Get("Energy")"
                                                 Min="0"
                                                 Max="100" />
                                </ChangedBadge>
                            </MudStack>
                            @if (!_viewModel.IsFollower)
                            {
                                @* Replace Type *@
                                <MudSelect T="ActorType"
                                           Variant="Variant.Outlined"
                                           @bind-Value="_viewModel.ModifyOptions.ReplaceType"
                                           Label="@AppText.Get("ReplaceType")"
                                           ToStringFunc="type => type?.Name"
                                           Clearable
                                           Dense>
                                    @foreach (var actorType in _viewModel.AllActorTypes)
                                    {
                                        <MudSelectItem Value="actorType">@actorType.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            @if (ReachesSpawner)
                            {
                                @* Remove Spawner *@
                                <MudSwitch T="bool"
                                           @bind-Value="_viewModel.ModifyOptions.RemoveSpawner"
                                           Color="Color.Info">
                                    @AppText.Get("RemoveSpawner")
                                    <InfoIcon Text="@AppText.Get("RemoveSpawnerTooltip")" />
                                </MudSwitch>
                            }
                        </MudStack>
                    </MudPaper>

                    @* Influences *@
                    <MudStack Spacing="2">
                        <MudStack Row
                                  AlignItems="AlignItems.Center"
                                  Spacing="1">
                            <MudText Typo="Typo.subtitle2">@AppText.Get("Influences")</MudText>
                            <InfoIcon Text="@AppText.Get("InfluencesInfo")" />
                            <ChangedDot When="@_viewModel.ModifyOptions.UpdateInfluences" />
                        </MudStack>
                        <InfluencesEditor Influences="_viewModel.Influences"
                                          CanRemove
                                          OnChanged="() => _viewModel.ModifyOptions.UpdateInfluences = true" />
                    </MudStack>

                </MudStack>
            </MudItem>

        </MudGrid>
    </DialogContent>
    <DialogActions>
        @* Remove Button *@
        <Tooltip Text="@AppText.Get("GameFollowersStay")"
                 Disabled="@(!RemovesGameFollower)">
            <MudButton Variant="Variant.Text"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Rounded.Delete"
                       Disabled="@(MatchCount == 0 || RemovesGameFollower)"
                       OnClick="RemoveAsync">
                @CountLabel("Remove")
            </MudButton>
        </Tooltip>
        <MudSpacer />
        @* Apply Button *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   Disabled="@(MatchCount == 0 || !_viewModel.ModifyOptions.HasChanges)"
                   OnClick="Apply">
            @CountLabel("Apply")
        </MudButton>
    </DialogActions>

</MudDialog>
