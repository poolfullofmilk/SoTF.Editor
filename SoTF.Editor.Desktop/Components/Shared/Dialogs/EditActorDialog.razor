<MudDialog Class="dialog-page">

    <TitleContent>
        <MudText Typo="Typo.h6">@_viewModel.Actor.PrintableTitle</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>

            <MudItem xs="12"
                     md="6">
                <MudStack Spacing="4">

                    @* Details Section *@
                    <MudPaper Elevation="0"
                              Class="inset rounded-panel pa-4">
                        <MudStack Row
                                  AlignItems="AlignItems.Start"
                                  Spacing="4">
                            <MudImage Src="@_viewModel.Actor.ImageUrl"
                                      Alt="@_viewModel.Actor.ActorType?.Name"
                                      Width="120"
                                      Class="rounded-inner flex-shrink-0" />
                            <MudGrid Spacing="2"
                                     Class="flex-grow-1">

                                @foreach (var detail in Details)
                                {
                                    <MudItem xs="@(detail.Label == AppText.Get("Position") ? 12 : 6)">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.caption"
                                                     Class="mud-text-secondary">
                                                @detail.Label
                                            </MudText>
                                            <MudText Typo="Typo.body2"
                                                     Class="selectable-text">
                                                @(string.IsNullOrEmpty(detail.Value) ? "-" : detail.Value)
                                            </MudText>
                                        </MudStack>
                                    </MudItem>
                                }

                            </MudGrid>
                        </MudStack>
                    </MudPaper>

                    @* Influences *@
                    <MudStack Spacing="2">
                        <MudStack Row
                                  AlignItems="AlignItems.Center"
                                  Spacing="1">
                            <MudText Typo="Typo.subtitle2">@AppText.Get("Influences")</MudText>
                            <InfoIcon Text="@AppText.Get("InfluencesInfo")" />
                        </MudStack>
                        <InfluencesEditor Influences="_viewModel.Influences"
                                          CanRemove
                                          OnChanged="() => _viewModel.ModifyOptions.UpdateInfluences = true" />
                    </MudStack>

                </MudStack>
            </MudItem>

            <MudItem xs="12"
                     md="6">
                <MudStack Spacing="4">

                    @* Selection Section *@
                    <MudPaper Elevation="0"
                              Class="inset rounded-panel pa-4">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle2">@AppText.Get("Selection")</MudText>
                            @* Modification Mode *@
                            <MudRadioGroup T="ActorModificationMode"
                                           @bind-Value="_viewModel.ModificationMode">
                                <MudRadio Value="ActorModificationMode.Modify"
                                          Color="Color.Info">
                                    @AppText.Get("Modify")
                                </MudRadio>
                                <MudRadio Value="ActorModificationMode.Remove"
                                          Color="Color.Error">
                                    @AppText.Get("Remove")
                                </MudRadio>
                            </MudRadioGroup>
                            @* Actor Selection *@
                            <MudSelect T="short?"
                                       Variant="Variant.Outlined"
                                       @bind-Value="_viewModel.ActorSelection"
                                       ToStringFunc="SelectionName"
                                       Dense>
                                @foreach (var selection in EditActorViewModel.AllActorSelections)
                                {
                                    <MudSelectItem T="short?"
                                                   Value="selection.Key">
                                        @selection.Value
                                    </MudSelectItem>
                                }
                            </MudSelect>
                            <MudStack Row
                                      Wrap="Wrap.Wrap"
                                      Spacing="0">
                                @* Skip Kelvin *@
                                <MudCheckBox T="bool"
                                             @bind-Value="_viewModel.SkipKelvin"
                                             Color="Color.Info"
                                             Dense
                                             Label="@AppText.Get("SkipKelvin")" />
                                @* Skip Virginia *@
                                <MudCheckBox T="bool"
                                             @bind-Value="_viewModel.SkipVirginia"
                                             Color="Color.Info"
                                             Dense
                                             Label="@AppText.Get("SkipVirginia")" />
                                @* Same Area *@
                                <MudCheckBox T="bool"
                                             @bind-Value="_viewModel.OnlyInSameAreaAsActor"
                                             Color="Color.Info"
                                             Dense
                                             Label="@AppText.Get("OnlySameArea")" />
                            </MudStack>
                        </MudStack>
                    </MudPaper>

                    @if (_viewModel.ModificationMode == ActorModificationMode.Modify)
                    {
                        @* Stats Section *@
                        <MudPaper Elevation="0"
                                  Class="inset rounded-panel pa-4">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.subtitle2">@AppText.Get("Stats")</MudText>
                                <MudStack Row
                                          AlignItems="AlignItems.Center"
                                          Spacing="2">
                                    @* Update Energy *@
                                    <MudCheckBox T="bool"
                                                 @bind-Value="_viewModel.ModifyOptions.UpdateEnergy"
                                                 Color="Color.Info"
                                                 Dense
                                                 Label="@AppText.Get("Energy")"
                                                 Style="width:120px" />
                                    @* Energy *@
                                    <NumberField T="float"
                                                 @bind-Value="_viewModel.ModifyOptions.ActorEnergy"
                                                 Min="0"
                                                 Max="100"
                                                 Disabled="@(!_viewModel.ModifyOptions.UpdateEnergy)" />
                                </MudStack>
                                <MudStack Row
                                          AlignItems="AlignItems.Center"
                                          Spacing="2">
                                    @* Update Health *@
                                    <MudCheckBox T="bool"
                                                 @bind-Value="_viewModel.ModifyOptions.UpdateHealth"
                                                 Color="Color.Info"
                                                 Dense
                                                 Label="@AppText.Get("Health")"
                                                 Style="width:120px" />
                                    @* Health *@
                                    <NumberField T="float"
                                                 @bind-Value="_viewModel.ModifyOptions.ActorHealth"
                                                 Min="0"
                                                 Disabled="@(!_viewModel.ModifyOptions.UpdateHealth)" />
                                </MudStack>
                            </MudStack>
                        </MudPaper>

                        @* Options Section *@
                        <MudPaper Elevation="0"
                                  Class="inset rounded-panel pa-4">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.subtitle2">@AppText.Get("ModificationOptions")</MudText>
                                <MudStack Row
                                          Wrap="Wrap.Wrap"
                                          Spacing="0">
                                    @* Remove Spawner *@
                                    <Tooltip Text="@AppText.Get("RemoveSpawnerTooltip")">
                                        <MudCheckBox T="bool"
                                                     @bind-Value="_viewModel.ModifyOptions.RemoveSpawner"
                                                     Color="Color.Info"
                                                     Dense
                                                     Label="@AppText.Get("RemoveSpawner")" />
                                    </Tooltip>
                                    @* Update Influences *@
                                    <MudCheckBox T="bool"
                                                 @bind-Value="_viewModel.ModifyOptions.UpdateInfluences"
                                                 Color="Color.Info"
                                                 Dense
                                                 Label="@AppText.Get("UpdateInfluences")" />
                                </MudStack>
                                @* Replace Type *@
                                <MudSelect T="ActorType"
                                           Variant="Variant.Outlined"
                                           @bind-Value="_viewModel.ModifyOptions.ReplaceType"
                                           Label="@AppText.Get("ReplaceType")"
                                           ToStringFunc="type => type?.Name"
                                           Clearable
                                           Dense>
                                    @foreach (var actorType in _viewModel.AllActorTypes)
                                    {
                                        <MudSelectItem Value="actorType">@actorType.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudStack>
                        </MudPaper>

                        @* Teleport Section *@
                        <MudPaper Elevation="0"
                                  Class="inset rounded-panel pa-4">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.subtitle2">@AppText.Get("Teleport")</MudText>
                                @* Teleport Mode *@
                                <MudRadioGroup T="string"
                                               @bind-Value="_viewModel.ModifyOptions.TeleportMode">
                                    <MudRadio Value="@string.Empty"
                                              Color="Color.Info">
                                        @AppText.Get("None")
                                    </MudRadio>
                                    <MudRadio Value="@("PlayerToNpc")"
                                              Color="Color.Info">
                                        @AppText.Get("TeleportPlayerToNpc")
                                    </MudRadio>
                                    <MudRadio Value="@("NpcToPlayer")"
                                              Color="Color.Info">
                                        @AppText.Get("TeleportNpcToPlayer")
                                    </MudRadio>
                                </MudRadioGroup>
                                <MudText Typo="Typo.caption"
                                         Class="mud-text-secondary">
                                    @AppText.Get("TeleportManyWarning")
                                </MudText>
                            </MudStack>
                        </MudPaper>
                    }

                </MudStack>
            </MudItem>

        </MudGrid>
    </DialogContent>
    <DialogActions>
        @* Apply Button *@
        <MudButton Variant="Variant.Filled"
                   Color="@(_viewModel.ModificationMode == ActorModificationMode.Remove ? Color.Error : Color.Info)"
                   OnClick="Apply">
            @(_viewModel.ModificationMode == ActorModificationMode.Remove ? AppText.Get("Remove") : AppText.Get("Apply"))
        </MudButton>
    </DialogActions>

</MudDialog>
