<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">@AppText.Get("ItemPlater")</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="4">
            <MudText Typo="Typo.body2"
                     Class="text-relaxed">
                @AppText.Get("ItemPlaterText")
            </MudText>
            <MudAlert Severity="Severity.Warning"
                      Dense
                      Elevation="4"
                      Class="rounded-panel mud-warning-text pre-line">
                @AppText.Get("ItemPlaterWarning")
            </MudAlert>
            @foreach (var group in OptionGroups)
            {
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle2">@group.Title</MudText>
                    @* Option Chips *@
                    <MudChipSet T="string"
                                SelectionMode="SelectionMode.MultiSelection"
                                CheckMark
                                Variant="Variant.Text"
                                SelectedColor="Color.Info">
                        @foreach (var option in group.Options)
                        {
                            <MudChip T="string"
                                     Value="@option.Label"
                                     Text="@option.Label"
                                     Selected="option.Get()"
                                     SelectedChanged="option.Set" />
                        }
                    </MudChipSet>
                </MudStack>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @* Remove Plating *@
        <MudButton Color="Color.Error"
                   Disabled="@(!_viewModel.CanModifyPlating())"
                   OnClick="() => ApplyAsync(_viewModel.RemovePlating)">
            @AppText.Get("RemovePlating")
        </MudButton>
        <MudSpacer />
        @* Add Plating *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   StartIcon="@Icons.Material.Rounded.AutoAwesome"
                   Disabled="@(!_viewModel.CanModifyPlating())"
                   OnClick="() => ApplyAsync(_viewModel.AddPlating)">
            @AppText.Get("AddPlating")
        </MudButton>
    </DialogActions>

</MudDialog>
