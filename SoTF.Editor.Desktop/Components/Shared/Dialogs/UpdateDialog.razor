<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">@Localizer["UpdateAvailable", Version.ToString(2)]</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.body2"
                     Class="text-relaxed">
                @Localizer["UpdateText", AppInfo.Version.ToString(2)]
            </MudText>
            @* Check On Start *@
            <MudCheckBox T="bool"
                         Value="CheckForUpdatesOnStart"
                         ValueChanged="SetCheckForUpdatesOnStart"
                         Color="Color.Info"
                         Label="@Localizer["CheckForUpdatesOnStart"]" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        @* Later Button *@
        <MudButton OnClick="@MudDialog.Cancel">@Localizer["Later"]</MudButton>
        @* Update Button *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   StartIcon="@(_isInstalling ? null : Icons.Material.Rounded.SystemUpdateAlt)"
                   OnClick="InstallAsync">
            @if (_isInstalling)
            {
                <MudProgressCircular Color="Color.Inherit"
                                     Indeterminate
                                     Class="mr-2"
                                     Style="width:16px;height:16px" />
            }
            @(_isInstalling ? Localizer["Downloading"] : Localizer["UpdateNow"])
        </MudButton>
    </DialogActions>

</MudDialog>
