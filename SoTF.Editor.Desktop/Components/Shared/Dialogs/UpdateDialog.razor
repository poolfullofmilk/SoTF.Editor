<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">@AppText.Format("UpdateAvailable", Release.Tag.TrimStart('v'))</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.body2"
                     Class="text-relaxed">
                @AppText.Format("UpdateText", AppInfo.VersionText)
            </MudText>
            @if (_notes.Count > 0)
            {
                <MudText Typo="Typo.subtitle2">@AppText.Get("WhatChanged")</MudText>
                <MudStack Spacing="1">
                    @foreach (var note in _notes)
                    {
                        <MudStack Row
                                  AlignItems="AlignItems.Start"
                                  Spacing="2">
                            <MudIcon Icon="@Icons.Material.Rounded.CheckCircle"
                                     Color="Color.Info"
                                     Size="Size.Small" />
                            <MudText Typo="Typo.body2">@note</MudText>
                        </MudStack>
                    }
                </MudStack>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @* Update Button *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   StartIcon="@(_isInstalling ? null : Icons.Material.Rounded.SystemUpdateAlt)"
                   OnClick="InstallAsync">
            @if (_isInstalling)
            {
                <MudProgressCircular Color="Color.Inherit"
                                     Indeterminate
                                     Class="mr-2"
                                     Style="width:16px;height:16px" />
            }
            @(_isInstalling ? AppText.Get("Downloading") : AppText.Get("UpdateNow"))
        </MudButton>
    </DialogActions>

</MudDialog>
