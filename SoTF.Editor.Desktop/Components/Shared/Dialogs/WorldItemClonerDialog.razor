<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">@AppText.Get("WorldItemCloner")</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle2">@AppText.Get("WorldItem")</MudText>
            @* World Item Choices *@
            <MudButtonGroup OverrideStyles="false"
                            Size="Size.Small"
                            Class="setting-choices">
                @foreach (var worldItemType in WorldItemClonerViewModel.CloneableTypes)
                {
                    <MudButton Variant="Variant.Filled"
                               Size="Size.Small"
                               Color="@(_viewModel.SelectedWorldItemType == worldItemType ? Color.Info : Color.Default)"
                               OnClick="() => _viewModel.SelectedWorldItemType = worldItemType">
                        <MudStack Row
                                  AlignItems="AlignItems.Center"
                                  Spacing="2">
                            <MudImage Src="@WorldItemPoi.IconOf(worldItemType)"
                                      Alt="@ItemName(worldItemType)"
                                      Class="thumb thumb-small" />
                            @ItemName(worldItemType)
                        </MudStack>
                    </MudButton>
                }
            </MudButtonGroup>
            <MudText Typo="Typo.body2"
                     Class="mud-text-secondary">
                @AppText.Get("CloneAtPlayerTooltip")
            </MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        @* Remove Copies *@
        <Tooltip Text="@AppText.Get("RemoveAllCopiesTooltip")"
                 Disabled="@(!_viewModel.HasModifiableWorldItemTypeSelected())">
            <MudButton Color="Color.Error"
                       Disabled="@(!_viewModel.HasModifiableWorldItemTypeSelected())"
                       OnClick="RemoveAllAsync">
                @AppText.Get("RemoveAllCopies")
            </MudButton>
        </Tooltip>
        <MudSpacer />
        @* Clone Button *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   StartIcon="@Icons.Material.Rounded.ContentCopy"
                   Disabled="@(!_viewModel.HasModifiableWorldItemTypeSelected())"
                   OnClick="Clone">
            @AppText.Get("CloneAtPlayer")
        </MudButton>
    </DialogActions>

</MudDialog>
