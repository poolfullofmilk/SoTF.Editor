<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">@AppText.Get("WorldItemCloner")</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="4">
            @* World Item *@
            <MudSelect T="WorldItemType?"
                       Variant="Variant.Outlined"
                       @bind-Value="_viewModel.SelectedWorldItemType"
                       Label="@AppText.Get("WorldItem")">
                @foreach (var worldItemType in WorldItemClonerViewModel.CloneableTypes)
                {
                    <MudSelectItem T="WorldItemType?"
                                   Value="@worldItemType">
                        @ItemName(worldItemType)
                    </MudSelectItem>
                }
            </MudSelect>
            <MudText Typo="Typo.body2"
                     Class="mud-text-secondary">
                @AppText.Get("CloneAtPlayerTooltip")
            </MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        @* Remove Copies *@
        <Tooltip Text="@AppText.Get("RemoveAllCopiesTooltip")"
                 Disabled="@(!_viewModel.HasModifiableWorldItemTypeSelected())">
            <MudButton Color="Color.Error"
                       Disabled="@(!_viewModel.HasModifiableWorldItemTypeSelected())"
                       OnClick="RemoveAllAsync">
                @AppText.Get("RemoveAllCopies")
            </MudButton>
        </Tooltip>
        <MudSpacer />
        @* Clone Button *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   StartIcon="@Icons.Material.Rounded.ContentCopy"
                   Disabled="@(!_viewModel.HasModifiableWorldItemTypeSelected())"
                   OnClick="Clone">
            @AppText.Get("CloneAtPlayer")
        </MudButton>
    </DialogActions>

</MudDialog>
