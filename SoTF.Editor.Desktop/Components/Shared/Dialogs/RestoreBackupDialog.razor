<MudDialog ContentClass="fill-column gap-2">

    <TitleContent>
        <MudText Typo="Typo.h6">@AppText.Get("RestoreBackupTitle")</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2"
                 Class="mud-text-secondary">
            @AppText.Get("RestoreBackupText")
        </MudText>
        @* Backup List *@
        <MudElement HtmlTag="div"
                    Class="fit overflow-y-auto"
                    Style="min-height:132px">
            @foreach (var backup in Backups)
            {
                @* Backup Row *@
                <MudStack Row
                          AlignItems="AlignItems.Center"
                          Spacing="3"
                          Class="@RowClass(backup)"
                          role="button"
                          tabindex="0"
                          aria-pressed="@((_selected == backup) ? "true" : "false")"
                          data-keyclick
                          @onclick="() => SelectAsync(backup)">
                    <MudText Typo="Typo.body2">@Formatter.FormatDateTimeWithSeconds(backup.TakenAt)</MudText>
                    <MudText Typo="Typo.body2"
                             Class="mud-text-secondary">
                        @Formatter.FormatSize(backup.Size)
                    </MudText>
                    <MudSpacer />
                    <MudText Typo="Typo.body2"
                             Class="mud-text-secondary">
                        @AgeLabel(backup)
                    </MudText>
                    @* Delete Backup *@
                    <MudIconButton Icon="@Icons.Material.Rounded.Delete"
                                   title="@AppText.Get("DeleteBackup")"
                                   aria-label="@AppText.Get("DeleteBackup")"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="() => DeleteAsync(backup)" />
                </MudStack>
            }
        </MudElement>
        @if (_selected is not null)
        {
            <MudStack Spacing="4"
                      Class="inset rounded-panel pa-4 fit overflow-y-auto">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.subtitle2">@AppText.Get("SavedAfterBackup")</MudText>
                    @if (_savedChanges.Count == 0)
                    {
                        <MudText Typo="Typo.caption"
                                 Class="mud-text-secondary">
                            @AppText.Get("ChangesNotRecorded")
                        </MudText>
                    }
                    @foreach (var (page, changes) in _savedChanges)
                    {
                        <ChangeList Icon="@IconOf(page)"
                                    Label="@LabelOf(page)"
                                    Changes="changes" />
                    }
                </MudStack>
                <MudStack Spacing="2">
                    <MudText Typo="Typo.subtitle2">@AppText.Get("DiffersFromNow")</MudText>
                    @if (DifferencesText is { } text)
                    {
                        <MudText Typo="Typo.caption"
                                 Class="mud-text-secondary">
                            @text
                        </MudText>
                    }
                    @foreach (var (page, changes) in OrderedDifferences)
                    {
                        <ChangeList Icon="@IconOf(page)"
                                    Label="@LabelOf(page)"
                                    Changes="changes" />
                    }
                </MudStack>
            </MudStack>
        }
        <MudText Typo="Typo.caption"
                 Class="mud-text-secondary text-relaxed">
            @UsageText
        </MudText>
    </DialogContent>
    <DialogActions>
        @* Delete Older Button *@
        <MudButton Variant="Variant.Text"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Rounded.DeleteSweep"
                   Disabled="@(Backups.Count <= 1)"
                   OnClick="DeleteAllButNewestAsync">
            @AppText.Get("DeleteAllButNewest")
        </MudButton>
        <MudSpacer />
        @* Restore Button *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   StartIcon="@Icons.Material.Rounded.Restore"
                   Disabled="@(_selected is null || _differences is { Count: 0 })"
                   OnClick="Restore">
            @AppText.Get("Restore")
        </MudButton>
    </DialogActions>

</MudDialog>
