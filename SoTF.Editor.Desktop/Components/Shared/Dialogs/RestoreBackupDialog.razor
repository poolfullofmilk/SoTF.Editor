<MudDialog Class="dialog-page"
           ContentClass="fill-column gap-2">

    <TitleContent>
        <MudText Typo="Typo.h6">@AppText.Get("RestoreBackupTitle")</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2"
                 Class="mud-text-secondary">
            @AppText.Get(_deleting ? "DeleteBackupsText" : "RestoreBackupText")
        </MudText>
        @* Backup List *@
        <MudPaper Elevation="0"
                  Class="inset rounded-panel panel-flush overflow-y-auto fit"
                  Style="@ListStyle">
            @foreach (var backup in Backups)
            {
                @* Backup Row *@
                <MudElement HtmlTag="div"
                            Class="@RowClass(backup)"
                            role="button"
                            tabindex="0"
                            aria-pressed="@(IsPicked(backup) ? "true" : "false")"
                            data-keyclick
                            @onclick="() => ClickAsync(backup)">
                    <MudStack Row
                              AlignItems="AlignItems.Center"
                              Spacing="3">
                        @if (_deleting)
                        {
                            <MudIcon Icon="@RowIcon(backup)"
                                     Color="@(_marked.Contains(backup) ? Color.Error : Color.Default)"
                                     Size="Size.Small" />
                        }
                        else
                        {
                            <MudElement HtmlTag="span"
                                        Class="timeline-dot" />
                        }
                        <MudStack Spacing="0"
                                  Class="flex-grow-1">
                            <MudText Typo="Typo.body2">@Formatter.FormatDateTimeWithSeconds(backup.TakenAt)</MudText>
                            <MudText Typo="Typo.caption"
                                     Class="mud-text-secondary">
                                @DetailOf(backup)
                            </MudText>
                        </MudStack>
                    </MudStack>
                </MudElement>
            }
        </MudPaper>
        @if (_selected is not null && !_deleting)
        {
            @* Change Views *@
            <MudButtonGroup OverrideStyles="false"
                            Size="Size.Small"
                            Class="setting-choices flex-shrink-0">
                <MudButton Variant="Variant.Filled"
                           Size="Size.Small"
                           Color="@(_showDifferences ? Color.Default : Color.Info)"
                           OnClick="() => _showDifferences = false">
                    @AppText.Get("SavedAfterBackup")
                    <MudElement HtmlTag="span"
                                Class="mud-text-secondary ml-2">
                        @CountOf(_savedChanges)
                    </MudElement>
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Size="Size.Small"
                           Color="@(_showDifferences ? Color.Info : Color.Default)"
                           OnClick="() => _showDifferences = true">
                    @AppText.Get("DiffersFromNow")
                    @if (_differences is not null)
                    {
                        <MudElement HtmlTag="span"
                                    Class="mud-text-secondary ml-2">
                            @CountOf(_differences)
                        </MudElement>
                    }
                </MudButton>
            </MudButtonGroup>
            <MudStack Spacing="2"
                      Class="inset rounded-panel pa-4 fit overflow-y-auto">
                @if (ViewText is { } text)
                {
                    <MudText Typo="Typo.caption"
                             Class="mud-text-secondary">
                        @text
                    </MudText>
                }
                <DifferenceList Changes="@ShownChanges" />
            </MudStack>
        }
        <MudText Typo="Typo.caption"
                 Class="mud-text-secondary text-relaxed">
            @UsageText
        </MudText>
    </DialogContent>
    <DialogActions>
        @if (_deleting)
        {
            @* Back Button *@
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Rounded.ArrowBack"
                       OnClick="StopDeleting">
                @AppText.Get("Back")
            </MudButton>
            @* All But Newest Button *@
            <MudButton Variant="Variant.Text"
                       Disabled="@(_marked.Count == Backups.Count - 1)"
                       OnClick="MarkAllButNewest">
                @AppText.Get("AllButNewest")
            </MudButton>
            <MudSpacer />
            @* Delete Marked Button *@
            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Rounded.Delete"
                       Disabled="@(_marked.Count == 0)"
                       OnClick="DeleteMarkedAsync">
                @AppText.Format("DeleteCount", _marked.Count)
            </MudButton>
        }
        else
        {
            @* Delete Backups Button *@
            <MudButton Variant="Variant.Text"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Rounded.DeleteSweep"
                       Disabled="@(Backups.Count <= 1)"
                       OnClick="StartDeleting">
                @AppText.Get("DeleteBackups")
            </MudButton>
            <MudSpacer />
            @* Restore Button *@
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Rounded.Restore"
                       Disabled="@(_selected is null || _differences is { Count: 0 })"
                       OnClick="Restore">
                @AppText.Get("Restore")
            </MudButton>
        }
    </DialogActions>

</MudDialog>
