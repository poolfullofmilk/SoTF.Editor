<MudDialog ContentClass="fill-column gap-2">

    <TitleContent>
        <MudText Typo="Typo.h6">@AppText.Get("RestoreBackupTitle")</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2"
                 Class="mud-text-secondary">
            @AppText.Get(_deleting ? "DeleteBackupsText" : "RestoreBackupText")
        </MudText>
        @* Backup List *@
        <MudPaper Elevation="0"
                  Class="inset rounded-panel panel-flush overflow-y-auto fit"
                  Style="min-height:132px">
            @foreach (var backup in Backups)
            {
                @* Backup Row *@
                <MudElement HtmlTag="div"
                            Class="@RowClass(backup)"
                            role="button"
                            tabindex="0"
                            aria-pressed="@(IsPicked(backup) ? "true" : "false")"
                            data-keyclick
                            @onclick="() => ClickAsync(backup)">
                    <MudStack Row
                              AlignItems="AlignItems.Center"
                              Spacing="3">
                        <MudIcon Icon="@RowIcon(backup)"
                                 Color="@(_marked.Contains(backup) ? Color.Error : Color.Default)"
                                 Size="Size.Small" />
                        <MudStack Spacing="0"
                                  Class="flex-grow-1">
                            <MudText Typo="Typo.body2">@Formatter.FormatDateTimeWithSeconds(backup.TakenAt)</MudText>
                            <MudText Typo="Typo.caption"
                                     Class="mud-text-secondary">
                                @DetailOf(backup)
                            </MudText>
                        </MudStack>
                    </MudStack>
                </MudElement>
            }
        </MudPaper>
        @if (_selected is not null && !_deleting)
        {
            <MudStack Spacing="4"
                      Class="inset rounded-panel pa-4 fit overflow-y-auto">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.subtitle2">@AppText.Get("SavedAfterBackup")</MudText>
                    @if (_savedChanges.Count == 0)
                    {
                        <MudText Typo="Typo.caption"
                                 Class="mud-text-secondary">
                            @AppText.Get("ChangesNotRecorded")
                        </MudText>
                    }
                    @foreach (var (page, changes) in _savedChanges)
                    {
                        <ChangeList Icon="@IconOf(page)"
                                    Label="@LabelOf(page)"
                                    Changes="changes" />
                    }
                </MudStack>
                <MudStack Spacing="2">
                    <MudText Typo="Typo.subtitle2">@AppText.Get("DiffersFromNow")</MudText>
                    @if (DifferencesText is { } text)
                    {
                        <MudText Typo="Typo.caption"
                                 Class="mud-text-secondary">
                            @text
                        </MudText>
                    }
                    @foreach (var (page, changes) in OrderedDifferences)
                    {
                        <ChangeList Icon="@IconOf(page)"
                                    Label="@LabelOf(page)"
                                    Changes="changes" />
                    }
                </MudStack>
            </MudStack>
        }
        <MudText Typo="Typo.caption"
                 Class="mud-text-secondary text-relaxed">
            @UsageText
        </MudText>
    </DialogContent>
    <DialogActions>
        @if (_deleting)
        {
            @* Back Button *@
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Rounded.ArrowBack"
                       OnClick="StopDeleting">
                @AppText.Get("Back")
            </MudButton>
            @* All But Newest Button *@
            <MudButton Variant="Variant.Text"
                       Disabled="@(_marked.Count == Backups.Count - 1)"
                       OnClick="MarkAllButNewest">
                @AppText.Get("AllButNewest")
            </MudButton>
            <MudSpacer />
            @* Delete Marked Button *@
            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Rounded.Delete"
                       Disabled="@(_marked.Count == 0)"
                       OnClick="DeleteMarkedAsync">
                @AppText.Format("DeleteCount", _marked.Count)
            </MudButton>
        }
        else
        {
            @* Delete Backups Button *@
            <MudButton Variant="Variant.Text"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Rounded.DeleteSweep"
                       Disabled="@(Backups.Count <= 1)"
                       OnClick="StartDeleting">
                @AppText.Get("DeleteBackups")
            </MudButton>
            <MudSpacer />
            @* Restore Button *@
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Rounded.Restore"
                       Disabled="@(_selected is null || _differences is { Count: 0 })"
                       OnClick="Restore">
                @AppText.Get("Restore")
            </MudButton>
        }
    </DialogActions>

</MudDialog>
