<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">@Localizer["RestoreBackupTitle"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.body2"
                     Class="mud-text-secondary">
                @Localizer["RestoreBackupText"]
            </MudText>
            <MudStack Spacing="0">
                @foreach (var backup in Backups)
                {
                    @* Backup Row *@
                    <MudStack Row
                              AlignItems="AlignItems.Center"
                              Spacing="3"
                              Class="@RowClass(backup)"
                              role="button"
                              tabindex="0"
                              aria-pressed="@((_selected == backup) ? "true" : "false")"
                              data-keyclick
                              @onclick="() => _selected = backup">
                        <MudText Typo="Typo.body2">@Formatter.FormatDateTimeWithSeconds(backup.TakenAt)</MudText>
                        <MudText Typo="Typo.body2"
                                 Class="mud-text-secondary">
                            @Formatter.FormatSize(backup.Size)
                        </MudText>
                        <MudSpacer />
                        <MudText Typo="Typo.body2"
                                 Class="mud-text-secondary">
                            @AgeLabel(backup)
                        </MudText>
                        @* Delete Backup *@
                        <Tooltip Text="@Localizer["DeleteBackup"]">
                            <MudIconButton Icon="@Icons.Material.Rounded.Delete"
                                           aria-label="@Localizer["DeleteBackup"]"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="() => DeleteAsync(backup)" />
                        </Tooltip>
                    </MudStack>
                }
            </MudStack>
            <MudText Typo="Typo.caption"
                     Class="mud-text-secondary text-relaxed">
                @UsageText
            </MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        @* Restore Button *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   StartIcon="@Icons.Material.Rounded.Restore"
                   Disabled="@(_selected is null)"
                   OnClick="Restore">
            @Localizer["Restore"]
        </MudButton>
    </DialogActions>

</MudDialog>
