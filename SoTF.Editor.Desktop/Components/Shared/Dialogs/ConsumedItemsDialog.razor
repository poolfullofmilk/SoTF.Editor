<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">@AppText.Get("ConsumedItems")</MudText>
    </TitleContent>
    <DialogContent>
        @if (_viewModel.ConsumedItems.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Rounded.Restaurant"
                        Text="@AppText.Get("NothingFound")" />
        }
        else
        {
            @* Consumed Items Table *@
            <MudTable T="ModifyConsumedItemsViewModel.ConsumedItemWrapper"
                      Items="_viewModel.ConsumedItems"
                      MultiSelection
                      @bind-SelectedItems="_selected"
                      Dense
                      Hover
                      FixedHeader
                      Elevation="0"
                      Class="fit"
                      Style="max-height:50vh">

                <ColGroup>
                    <col style="width:56px" />
                    <col />
                </ColGroup>
                <HeaderContent>
                    <MudTh>@AppText.Get("Name")</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <ItemLabel Name="@context.Name"
                                   ImageUrl="@context.ImageUrl" />
                    </MudTd>
                </RowTemplate>

            </MudTable>
        }
    </DialogContent>
    <DialogActions>
        @* Remove All *@
        <MudButton Color="Color.Error"
                   Disabled="@(_viewModel.ConsumedItems.Count == 0)"
                   OnClick="RemoveAllAsync"
                   StartIcon="@Icons.Material.Rounded.DeleteSweep">
            @AppText.Get("RemoveAll")
        </MudButton>
        <MudSpacer />
        @* Apply Button *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   Disabled="@(_selected.Count == 0)"
                   OnClick="Apply">
            @AppText.Get("RemoveSelected")
        </MudButton>
    </DialogActions>

</MudDialog>
