@* Item Label *@
<MudStack Row
          AlignItems="AlignItems.Center"
          Spacing="3">
    @if (!string.IsNullOrEmpty(ImageUrl))
    {
        <MudImage Src="@ImageUrl"
                  Alt="@Name"
                  Class="@ImageClass" />
    }
    else
    {
        <MudIcon Icon="@Icons.Material.Rounded.QuestionMark"
                 Class="thumb" />
    }
    <MudStack Spacing="0"
              Style="min-width:0">
        <MudText Typo="Typo.body2"
                 Class="mud-typography-nowrap text-tight">
            <MudHighlighter Text="@Name"
                            HighlightedText="@Highlight" />
            <ChangedDot When="Changed" />
        </MudText>
        @if (!string.IsNullOrEmpty(Detail))
        {
            <MudText Typo="Typo.caption"
                     Class="mud-text-secondary mud-typography-nowrap">
                <MudHighlighter Text="@Detail"
                                HighlightedText="@Highlight" />
            </MudText>
        }
    </MudStack>
</MudStack>
