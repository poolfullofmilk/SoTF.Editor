@* Item Label *@
<MudStack Row
          AlignItems="AlignItems.Center"
          Spacing="3">
    @if (!string.IsNullOrEmpty(ImageUrl))
    {
        <MudImage Src="@ImageUrl"
                  Alt="@Name"
                  Class="@ImageClass" />
    }
    else
    {
        <MudIcon Icon="@Icons.Material.Rounded.QuestionMark"
                 Class="thumb" />
    }
    <MudStack Spacing="0"
              Style="min-width:0">
        <MudText Typo="Typo.body2"
                 Class="text-truncate text-tight">
            @Name
            <ChangedDot When="Changed" />
        </MudText>
        @if (!string.IsNullOrEmpty(Detail))
        {
            <MudText Typo="Typo.caption"
                     Class="mud-text-secondary text-truncate">
                @Detail
            </MudText>
        }
    </MudStack>
</MudStack>
