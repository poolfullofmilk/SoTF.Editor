@inherits EditorPageBase

@if (Setting.Type == GenericSetting.DataType.Boolean)
{
    @* Setting Card *@
    <MudPaper Elevation="4"
              Class="@(CardClass + " d-flex align-center")">
        <ChangedDot When="Changed"
                    CardCorner />
        @* Setting Switch *@
        <MudSwitch T="bool"
                   Value="Setting.BoolValue ?? false"
                   ValueChanged="value => Setting.BoolValue = value"
                   Color="Color.Info"
                   Class="ma-0">
            <MudText Typo="Typo.subtitle2"
                     HtmlTag="span"
                     Class="d-inline-flex align-center gap-1">
                @AppText.Get(TextKeys.Setting(Setting.Name))
                @if (Info is not null)
                {
                    <InfoIcon Text="@Info" />
                }
            </MudText>
        </MudSwitch>
    </MudPaper>
}
else
{
    @* Setting Card *@
    <MudPaper Elevation="4"
              Class="@CardClass">
        <ChangedDot When="Changed"
                    CardCorner />
        <MudStack Spacing="2">
            <MudStack Row
                      AlignItems="AlignItems.Center"
                      Spacing="1">
                <MudText Typo="Typo.subtitle2"
                         Class="mud-typography-nowrap">
                    @AppText.Get(TextKeys.Setting(Setting.Name))
                </MudText>
                @if (Info is not null)
                {
                    <InfoIcon Text="@Info" />
                }
            </MudStack>
            <GenericSettingEditor Setting="Setting" />
            @if (Caption is not null)
            {
                <MudText Typo="Typo.caption"
                         Class="mud-text-secondary">
                    @Caption
                </MudText>
            }
        </MudStack>
    </MudPaper>
}
