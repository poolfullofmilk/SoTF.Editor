<MudStack Spacing="2"
          Class="@Class">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        @* Header *@
        <MudStack Row
                  AlignItems="AlignItems.Center"
                  Spacing="1">
            <MudText Typo="Typo.h5"
                     Class="mx-2">
                @Title
            </MudText>
            @if (Info is not null)
            {
                <InfoButton Text="@Info" />
            }
            <ChangedDot When="Changed" />
            @TitleContent
        </MudStack>
    }

    @ChildContent
</MudStack>
