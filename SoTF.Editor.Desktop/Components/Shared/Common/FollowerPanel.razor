@inherits EditorPageBase

@* Follower Panel *@
<Header Title="@Name">
    <TitleContent>
        <MudChip T="string"
                 Variant="Variant.Text"
                 Size="Size.Small">
            @Follower.Status
        </MudChip>
        <MudSpacer />
        <ShowOnMapButton Position="MapPosition" />
    </TitleContent>
    <ChildContent>
        <MudPaper Elevation="4"
                  Class="rounded-panel pa-4">
            <MudStack Spacing="3">
                <MudStack Row
                          AlignItems="AlignItems.Center"
                          Spacing="4">
                    <MudImage Src="@ImageUrl"
                              Alt="@Name"
                              Width="96"
                              Height="120"
                              ObjectFit="ObjectFit.Cover"
                              ObjectPosition="ObjectPosition.Top"
                              Class="rounded-inner flex-shrink-0" />
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.body2"
                                 Class="mud-text-secondary selectable-text">
                            @($"{Localizer["UniqueId"]}: {Follower.UniqueId?.ToString() ?? "-"}")
                        </MudText>
                        <MudText Typo="Typo.body2"
                                 Class="mud-text-secondary selectable-text">
                            @($"{Localizer["Position"]}: {Follower.Pos.PrintableShort}")
                            <ChangedDot When="@FollowerPage.IsChanged(Follower, nameof(FollowerState.Pos))" />
                        </MudText>
                    </MudStack>
                    <MudSpacer />
                    @if (Copies.Count > 1)
                    {
                        @* Copy Select *@
                        <MudElement HtmlTag="div"
                                    Class="align-self-start"
                                    Style="width:160px">
                            <MudSelect T="FollowerState"
                                       Value="Follower"
                                       ValueChanged="FollowerPage.Select"
                                       ToStringFunc="CopyLabel"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense>
                                @foreach (var copy in Copies)
                                {
                                    <MudSelectItem Value="copy">@CopyLabel(copy)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudElement>
                    }
                    @if (IsSpawnedCopy)
                    {
                        @* Remove Copy *@
                        <Tooltip Text="@Localizer["RemoveCopy"]"
                                 RootClass="align-self-start">
                            <MudIconButton Icon="@Icons.Material.Rounded.Delete"
                                           aria-label="@Localizer["RemoveCopy"]"
                                           Color="Color.Error"
                                           OnClick="RemoveCopyAsync" />
                        </Tooltip>
                    }
                </MudStack>

                <MudStack Row
                          Wrap="Wrap.Wrap"
                          Spacing="2">
                    @* Fill Bars *@
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Info"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Rounded.BatteryChargingFull"
                               Disabled="@(!InSave)"
                               OnClick="() => FollowerPageViewModel.FillAllBars(Follower)">
                        @Localizer["FillAllBars"]
                    </MudButton>
                    @* Move To Player *@
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Rounded.NearMe"
                               Disabled="@(!CanMoveToPlayer)"
                               OnClick="() => FollowerPageViewModel.MoveTo(Follower, PlayerPage.PlayerState.Pos)">
                        @Localizer["MoveToPlayer"]
                    </MudButton>
                    @* Move To Other *@
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Rounded.NearMe"
                               Disabled="@(!CanMoveToOther)"
                               OnClick="MoveToOther">
                        @(IsKelvin ? Localizer["MoveToVirginia"] : Localizer["MoveToKelvin"])
                    </MudButton>
                    @* Revive *@
                    <Tooltip Text="@Localizer["ReviveTooltip"]"
                             Disabled="@(!CanRevive)">
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Rounded.Favorite"
                                   Disabled="@(!CanRevive)"
                                   OnClick="Revive">
                            @Localizer["Revive"]
                        </MudButton>
                    </Tooltip>
                    @* Spawn *@
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Rounded.GroupAdd"
                               OnClick="SpawnAsync">
                        @Localizer["Spawn"]
                    </MudButton>
                </MudStack>

                @* Health *@
                <StatSlider Label="@Localizer["Health"]"
                            Changed="@FollowerPage.IsChanged(Follower, nameof(FollowerState.Health))"
                            @bind-Value="Follower.Health" />
                @* Anger *@
                <StatSlider Label="@Localizer["Anger"]"
                            Changed="@FollowerPage.IsChanged(Follower, nameof(FollowerState.Anger))"
                            @bind-Value="Follower.Anger" />
                @* Fear *@
                <StatSlider Label="@Localizer["Fear"]"
                            Changed="@FollowerPage.IsChanged(Follower, nameof(FollowerState.Fear))"
                            @bind-Value="Follower.Fear" />
                @* Fullness *@
                <StatSlider Label="@Localizer["Fullness"]"
                            Changed="@FollowerPage.IsChanged(Follower, nameof(FollowerState.Fullness))"
                            @bind-Value="Follower.Fullness" />
                @* Hydration *@
                <StatSlider Label="@Localizer["Hydration"]"
                            Changed="@FollowerPage.IsChanged(Follower, nameof(FollowerState.Hydration))"
                            @bind-Value="Follower.Hydration" />
                @* Energy *@
                <StatSlider Label="@Localizer["Energy"]"
                            Changed="@FollowerPage.IsChanged(Follower, nameof(FollowerState.Energy))"
                            @bind-Value="Follower.Energy" />
                @* Affection *@
                <StatSlider Label="@Localizer["Affection"]"
                            Changed="@FollowerPage.IsChanged(Follower, nameof(FollowerState.Affection))"
                            @bind-Value="Follower.Affection" />

                @* Outfit *@
                <ChangedBadge When="@FollowerPage.IsChanged(Follower, nameof(FollowerState.Outfit))"
                              Class="d-block">
                    <MudSelect T="Outfit"
                               Variant="Variant.Outlined"
                               @bind-Value="Follower.Outfit"
                               Label="@Localizer["Outfit"]"
                               ToStringFunc="outfit => outfit?.Name ?? string.Empty">
                        @foreach (var outfit in Follower.Outfits)
                        {
                            <MudSelectItem Value="outfit">@outfit.Name</MudSelectItem>
                        }
                    </MudSelect>
                </ChangedBadge>

                <MudText Typo="Typo.subtitle2"
                         Class="mt-2">
                    @Localizer["Equipment"]
                </MudText>
                <MudStack Row
                          Wrap="Wrap.Wrap"
                          Spacing="0">
                    @foreach (var equippableItem in Follower.Inventory)
                    {
                        @* Equipment *@
                        <MudCheckBox T="bool"
                                     @bind-Value="equippableItem.Selected"
                                     Color="Color.Info"
                                     Dense>
                            @equippableItem.Name
                            <ChangedDot When="@FollowerPage.IsChanged(Follower, equippableItem)" />
                        </MudCheckBox>
                    }
                </MudStack>

                <MudStack Row
                          AlignItems="AlignItems.Center"
                          Spacing="1"
                          Class="mt-2">
                    <MudText Typo="Typo.subtitle2">@Localizer["Influences"]</MudText>
                    <InfoButton Text="@Localizer["InfluencesInfo"]" />
                </MudStack>
                <InfluencesEditor Influences="Follower.Influences"
                                  ChangedWhen="IsInfluenceChanged"
                                  OnChanged="StateHasChanged" />
            </MudStack>
        </MudPaper>
    </ChildContent>
</Header>
