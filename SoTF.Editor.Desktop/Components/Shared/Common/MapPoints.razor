@* Zipline Lines *@
<svg class="map-zipline"
     viewBox="0 0 4096 4096">
    @foreach (var zipline in MapViewModel.VisibleZiplines())
    {
        <line x1="@Pixel(zipline.PointA.MapLeft)"
              y1="@Pixel(zipline.PointA.MapTop)"
              x2="@Pixel(zipline.PointB.MapLeft)"
              y2="@Pixel(zipline.PointB.MapTop)" />
    }
</svg>
@foreach (var poi in PointsToDraw())
{
    @* Point Icon *@
    <img @key="poi"
         src="@poi.Icon"
         alt="@poi.Title"
         title="@poi.Title"
         class="map-poi"
         role="button"
         tabindex="-1"
         data-keyclick
         style="@PoiStyle(poi.MapLeft, poi.MapTop, poi.IconSize, poi.IconZIndex)" />
    @if (poi is PlayerPoi)
    {
        <svg class="map-heading"
             viewBox="0 0 16 12"
             style="@HeadingStyle(poi.MapLeft, poi.MapTop, poi.IconZIndex)">
            <polygon points="8,1.5 14.5,10.5 1.5,10.5" />
        </svg>
    }
}
