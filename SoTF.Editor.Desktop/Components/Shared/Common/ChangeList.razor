<MudStack Row
          AlignItems="AlignItems.Start"
          Spacing="3"
          Class="px-3 py-1">
    @if (Icon is not null)
    {
        <MudIcon Icon="@Icon"
                 Size="Size.Small" />
    }
    <MudStack Spacing="0"
              Class="flex-grow-1">
        @if (Label is not null)
        {
            <MudStack Row
                      AlignItems="AlignItems.Center"
                      Spacing="1">
                @if (Actions && OnOpen.HasDelegate)
                {
                    @* Open Page *@
                    <MudLink Typo="Typo.body2"
                             Color="Color.Info"
                             Underline="Underline.Hover"
                             OnClick="OnOpen">
                        @Label
                    </MudLink>
                }
                else
                {
                    <MudText Typo="Typo.body2">@Label</MudText>
                }
                @if (Actions && OnRevert.HasDelegate)
                {
                    <MudSpacer />
                    @* Revert Page *@
                    <Tooltip Text="@AppText.Get("RevertPage")"
                             RootClass="d-flex">
                        <MudIconButton Icon="@Icons.Material.Rounded.Undo"
                                       aria-label="@AppText.Get("RevertPage")"
                                       Size="Size.Small"
                                       OnClick="OnRevert" />
                    </Tooltip>
                }
            </MudStack>
        }
        @foreach (var change in Shown)
        {
            <MudStack Row
                      AlignItems="AlignItems.Center"
                      Spacing="1">
                <MudElement HtmlTag="span"
                            Class="change-mark">
                    @switch (change.Kind)
                    {
                        case ChangeKind.Added:
                            <MudIcon Icon="@Icons.Material.Rounded.Add"
                                     Color="Color.Success"
                                     Size="Size.Small" />
                            break;
                        case ChangeKind.Removed:
                            <MudIcon Icon="@Icons.Material.Rounded.Remove"
                                     Color="Color.Error"
                                     Size="Size.Small" />
                            break;
                        default:
                            <MudElement HtmlTag="span"
                                        Class="changed-dot centered" />
                            break;
                    }
                </MudElement>
                <MudText Typo="Typo.caption"
                         Class="mud-text-secondary">
                    @change.Name
                </MudText>
                @if (change.Count is { } count)
                {
                    <MudSpacer />
                    <MudText Typo="Typo.caption"
                             Class="mud-text-secondary">
                        @count
                    </MudText>
                }
            </MudStack>
        }
        @if (Hidden > 0)
        {
            @* Show All Changes *@
            <MudLink Typo="Typo.caption"
                     Color="Color.Info"
                     Underline="Underline.Always"
                     Class="change-more align-self-start"
                     OnClick="ShowAllAsync">
                @AppText.Format("AndMore", Hidden)
            </MudLink>
        }
    </MudStack>
</MudStack>
