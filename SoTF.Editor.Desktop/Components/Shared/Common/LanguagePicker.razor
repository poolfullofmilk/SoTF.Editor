@* Language Menu *@
<Tooltip Text="@Localizer["Language"]"
         RootClass="d-flex">
    <MudMenu Icon="@Icons.Material.Rounded.Public"
             AriaLabel="@Localizer["Language"]"
             Size="Size.Small">
        @foreach (var (culture, name) in AppCulture.Languages)
        {
            @* Language *@
            <MudMenuItem Icon="@(AppCulture.Current == culture ? Icons.Material.Rounded.Check : string.Empty)"
                         IconColor="Color.Secondary"
                         OnClick="@(() => SetCultureAsync(culture))">
                @name
            </MudMenuItem>
        }
    </MudMenu>
</Tooltip>
