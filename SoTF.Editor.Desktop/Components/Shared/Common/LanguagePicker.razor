@* Language Menu *@
<Tooltip Text="@AppText.Get("Language")"
         RootClass="d-flex">
    <MudMenu Icon="@Icons.Material.Rounded.Public"
             AriaLabel="@AppText.Get("Language")"
             Size="Size.Small">
        @foreach (var (culture, name) in AppText.Languages)
        {
            @* Language *@
            <MudMenuItem Icon="@(AppCulture.Current == culture ? Icons.Material.Rounded.Check : string.Empty)"
                         IconColor="Color.Secondary"
                         OnClick="@(() => SetCultureAsync(culture))">
                @name
            </MudMenuItem>
        }
    </MudMenu>
</Tooltip>
