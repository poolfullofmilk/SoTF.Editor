@* Stat Slider *@
<MudStack Row
          AlignItems="AlignItems.Center"
          Spacing="4">
    <MudStack Row
              AlignItems="AlignItems.Center"
              Spacing="1"
              Style="width:160px;flex-shrink:0">
        <MudText Typo="Typo.body2"
                 Class="text-truncate">
            @Label
        </MudText>
        @if (Info is not null)
        {
            <InfoButton Text="@Info" />
        }
    </MudStack>
    @if (ReadOnly)
    {
        <MudProgressLinear Value="Value"
                           Min="Min"
                           Max="Max"
                           Color="Color.Info"
                           Rounded
                           Class="flex-grow-1" />
    }
    else
    {
        @* Slider *@
        <MudSlider T="float"
                   Value="Value"
                   ValueChanged="ValueChanged"
                   Min="Min"
                   Max="Max"
                   Step="Step"
                   Color="Color.Info"
                   Immediate
                   Class="flex-grow-1" />
    }
    @* Value Field *@
    <MudNumericField T="float"
                     Value="Value"
                     ValueChanged="ValueChanged"
                     Min="Min"
                     Max="Max"
                     Step="Step"
                     ReadOnly="ReadOnly"
                     Variant="Variant.Text"
                     Margin="Margin.Dense"
                     HideSpinButtons
                     Format="0.##"
                     Style="width:90px;flex-shrink:0" />
</MudStack>
