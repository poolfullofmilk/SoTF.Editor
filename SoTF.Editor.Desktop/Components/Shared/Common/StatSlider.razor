@* Stat Slider *@
<MudStack Row
          AlignItems="AlignItems.Center"
          Spacing="4">
    <MudStack Row
              AlignItems="AlignItems.Center"
              Spacing="1"
              Style="width:160px;flex-shrink:0">
        <MudText Typo="Typo.body2"
                 Class="mud-typography-nowrap">
            @Label
        </MudText>
        @if (Info is not null)
        {
            <InfoIcon Text="@Info" />
        }
        @if (Warning is not null)
        {
            <InfoIcon Text="@Warning"
                      Warning />
        }
    </MudStack>
    @if (ReadOnly)
    {
        <MudProgressLinear Value="Value"
                           Min="Min"
                           Max="Max"
                           Color="Color.Info"
                           Size="Size.Medium"
                           Rounded
                           Class="flex-grow-1"
                           Style="@StatColors.StyleOf(Tint)" />
    }
    else
    {
        @* Slider *@
        <MudSlider T="float"
                   Value="Value"
                   ValueChanged="ValueChanged"
                   Min="Min"
                   Max="Max"
                   Step="Step"
                   Color="Color.Info"
                   Size="Size.Medium"
                   Variant="Variant.Filled"
                   Immediate
                   Class="flex-grow-1"
                   Style="@StatColors.StyleOf(Tint)" />
    }
    @* Value Field *@
    <ChangedBadge When="Changed"
                  Class="flex-shrink-0">
        <NumberField T="float"
                     Value="Value"
                     ValueChanged="ValueChanged"
                     Min="Min"
                     Max="Max"
                     Step="Step"
                     ReadOnly="ReadOnly"
                     Margin="Margin.Dense"
                     HideSpinButtons
                     Format="0.##"
                     Style="width:90px" />
    </ChangedBadge>
</MudStack>
