@inherits EditorPageBase

@* Setting Editor *@
<ChangedBadge When="Changed"
              Class="d-block">
    @switch (Setting.Type)
    {
        case GenericSetting.DataType.String:
            <MudTextField T="string"
                          Variant="Variant.Outlined"
                          @bind-Value="Setting.StringValue"
                          Margin="Margin.Dense" />
            break;
        case GenericSetting.DataType.Boolean:
            <MudSwitch T="bool"
                       Value="Setting.BoolValue ?? false"
                       ValueChanged="value => Setting.BoolValue = value"
                       Color="Color.Info" />
            break;
        case GenericSetting.DataType.Integer:
            <NumberField T="int?"
                         @bind-Value="Setting.IntValue"
                         Min="Setting.MinInt"
                         Max="Setting.MaxInt"
                         Margin="Margin.Dense"
                         Style="max-width:160px" />
            break;
        case GenericSetting.DataType.Decimal:
            <NumberField T="double?"
                         @bind-Value="Setting.DecimalValue"
                         Min="Setting.MinInt"
                         Max="Setting.MaxInt"
                         Margin="Margin.Dense"
                         Style="max-width:160px" />
            break;
        case GenericSetting.DataType.Enum:
            @* Setting Choices *@
            <MudButtonGroup OverrideStyles="false"
                            Size="Size.Small"
                            Class="setting-choices">
                @foreach (var possibleValue in Setting.PossibleValues)
                {
                    <MudButton Variant="Variant.Filled"
                               Size="Size.Small"
                               Color="@(Equals(Setting.SelectedItem, possibleValue.Key) ? Color.Info : Color.Default)"
                               OnClick="() => Setting.SelectedItem = possibleValue.Key">
                        @possibleValue.Value
                    </MudButton>
                }
            </MudButtonGroup>
            break;
        default:
            <MudTextField T="string"
                          Value="Setting.StringValue"
                          ReadOnly
                          Underline="false"
                          Margin="Margin.Dense"
                          Class="selectable-text" />
            break;
    }
</ChangedBadge>
