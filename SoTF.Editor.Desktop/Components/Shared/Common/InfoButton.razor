@* Info Button *@
<Tooltip Text="@Text"
         RootClass="d-inline-flex ml-1">
    <MudIconButton Icon="@(Warning ? Icons.Material.Rounded.Warning : Icons.Material.Rounded.Info)"
                   aria-label="@Text"
                   Color="@(Warning ? Color.Warning : Color.Info)"
                   Size="Size.Small"
                   Class="info-button" />
</Tooltip>
