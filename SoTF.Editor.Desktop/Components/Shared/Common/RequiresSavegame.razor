@if (MainViewModel.SelectedSavegame is null)
{
    <EmptyState Icon="@Icons.Material.Rounded.Folder"
                Text="@AppText.Get("OpenSavegameFirst")">
        @* Savegames Button *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   Size="Size.Small"
                   Href="/">
            @AppText.Get("Savegames")
        </MudButton>
    </EmptyState>
}
else if (MissesWorld)
{
    <EmptyState Icon="@Icons.Material.Rounded.Public"
                Text="@AppText.Get("ClientSaveHasNoWorld")" />
}
else
{
    @ChildContent
}
