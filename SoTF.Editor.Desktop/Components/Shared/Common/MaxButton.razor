@* Max Button *@
<MudElement HtmlTag="span"
            Class="max-slot">
    <MudButton Variant="Variant.Text"
               Size="Size.Small"
               Disabled="Disabled"
               title="@(Disabled ? null : AppText.Get("SetToMax"))"
               OnClick="OnClick">
        @($"{AppText.Get("Max")} {Max}")
    </MudButton>
</MudElement>
