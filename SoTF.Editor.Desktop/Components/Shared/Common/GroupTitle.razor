@* Group Title *@
<MudStack Row
          AlignItems="AlignItems.Center"
          Justify="Justify.SpaceBetween"
          Spacing="2"
          Class="group-title px-4 pt-3 pb-1">
    <MudText Typo="Typo.subtitle2"
             Class="mud-typography-nowrap"
             Style="font-weight:700">
        <MudHighlighter Text="@Title"
                        HighlightedText="@Highlight" />
    </MudText>
    @if (Count is { } count)
    {
        <MudText Typo="Typo.subtitle2">
            @count
        </MudText>
    }
</MudStack>
