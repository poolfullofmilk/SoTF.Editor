@* Area *@
<MudSelect T="Area"
           Variant="Variant.Outlined"
           @bind-Value="Landing.SelectedArea"
           Label="@AppText.Get("Area")"
           ToStringFunc="area => area?.Name ?? string.Empty"
           Dense>
    @foreach (var area in Landing.Areas)
    {
        <MudSelectItem Value="area">@area.Name</MudSelectItem>
    }
</MudSelect>
<MudStack Row
          AlignItems="AlignItems.Center"
          Spacing="1">
    <MudText Typo="Typo.caption"
             Class="mud-text-secondary">
        @AppText.Get("Offset")
    </MudText>
    <InfoIcon Text="@AppText.Get("SpawnOffsetInfo")" />
</MudStack>
<MudStack Row
          Spacing="2">
    @* Offset X *@
    <NumberField T="float"
                 @bind-Value="Landing.XOffset"
                 Label="X"
                 Step="0.5f" />
    @* Offset Y *@
    <NumberField T="float"
                 @bind-Value="Landing.YOffset"
                 Label="Y"
                 Step="0.5f" />
    @* Offset Z *@
    <NumberField T="float"
                 @bind-Value="Landing.ZOffset"
                 Label="Z"
                 Step="0.5f" />
</MudStack>
