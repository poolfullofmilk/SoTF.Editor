@* Influences Editor *@
<MudStack Spacing="3">
    @foreach (var influence in Influences)
    {
        <MudPaper Elevation="0"
                  Class="inset rounded-panel pa-4">
            <MudStack Spacing="1">
                <MudStack Row
                          AlignItems="AlignItems.Center"
                          Spacing="2">
                    <MudText Typo="Typo.subtitle2">@influence.PrintableTypeId</MudText>
                    <MudChip T="string"
                             Variant="Variant.Text"
                             Size="Size.Small"
                             Color="@MoodOf(influence).Color">
                        @AppText.Get(MoodOf(influence).LabelKey)
                    </MudChip>
                    <MudSpacer />
                    @if (CanRemove)
                    {
                        @* Remove Influence *@
                        <MudIconButton Icon="@Icons.Material.Rounded.Delete"
                                       aria-label="@AppText.Get("Remove")"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="() => Remove(influence)" />
                    }
                </MudStack>
                @* Mood Buttons *@
                <MudButtonGroup Variant="Variant.Filled"
                                Size="Size.Small"
                                OverrideStyles="false"
                                Class="align-self-start mb-1">
                    @foreach (var mood in s_moods)
                    {
                        @* Mood Button *@
                        <MudButton Variant="Variant.Filled"
                                   Color="@(mood.IsExactly(influence) ? Color.Info : Color.Default)"
                                   Size="Size.Small"
                                   OnClick="() => Change(() => mood.ApplyTo(influence))">
                            @AppText.Get(mood.LabelKey)
                        </MudButton>
                    }
                </MudButtonGroup>
                @* Sentiment *@
                <StatSlider Label="@AppText.Get("Sentiment")"
                            Info="@AppText.Get("SentimentInfo")"
                            Changed="@IsChanged(influence, nameof(influence.Sentiment))"
                            Value="influence.Sentiment"
                            ValueChanged="value => Change(() => influence.Sentiment = value)"
                            Min="-100" />
                @* Anger *@
                <StatSlider Label="@AppText.Get("Anger")"
                            Changed="@IsChanged(influence, nameof(influence.Anger))"
                            Value="influence.Anger"
                            ValueChanged="value => Change(() => influence.Anger = value)"
                            Min="-100" />
                @* Fear *@
                <StatSlider Label="@AppText.Get("Fear")"
                            Changed="@IsChanged(influence, nameof(influence.Fear))"
                            Value="influence.Fear"
                            ValueChanged="value => Change(() => influence.Fear = value)"
                            Min="-100" />
            </MudStack>
        </MudPaper>
    }

    @if (MissingTypes.Any())
    {
        <MudStack Row
                  AlignItems="AlignItems.Center"
                  Spacing="2">
            @* Influence Type *@
            <MudSelect T="string"
                       Variant="Variant.Outlined"
                       @bind-Value="_newType"
                       Label="@AppText.Get("Influences")"
                       ToStringFunc="TypeName"
                       Dense
                       Class="flex-grow-1">
                @foreach (var type in MissingTypes)
                {
                    <MudSelectItem Value="type">@TypeName(type)</MudSelectItem>
                }
            </MudSelect>
            @* Add Influence *@
            <MudButton Variant="Variant.Text"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Rounded.Add"
                       Disabled="@(_newType is null)"
                       OnClick="Add">
                @AppText.Get("Add")
            </MudButton>
        </MudStack>
    }
</MudStack>
