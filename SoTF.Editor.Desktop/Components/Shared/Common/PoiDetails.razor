@* Point Details *@
<MudStack Spacing="3">
    <MudStack Row
              AlignItems="AlignItems.Center"
              Spacing="3">
        <MudImage Src="@Poi.Icon"
                  Alt="@Poi.Title"
                  Class="thumb" />
        <MudText Typo="Typo.h6"
                 Class="text-tight">
            @Poi.Title
        </MudText>
        <MudSpacer />
        @* Close Details *@
        <MudIconButton Icon="@Icons.Material.Rounded.Close"
                       aria-label="@AppText.Get("Close")"
                       Size="Size.Small"
                       OnClick="CloseAsync" />
    </MudStack>

    @if (!string.IsNullOrEmpty(Poi.Description))
    {
        <MudText Typo="Typo.body2"
                 Class="text-relaxed">
            @Poi.Description
        </MudText>
    }

    <MudSimpleTable Dense
                    Elevation="0"
                    Style="background:transparent">
        <tbody>
            @foreach (var detail in Details)
            {
                <tr>
                    <td class="mud-text-secondary">@detail.Label</td>
                    <td class="selectable-text">@detail.Value</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>

    @foreach (var itemList in ItemLists)
    {
        <MudText Typo="Typo.subtitle2">@itemList.Title</MudText>
        <MudStack Spacing="1">
            @foreach (var wrapper in itemList.Items.OrderBy(wrapper => wrapper.Item.Name))
            {
                <MudStack Row
                          AlignItems="AlignItems.Center"
                          Spacing="2">
                    <MudIcon Icon="@(wrapper.HasItem ? Icons.Material.Rounded.CheckCircle : Icons.Material.Rounded.Cancel)"
                             Color="@(wrapper.HasItem ? Color.Success : Color.Error)"
                             Size="Size.Small" />
                    <ItemLabel Name="@wrapper.Item.Name"
                               ImageUrl="@wrapper.Item.ImageUrl" />
                </MudStack>
            }
        </MudStack>
    }

    @if (Poi is InformationalPoi { WikiLink: { } wikiLink })
    {
        @* Wiki Link *@
        <MudButton Variant="Variant.Text"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Rounded.MenuBook"
                   Href="@wikiLink">
            @AppText.Get("Wiki")
        </MudButton>
    }

    <MudStack Spacing="1">
        @if (Poi is ActorPoi actorPoi)
        {
            @* Bring To Player *@
            <Tooltip Text="@AppText.Get("AlreadyThere")"
                     Disabled="@(!IsWithPlayer(actorPoi))"
                     RootClass="d-flex flex-column">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Info"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Rounded.NearMe"
                           Disabled="@IsWithPlayer(actorPoi)"
                           OnClick="() => BringToPlayerAsync(actorPoi)">
                    @AppText.Get("BringToPlayer")
                </MudButton>
            </Tooltip>
            @* Edit Actor *@
            <MudButton Variant="Variant.Filled"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Rounded.Edit"
                       OnClick="() => EditActorAsync(actorPoi)">
                @AppText.Get("Edit")
            </MudButton>
        }
        @if (Poi is ZipPointPoi)
        {
            @* Move Anchor *@
            <MudButton Variant="Variant.Filled"
                       Color="@PickColor(false)"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Rounded.OpenWith"
                       OnClick="() => TogglePickAsync(false)">
                @AppText.Get("MoveAnchor")
            </MudButton>
        }
        @if (Poi is ZipPointPoi or LocationPoi)
        {
            @* New Zipline *@
            <MudButton Variant="Variant.Filled"
                       Color="@PickColor(true)"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Rounded.Timeline"
                       OnClick="() => TogglePickAsync(true)">
                @AppText.Get("NewZiplineFromHere")
            </MudButton>
        }
        @if (Poi is ZipPointPoi zipPointPoi)
        {
            @* Remove Zipline *@
            <MudButton Variant="Variant.Text"
                       Color="Color.Error"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Rounded.Delete"
                       OnClick="() => RemoveZiplineAsync(zipPointPoi.Parent)">
                @AppText.Get("RemoveZipline")
            </MudButton>
        }
    </MudStack>

    <MudDivider />
    <MudText Typo="Typo.subtitle2">@AppText.Get("Teleportation")</MudText>
    <MudStack Spacing="1">
        @* Teleport Player *@
        <Tooltip Text="@AppText.Get("AlreadyThere")"
                 Disabled="@(!PlayerIsThere)"
                 RootClass="d-flex flex-column">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Rounded.Person"
                       Disabled="@(Poi.Position is null || PlayerIsThere)"
                       OnClick="() => TeleportAsync(TeleportTarget.Player)">
                @AppText.Get("TeleportPlayerHere")
            </MudButton>
        </Tooltip>
        @* Teleport Kelvin *@
        <Tooltip Text="@AppText.Get("AlreadyThere")"
                 Disabled="@(!IsThere(Constants.Actors.KelvinTypeId))"
                 RootClass="d-flex flex-column">
            <MudButton Variant="Variant.Text"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Rounded.NearMe"
                       Disabled="@(!CanTeleport(Constants.Actors.KelvinTypeId))"
                       OnClick="() => TeleportAsync(TeleportTarget.Kelvin)">
                @AppText.Get("TeleportKelvinHere")
            </MudButton>
        </Tooltip>
        @* Teleport Virginia *@
        <Tooltip Text="@AppText.Get("AlreadyThere")"
                 Disabled="@(!IsThere(Constants.Actors.VirginiaTypeId))"
                 RootClass="d-flex flex-column">
            <MudButton Variant="Variant.Text"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Rounded.NearMe"
                       Disabled="@(!CanTeleport(Constants.Actors.VirginiaTypeId))"
                       OnClick="() => TeleportAsync(TeleportTarget.Virginia)">
                @AppText.Get("TeleportVirginiaHere")
            </MudButton>
        </Tooltip>
        @* Spawn Actors *@
        <MudButton Variant="Variant.Text"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Rounded.GroupAdd"
                   Disabled="@(Poi.Position is null)"
                   OnClick="SpawnActorsAsync">
            @AppText.Get("SpawnActors")
        </MudButton>
    </MudStack>
</MudStack>
