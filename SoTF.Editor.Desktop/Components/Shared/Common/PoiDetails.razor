@* Point Details *@
<MudStack Spacing="3">
    <MudStack Row
              AlignItems="AlignItems.Center"
              Spacing="3">
        <MudImage Src="@Poi.Icon"
                  Alt="@Poi.Title"
                  Class="thumb" />
        <MudText Typo="Typo.h6"
                 Class="text-tight">
            @Poi.Title
        </MudText>
        <MudSpacer />
        @* Close Details *@
        <MudIconButton Icon="@Icons.Material.Rounded.Close"
                       aria-label="@AppText.Get("Close")"
                       Size="Size.Small"
                       OnClick="CloseAsync" />
    </MudStack>

    @if (!string.IsNullOrEmpty(Poi.Description))
    {
        <MudText Typo="Typo.body2"
                 Class="text-relaxed">
            @Poi.Description
        </MudText>
    }

    <MudSimpleTable Dense
                    Elevation="0"
                    Style="background:transparent">
        <tbody>
            @foreach (var detail in Details)
            {
                <tr>
                    <td class="mud-text-secondary">@detail.Label</td>
                    <td>
                        <MudStack Row
                                  AlignItems="AlignItems.Center"
                                  Spacing="1">
                            <MudText Typo="Typo.body2"
                                     Class="selectable-text flex-grow-1">
                                @detail.Value
                            </MudText>
                            @if (detail.Copies)
                            {
                                @* Copy Coordinates *@
                                <MudIconButton Icon="@Icons.Material.Rounded.ContentCopy"
                                               aria-label="@AppText.Get("CopyCoordinates")"
                                               title="@AppText.Get("CopyCoordinates")"
                                               Size="Size.Small"
                                               OnClick="CopyCoordinatesAsync" />
                            }
                        </MudStack>
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>

    @foreach (var itemList in ItemLists)
    {
        <MudText Typo="Typo.subtitle2">@itemList.Title</MudText>
        <MudStack Spacing="1">
            @foreach (var wrapper in itemList.Items.OrderBy(wrapper => wrapper.Item.Name))
            {
                <MudStack Row
                          AlignItems="AlignItems.Center"
                          Spacing="2">
                    <MudIcon Icon="@(wrapper.HasItem ? Icons.Material.Rounded.CheckCircle : Icons.Material.Rounded.Cancel)"
                             Color="@(wrapper.HasItem ? Color.Success : Color.Error)"
                             Size="Size.Small" />
                    <ItemLabel Name="@wrapper.Item.Name"
                               ImageUrl="@wrapper.Item.ImageUrl" />
                </MudStack>
            }
        </MudStack>
    }

    @if (Poi is InformationalPoi { WikiLink: { } wikiLink })
    {
        @* Wiki Link *@
        <MudButton Variant="Variant.Text"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Rounded.MenuBook"
                   Href="@wikiLink"
                   Class="align-self-center">
            @AppText.Get("Wiki")
        </MudButton>
    }

    @if (Poi is ActorPoi actorPoi)
    {
        <DetailsSection Title="@AppText.Get("Actor")"
                        HostOnly="IsClientSave">
            @* Bring To Player *@
            <Tooltip Text="@AppText.Get("AlreadyThere")"
                     Disabled="@(IsClientSave || !IsWithPlayer(actorPoi))"
                     RootClass="d-flex">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Info"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Rounded.NearMe"
                           Disabled="@(IsClientSave || IsWithPlayer(actorPoi))"
                           OnClick="() => BringToPlayerAsync(actorPoi)">
                    @AppText.Get("BringToPlayer")
                </MudButton>
            </Tooltip>
            @* Edit Actor *@
            <MudButton Variant="Variant.Text"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Rounded.Edit"
                       Disabled="IsClientSave"
                       OnClick="() => EditActorAsync(actorPoi)">
                @AppText.Get("Edit")
            </MudButton>
        </DetailsSection>
    }

    @if (Poi is ZipPointPoi or LocationPoi)
    {
        <DetailsSection Title="@AppText.Get("Zipline")"
                        HostOnly="IsClientSave">
            @if (Poi is ZipPointPoi)
            {
                @* Move Anchor *@
                <MudButton Variant="@PickVariant(false)"
                           Color="@PickColor(false)"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Rounded.OpenWith"
                           Disabled="IsClientSave"
                           OnClick="() => TogglePickAsync(false)">
                    @AppText.Get("MoveAnchor")
                </MudButton>
            }
            @* New Zipline *@
            <MudButton Variant="@PickVariant(true)"
                       Color="@PickColor(true)"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Rounded.Timeline"
                       Disabled="IsClientSave"
                       OnClick="() => TogglePickAsync(true)">
                @AppText.Get("NewZiplineFromHere")
            </MudButton>
            @if (Poi is ZipPointPoi zipPointPoi)
            {
                @* Remove Zipline *@
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Rounded.Delete"
                           Disabled="IsClientSave"
                           OnClick="() => RemoveZiplineAsync(zipPointPoi.Parent)">
                    @AppText.Get("RemoveZipline")
                </MudButton>
            }
        </DetailsSection>
    }

    <DetailsSection Title="@AppText.Get("Teleportation")"
                    HostOnly="IsClientSave">
        @* Teleport Player *@
        <Tooltip Text="@AppText.Get("AlreadyThere")"
                 Disabled="@(IsClientSave || !PlayerIsThere)"
                 RootClass="d-flex">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Rounded.Person"
                       Disabled="@(IsClientSave || Poi.Position is null || PlayerIsThere)"
                       OnClick="() => TeleportAsync(TeleportTarget.Player)">
                @AppText.Get("TeleportPlayerHere")
            </MudButton>
        </Tooltip>
        @* Teleport Kelvin *@
        <Tooltip Text="@AppText.Get("AlreadyThere")"
                 Disabled="@(IsClientSave || !IsThere(Constants.Actors.KelvinTypeId))"
                 RootClass="d-flex">
            <MudButton Variant="Variant.Text"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Rounded.NearMe"
                       Disabled="@(IsClientSave || !CanTeleport(Constants.Actors.KelvinTypeId))"
                       OnClick="() => TeleportAsync(TeleportTarget.Kelvin)">
                @AppText.Get("TeleportKelvinHere")
            </MudButton>
        </Tooltip>
        @* Teleport Virginia *@
        <Tooltip Text="@AppText.Get("AlreadyThere")"
                 Disabled="@(IsClientSave || !IsThere(Constants.Actors.VirginiaTypeId))"
                 RootClass="d-flex">
            <MudButton Variant="Variant.Text"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Rounded.NearMe"
                       Disabled="@(IsClientSave || !CanTeleport(Constants.Actors.VirginiaTypeId))"
                       OnClick="() => TeleportAsync(TeleportTarget.Virginia)">
                @AppText.Get("TeleportVirginiaHere")
            </MudButton>
        </Tooltip>
        @* Spawn Actors *@
        <MudButton Variant="Variant.Text"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Rounded.GroupAdd"
                   Disabled="@(IsClientSave || Poi.Position is null)"
                   OnClick="SpawnActorsAsync">
            @AppText.Get("SpawnActors")
        </MudButton>
    </DetailsSection>
</MudStack>
